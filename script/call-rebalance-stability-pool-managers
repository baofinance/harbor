#!/usr/bin/env bash
# Calls rebalance on each StabilityPoolManager in turn, as a `cast call` simulation: no transaction is sent.
# Prints one line per manager: paused, or not paused with the revert or the amount rebalance would liquidate.
# A manager upgraded to BaoPauser_v1 reverts with Paused(string), recognized by its selector.
# Any other failure prints cast's full output, and the script exits non-zero.
set -uo pipefail

network="mainnet"
if [[ $# -eq 2 && "$1" == "--network" ]]; then
  network="$2"
elif [[ $# -ne 0 ]]; then
  echo "Usage: $0 [--network <network>]   (default mainnet; local is the anvil fork)" >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# script/cast resolves the RPC aliases from the repo's foundry.toml
cd "$SCRIPT_DIR/.."

STATE_FILE="deployments/mainnet/harbor_v1.state.json"
salts=$(grep -oE '"harbor_v1::[A-Za-z]+::[A-Za-z]+::stabilityPoolManager"' "$STATE_FILE" | tr -d '"' | sort -u)
if [[ -z "$salts" ]]; then
  echo "no stabilityPoolManager salts found in $STATE_FILE" >&2
  exit 1
fi

paused_selector=$(cast sig 'Paused(string)')

total=0
paused=0
failed=0
for salt in $salts; do
  market=${salt#harbor_v1::}
  market=${market%::stabilityPoolManager}
  total=$((total + 1))

  output=$(script/cast --network "$network" call "$salt" 'rebalance(address,uint256)(uint256)' treasury 0 2>&1)
  status=$?
  reverted=$(grep -m1 '^Error: execution reverted' <<<"$output")
  if [[ $status -eq 0 ]]; then
    printf '%-14s not paused: rebalance would liquidate %s pegged\n' "$market" "$(tail -n +2 <<<"$output")"
  elif grep -q "data: \"$paused_selector" <<<"$output"; then
    printf '%-14s paused\n' "$market"
    paused=$((paused + 1))
  elif [[ -n "$reverted" ]]; then
    reason=${reverted#Error: }
    printf '%-14s not paused: %s\n' "$market" "${reason#execution reverted: }"
  else
    printf '%-14s failed:\n%s\n' "$market" "$output"
    failed=$((failed + 1))
  fi
done

echo "$paused of $total paused"
if [[ $failed -ne 0 ]]; then
  echo "$failed of $total failed" >&2
  exit 1
fi
