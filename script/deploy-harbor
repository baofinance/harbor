#!/usr/bin/env bash
#
# Deploy Harbor contracts - starts anvil (optionally) and runs DeployPeggedToken.s.sol
#
# Usage: script/deploy-harbor [OPTIONS]
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$PROJECT_ROOT"

usage() {
  cat <<'USAGE'
Usage: script/deploy-harbor [OPTIONS]

Options:
	--anvil         Start a local Anvil instance for deployment.
									 Uses Anvil default account 0 as deployer.
  --rpc-url URL  Use an existing Anvil/JSON-RPC endpoint and skip starting a local Anvil.
                   Use "local" as shorthand for http://127.0.0.1:8545
  --resume         Resume a failed deployment from where it left off.
                   Skips transactions already confirmed on-chain.
  -h, --help       Show this help.

Examples:
  script/deploy-harbor                      # Start anvil and deploy
  script/deploy-harbor --anvil-url local    # Use existing local anvil
  script/deploy-harbor --resume             # Retry failed deployment
USAGE
}

LOCALITY="remote"

# START_ANVIL, if true it means
# * anvil will be started in the background, and killed at the end
START_ANVIL=true
# RPC_URL, the rpc url to use
PRODUCTION=false
RPC_URL="local"
PRIVATE_KEY="--private-key=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
VERIFY=""
RESUME=""
BROADCAST="--broadcast"
ENV_FILE=""
RESUME=""
VERBOSITY=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v)
      VERBOSITY="${VERBOSITY:--}v"
      shift
      ;;
    -v*)
      VERBOSITY="$1"
      shift
      ;;
    --rpc-url)
      RPC_URL="$2"
      START_ANVIL=false
      shift 2
      ;;
    --resume)
      RESUME="--resume"
      shift
      ;;
    --production)
      # shellcheck disable=SC2034
      VERIFY="--verify"
      PRIVATE_KEY=""
      ENV_FILE="--env-file .env"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Error: Unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [[ "${RPC_URL}" == "local" ]]; then
  VERify="" # can't verify locally
fi

# Multisig address - used as BaoDeployer owner
MULTISIG="0xFC69e0a5823E2AfCBEb8a35d33588360F1496a00"

if ([ "$START_ANVIL" == "true" ]); then
  if [[ "$RPC_URL" != "local" ]]; then
    usage
    echo "Error: --anvil cannot be used with --rpc-url" >&2
    exit 1
  fi

  # Check if port 8545 is already in use
  if lsof -i :8545 >/dev/null 2>&1; then
    echo "Error: Port 8545 is already in use. Another anvil instance may be running." >&2
    echo "Kill the existing process or use --rpc-url local to connect to it." >&2
    exit 1
  fi

  # Start anvil in background
  echo "Starting anvil..."
  anvil -f mainnet@23000000 --timestamp $(date +%s) &
  ANVIL_PID=$!

  # Cleanup on exit
  cleanup() {
    echo "Stopping anvil (PID: $ANVIL_PID)..."
    kill "$ANVIL_PID" 2>/dev/null || true
    wait "$ANVIL_PID" 2>/dev/null || true
  }
  trap cleanup EXIT

  # Wait for anvil to be ready
  echo "Waiting for anvil to be ready..."
  i=0
  while ! curl -s -X POST -H "Content-Type: application/json" \
    --data '{"jsonrpc":"2.0","method":"eth_blockNumber","params":[],"id":1}' \
    "http://localhost:8545" >/dev/null 2>&1; do
    i=$((i + 1))
    if ((i >= 30)); then
      echo "Timeout waiting for anvil"
      exit 1
    fi
    sleep 0.1
  done
  echo "Anvil is ready"

  # Fund the multisig with ETH so it can pay for gas
  echo "Funding multisig with ETH..."
  cast send --rpc-url "$RPC_URL" \
    "${PRIVATE_KEY}" \
    "${MULTISIG}" \
    --value 1ether >/dev/null

fi

echo "RPC_URL=${RPC_URL}"

# ============================================================================
# Run the deployment script
# ============================================================================
echo ""
if [[ -n "$RESUME" ]]; then
  echo "Resuming deployment..."
else
  echo "Running deployment..."
fi
FORGE_OUTPUT=$(forge script script/DeployHarbor.s.sol:DeployHarbor \
  --sig "run()" \
  --rpc-url "$RPC_URL" \
  $BROADCAST $VERIFY $ENV_FILE $PRIVATE_KEY \
  $RESUME 2>&1) || {
  echo "$FORGE_OUTPUT"
  # Extract error selector and decode it
  if SELECTOR=$(echo "$FORGE_OUTPUT" | grep -oE 'custom error 0x[a-fA-F0-9]{8}' | grep -oE '0x[a-fA-F0-9]{8}' | head -1); then
    cast decode-error "$SELECTOR" 2>/dev/null || true
  fi
  exit 1
}
echo "$FORGE_OUTPUT"

# ============================================================================
# Verify deployment
# ============================================================================
echo ""
echo "Verifying deployment..."

forge script script/DeployHarbor.s.sol:DeployHarbor \
  --sig "smoke()" \
  --rpc-url "$RPC_URL" \
  $BROADCAST $ENV_FILE $PRIVATE_KEY
