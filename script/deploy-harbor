#!/usr/bin/env bash
#
# Deploy Harbor contracts
#
# Usage: script/deploy-harbor --salt SALT --network NETWORK [--deploy|--smoke] [OPTIONS]
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$PROJECT_ROOT"

usage() {
  cat <<'USAGE'
Usage: script/deploy-harbor --salt SALT [--network NETWORK] <--deploy|--smoke> [OPTIONS]

Required:
  --salt SALT       Deployment salt (e.g., harbor_v1-USD-stETH)
  --network NETWORK Network name (required unless --start-anvil, must exist in foundry.toml rpc_endpoints)

Phase (at least one required, or use --start-anvil which runs all):
  --deploy          Run deployment phase
  --smoke           Run smoke test phase

Options:
  --resume          Resume a failed deployment from where it left off
  --production      Use production settings (verify, read private key from .env)
  --start-anvil     Start local Anvil, implies network=local and runs all phases if none specified
  -v                Increase verbosity
  -h, --help        Show this help

Examples:
  script/deploy-harbor --salt harbor_v1-USD-stETH --start-anvil
  script/deploy-harbor --salt harbor_v1-USD-stETH --network local --deploy
  script/deploy-harbor --salt harbor_v1-USD-stETH --network local --smoke
  script/deploy-harbor --salt harbor_v1-USD-stETH --network mainnet --production --deploy
USAGE
}

lookup_environment() {
  local env_name="$1"
  # look up the environment
  local value=""

  # Check if the variable exists before trying to access it
  if declare -p "$env_name" &>/dev/null; then
    eval "value=\${$env_name}"
  fi

  if [[ -z "$value" ]]; then
    # look up the .env file if it exists
    if [[ -f .env ]]; then
      # Use a subshell to source .env without polluting the parent environment
      value=$(
        # shellcheck disable=SC1091 # file exists check above
        source .env
        if declare -p "$env_name" &>/dev/null; then
          eval "echo \${$env_name}"
        else
          echo ""
        fi
      )
    fi
  fi
  echo "$value"
}

# Defaults
SALT=""
NETWORK="local"

# Static phase order - phases always run in this sequence
readonly PHASE_ORDER=("deploy" "smoke")

# Associative array tracking which phases are requested
declare -A PHASES=()

# Multisig address - used as BaoDeployer owner, defaults to harbor multisig
MULTISIG="0x9bABfC1A1952a6ed2caC1922BFfE80c0506364a2"
START_ANVIL=false
RESUME=""
VERBOSITY=""
# default to the first anvil account - override with --env
export PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
export BAO_FACTORY_VARIANT="anvil"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --factory-variant)
      BAO_FACTORY_VARIANT="$2"
      shift 2
      ;;
    --salt)
      SALT="$2"
      shift 2
      ;;
    --network)
      NETWORK="$2"
      shift 2
      ;;
    --deploy)
      PHASES["deploy"]=1
      shift
      ;;
    --smoke)
      PHASES["smoke"]=1
      shift
      ;;
    --start-anvil)
      START_ANVIL=true
      shift
      ;;
    --resume)
      RESUME="--resume"
      shift
      ;;
    --env)
      PRIVATE_KEY=$(lookup_environment PRIVATE_KEY)
      shift
      ;;
    -v)
      VERBOSITY="${VERBOSITY:--}v"
      shift
      ;;
    -v*)
      VERBOSITY="$1"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Error: Unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

# Validate required arguments
if [[ -z "$SALT" ]]; then
  echo "Error: --salt is required" >&2
  usage
  exit 1
fi

# ============================================================================
# Start Anvil if requested
# ============================================================================
if [[ "$START_ANVIL" == "true" ]]; then
  if [[ -n "$NETWORK" && "$NETWORK" != "local" ]]; then
    echo "Error: --start-anvil can only be used with network=local, got: $NETWORK" >&2
    exit 1
  fi

  if [[ ${#PHASES[@]} -eq 0 ]]; then
    for phase in "${PHASE_ORDER[@]}"; do
      PHASES["$phase"]=1
    done
  fi

  # Check if port 8545 is already in use
  if lsof -i :8545 >/dev/null 2>&1; then
    echo "Error: Port 8545 is already in use. Another anvil instance may be running." >&2
    echo "Kill the existing process or omit --start-anvil to connect to it." >&2
    exit 1
  fi

  # Start anvil in background
  echo "Starting anvil..."
  anvil -f mainnet@23000000 --timestamp $(date +%s) &
  ANVIL_PID=$!

  # Cleanup on exit
  cleanup() {
    echo "Stopping anvil (PID: $ANVIL_PID)..."
    kill "$ANVIL_PID" 2>/dev/null || true
    wait "$ANVIL_PID" 2>/dev/null || true
  }
  trap cleanup EXIT

  # Wait for anvil to be ready
  echo "Waiting for anvil to be ready..."
  i=0
  while ! curl -s -X POST -H "Content-Type: application/json" \
    --data '{"jsonrpc":"2.0","method":"eth_blockNumber","params":[],"id":1}' \
    "http://localhost:8545" >/dev/null 2>&1; do
    i=$((i + 1))
    if ((i >= 30)); then
      echo "Timeout waiting for anvil"
      exit 1
    fi
    sleep 0.1
  done
  echo "Anvil is ready"

  # Fund the multisig with ETH so it can pay for gas
  echo "Funding multisig with ETH..."
  cast send --rpc-url local \
    --private-key "${PRIVATE_KEY}" \
    "${MULTISIG}" \
    --value 1ether >/dev/null
elif [[ ${#PHASES[@]} -eq 0 ]]; then
  echo "Error: At least one phase (--deploy or --smoke) must be specified" >&2
  usage
  exit 1
fi

if [[ -z "$NETWORK" ]]; then
  echo "Error: --network is required" >&2
  usage
  exit 1
fi

# For local network, can't verify
if [[ "$NETWORK" == "local" ]]; then
  VERIFY=""
else
  VERIFY="--verify"
fi

echo "Salt: $SALT"
echo "Network: $NETWORK"
echo "Phases: ${!PHASES[*]}"

# ============================================================================
# Run the deployment/smoke script
# ============================================================================
for PHASE in "${PHASE_ORDER[@]}"; do
  # Skip phases not requested
  [[ -z "${PHASES[$PHASE]:-}" ]] && continue
  echo ""
  if [[ "$PHASE" == "deploy" ]]; then
    if [[ -n "$RESUME" ]]; then
      echo "Resuming deployment..."
    else
      echo "Running deployment..."
    fi
    SIG="deploy(string,string)"
  else
    echo "Running smoke test..."
    SIG="smoke(string,string)"
  fi

  FORGE_OUTPUT=$(forge script script/DeployHarbor.s.sol:DeployHarbor \
    --sig "$SIG" "$SALT" "$NETWORK" \
    --rpc-url "$NETWORK" \
    --broadcast $VERIFY \
    --private-key "$PRIVATE_KEY" \
    $RESUME $VERBOSITY 2>&1) && FORGE_EXIT=0 || FORGE_EXIT=$?

  echo "$FORGE_OUTPUT"

  # Handle forge failure - exit immediately on error
  if [[ $FORGE_EXIT -ne 0 ]]; then
    # Extract error selector and decode it
    if SELECTOR=$(echo "$FORGE_OUTPUT" | grep -oE 'custom error 0x[a-fA-F0-9]{8}' | grep -oE '0x[a-fA-F0-9]{8}' | head -1); then
      cast decode-error "$SELECTOR" 2>/dev/null || true
    fi
    exit 1
  fi

  echo ""
  echo "=== $PHASE complete ==="
done
