#!/usr/bin/env bash
#
# Deploy Harbor contracts
#
# Usage: script/deploy-harbor --salt SALT --network NETWORK [--deploy|--smoke] [OPTIONS]
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$PROJECT_ROOT"

usage() {
  cat <<'USAGE'
Usage: script/deploy-harbor --salt SALT --peg TICKER --collateral LIST PHASE [OPTIONS]

Required:
  --salt SALT           Deployment salt (e.g. test2, harbor_v1)
  --peg PEGGED          Pegged token identifier (e.g., USD, BTC)
  --collateral LIST     Comma-separated collateral identifiers (e.g., stETH,fxUSD)
  --network NETWORK     Network name (required unless --start-anvil, must exist in foundry.toml rpc_endpoints)

Phase (exactly one required):
  --deploy-pegged   Deploy pegged token only
  --deploy-minter   Deploy minters only (for each collateral)
  --smoke-pegged    Smoke test pegged token only
  --smoke-minter    Smoke test minters only (for each collateral)
	--deploy-sp-impl   Deploy Stability Pool implementation only

Options:
  --account NAME    Use keystore account from ~/.foundry/keystores (for non-local networks)
  --resume          Resume a failed deployment from where it left off
  --start-anvil     Start local Anvil, implies network=local
  --no-verify       Skip contract verification (verification is default for non-local networks)
  -v                Increase verbosity
  -h, --help        Show this help

Wallet:
  For 'local' network: uses first Anvil account (0xac0974...)
  For other networks:  requires --account NAME (keystore in ~/.foundry/keystores)
                       Create with: cast wallet import <name> --interactive

Examples:
  script/deploy-harbor --salt harbor_v1 --peg USD --collateral stETH --deploy-pegged --start-anvil
  script/deploy-harbor --salt harbor_v1 --peg USD --collateral stETH,fxUSD --deploy-minter --network local
  script/deploy-harbor --salt harbor_v1 --peg BTC --collateral stETH --deploy-pegged --network mainnet --account deployer
USAGE
}

# Defaults
SALT=""
PEGGED=""
COLLATERALS_CSV=""
NETWORK="local"

# Phase: exactly one of deploy-pegged, deploy-minter, smoke-pegged, smoke-minter
PHASE=""

# Multisig address - used as BaoDeployer owner, defaults to harbor multisig
MULTISIG="0x9bABfC1A1952a6ed2caC1922BFfE80c0506364a2"
START_ANVIL=false
RESUME=""
VERBOSITY=""
# Wallet: for local use anvil private key, for other networks use --account
ANVIL_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
ANVIL_PUBLIC_KEY="0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266"
ACCOUNT=""
NO_VERIFY=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --account)
      ACCOUNT="$2"
      shift 2
      ;;
    --salt)
      SALT="$2"
      shift 2
      ;;
    --peg)
      PEGGED="$2"
      shift 2
      ;;
    --collateral)
      COLLATERALS_CSV="$2"
      shift 2
      ;;
    --network)
      NETWORK="$2"
      shift 2
      ;;
    --deploy-pegged)
      [[ -n "$PHASE" ]] && {
        echo "Error: Only one phase option allowed" >&2
        exit 1
      }
      PHASE="deploy-pegged"
      shift
      ;;
    --deploy-minter)
      [[ -n "$PHASE" ]] && {
        echo "Error: Only one phase option allowed" >&2
        exit 1
      }
      PHASE="deploy-minter"
      shift
      ;;
    --deploy-sp-impl)
      [[ -n "$PHASE" ]] && {
        echo "Error: Only one phase option allowed" >&2
        exit 1
      }
      PHASE="deploy-sp-impl"
      shift
      ;;
    --smoke-pegged)
      [[ -n "$PHASE" ]] && {
        echo "Error: Only one phase option allowed" >&2
        exit 1
      }
      PHASE="smoke-pegged"
      shift
      ;;
    --smoke-minter)
      [[ -n "$PHASE" ]] && {
        echo "Error: Only one phase option allowed" >&2
        exit 1
      }
      PHASE="smoke-minter"
      shift
      ;;
    --start-anvil)
      START_ANVIL=true
      shift
      ;;
    --resume)
      RESUME="--resume"
      shift
      ;;
    --no-verify)
      NO_VERIFY=true
      shift
      ;;
    -v)
      VERBOSITY="${VERBOSITY:--}v"
      shift
      ;;
    -v*)
      VERBOSITY="$1"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Error: Unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

# Validate required arguments
if [[ -z "$SALT" ]]; then
  echo "Error: --salt is required" >&2
  usage
  exit 1
fi

if [[ -z "$PEGGED" ]]; then
  echo "Error: --peg is required" >&2
  usage
  exit 1
fi

if [[ -z "$COLLATERALS_CSV" ]]; then
  echo "Error: --collateral is required" >&2
  usage
  exit 1
fi

# Parse comma-separated collaterals into array
IFS=',' read -ra COLLATERALS <<<"$COLLATERALS_CSV"

# ============================================================================
# Start Anvil if requested
# ============================================================================
if [[ "$START_ANVIL" == "true" ]]; then
  if [[ -n "$NETWORK" && "$NETWORK" != "local" ]]; then
    echo "Error: --start-anvil can only be used with network=local, got: $NETWORK" >&2
    exit 1
  fi

  # Check if port 8545 is already in use
  if lsof -i :8545 >/dev/null 2>&1; then
    echo "Error: Port 8545 is already in use. Another anvil instance may be running." >&2
    echo "Kill the existing process or omit --start-anvil to connect to it." >&2
    exit 1
  fi

  # Start anvil in background
  echo "Starting anvil..."
  # anvil -f mainnet@23000000 --auto-impersonate --timestamp $(date +%s) &
  anvil -f mainnet --auto-impersonate >anvil.log 2>&1 &
  ANVIL_PID=$!

  # Cleanup on exit
  cleanup() {
    echo "Stopping anvil (PID: $ANVIL_PID)..."
    kill "$ANVIL_PID" 2>/dev/null || true
    wait "$ANVIL_PID" 2>/dev/null || true
  }
  trap cleanup EXIT

  # Wait for anvil to be ready
  echo "Waiting for anvil to be ready..."
  i=0
  while ! curl -s -X POST -H "Content-Type: application/json" \
    --data '{"jsonrpc":"2.0","method":"eth_blockNumber","params":[],"id":1}' \
    "http://localhost:8545" >/dev/null 2>&1; do
    i=$((i + 1))
    if ((i >= 30)); then
      echo "Timeout waiting for anvil"
      exit 1
    fi
    sleep 0.1
  done
  echo "Anvil is ready"

  # Fund the multisig with ETH so it can pay for gas
  echo "Funding multisig with ETH..."
  cast send --rpc-url local \
    --private-key "${ANVIL_PRIVATE_KEY}" \
    "${MULTISIG}" \
    --value 1ether >/dev/null
  echo "Multisig funded"
fi

if [[ -z "$PHASE" ]]; then
  echo "Error: A phase option is required (--deploy-pegged, --deploy-minter, --smoke-pegged, or --smoke-minter)" >&2
  usage
  exit 1
fi

if [[ -z "$NETWORK" ]]; then
  echo "Error: --network is required" >&2
  usage
  exit 1
fi

# For local network, can't verify; for others, verify by default unless --no-verify
if [[ "$NETWORK" == "local" ]]; then
  VERIFY=""
  if [[ -n "$ACCOUNT" ]]; then
    WALLET_ARGS="--account $ACCOUNT"
  else
    WALLET_ARGS="--private-key $ANVIL_PRIVATE_KEY"
  fi
else
  if [[ "$NO_VERIFY" == "true" ]]; then
    VERIFY=""
  else
    VERIFY="--verify"
  fi
  # --account only required for deploy phases, not smoke (which is read-only)
  if [[ -z "$ACCOUNT" && "$PHASE" == deploy-* ]]; then
    echo "Error: --account is required for deploy phases on non-local networks" >&2
    exit 1
  fi
  if [[ -n "$ACCOUNT" ]]; then
    WALLET_ARGS="--account $ACCOUNT"
  else
    WALLET_ARGS=""
  fi
fi

echo "Salt: $SALT"
echo "Pegged: $PEGGED"
echo "Collaterals: ${COLLATERALS[*]}"
echo "Network: $NETWORK"
echo "Phase: $PHASE"
echo "Wallet args: $WALLET_ARGS"

# ============================================================================
# Run the deployment/smoke script
# ============================================================================

# Build JSON array of collaterals: ["stETH","fxUSD"]
COLLATERALS_JSON=$(printf '"%s",' "${COLLATERALS[@]}" | sed 's/,$//')
COLLATERALS_JSON="[${COLLATERALS_JSON}]"

run_forge() {
  local script_contract="$1"
  local sig="$2"
  shift 2
  echo "Running: forge script script/DeployHarbor.s.sol:$script_contract --sig \"$sig\" $* --rpc-url \"$NETWORK\" --broadcast --slow $VERIFY $WALLET_ARGS $RESUME $VERBOSITY"

  FORGE_OUTPUT=$(forge script "script/DeployHarbor.s.sol:$script_contract" \
    --sig "$sig" "$@" \
    --rpc-url "$NETWORK" \
    --broadcast --slow $VERIFY \
    $WALLET_ARGS \
    $RESUME $VERBOSITY 2>&1) && FORGE_EXIT=0 || FORGE_EXIT=$?

  echo "$FORGE_OUTPUT"

  if [[ $FORGE_EXIT -ne 0 ]]; then
    if SELECTOR=$(echo "$FORGE_OUTPUT" | grep -oE 'custom error 0x[a-fA-F0-9]{8}' | grep -oE '0x[a-fA-F0-9]{8}' | head -1); then
      cast decode-error "$SELECTOR" 2>/dev/null || true
    fi
    exit 1
  fi
}

case "$PHASE" in
  deploy-pegged)
    if [[ -z "$RESUME" && "${NETWORK}" == "local" ]]; then
      echo "Ensuring BaoFactory is ready..."
      ./lib/bao-base/script/ensure-bao-factory
    fi
    echo ""
    echo "=== Deploying pegged token: $PEGGED ==="
    run_forge DeployHarborPegged "deployPegged(string,string,string,string[])" "$NETWORK" "$SALT" "$PEGGED" "$COLLATERALS_JSON"
    ;;

  deploy-minter)
    if [[ -z "$RESUME" && "${NETWORK}" == "local" ]]; then
      echo "Ensuring BaoFactory is ready..."
      ./lib/bao-base/script/ensure-bao-factory
    fi
    for COLLATERAL in "${COLLATERALS[@]}"; do
      echo ""
      echo "=== Deploying minter for collateral: $COLLATERAL ==="
      run_forge DeployHarborMinter "deployMinter(string,string,string,string)" "$NETWORK" "$SALT" "$PEGGED" "$COLLATERAL"
    done
    ;;

  deploy-sp-impl)
    if [[ -z "$RESUME" && "${NETWORK}" == "local" ]]; then
      echo "Ensuring BaoFactory is ready..."
      ./lib/bao-base/script/ensure-bao-factory
    fi
    for COLLATERAL in "${COLLATERALS[@]}"; do
      echo ""
      echo "=== Deploying Stability Pools for collateral: $COLLATERAL ==="
      run_forge DeployHarborMinter "deploySPImpl(string,string,string,string)" "$NETWORK" "$SALT" "$PEGGED" "$COLLATERAL"
    done
    ;;

  smoke-pegged)
    echo ""
    echo "=== Smoke testing pegged token: $PEGGED ==="
    run_forge DeployHarborPegged "smokePegged(string,string,string,string[])" "$NETWORK" "$SALT" "$PEGGED" "$COLLATERALS_JSON"
    ;;

  smoke-minter)
    for COLLATERAL in "${COLLATERALS[@]}"; do
      echo ""
      echo "=== Smoke testing minter for collateral: $COLLATERAL ==="
      run_forge DeployHarborMinter "smokeMinter(string,string,string,string)" "$NETWORK" "$SALT" "$PEGGED" "$COLLATERAL"
    done
    ;;
esac

echo ""
echo "=== $PHASE complete ==="
