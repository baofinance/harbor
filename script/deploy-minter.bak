#!lib/bao-base/run deploy
set -euo pipefail

log "deploying minter $*"

THIS="${BASH_SOURCE[0]}"

# developer settings
MOCK_PRICE=""
# the wallet of the developer and what roles they are granted
# developer is likely to be the public key of your wallet,
# but we default to the public key derived from the PRIVATE_KEY environment variable
DEVELOPER="$PUBLIC_KEY"
# DEVELOPER_ROLES is a comma separated list of roles to grant the developer, where a role is:
#   <contract name>.<role name>
# where
#   the contract name is the name given to the instance of a contract type. It can also be an address.
#   the role name is the name of the function call needed to extract the role. It can also be a role number.
# e.g.
#   --developer-roles "minter.HARVESTER_ROLE,stabilityPoolCollateral.REBALANCER_ROLE"
DEVELOPER_ROLES=""
PEGGED_SYMBOL="PB" # pork bellies

# BURN_SIG can be one of
# - "burn(uint256)"
#    this works for BaoUSD and is common for other ERC20 tokens. It is the lowest common denominator and
#    offers the poorest gas usage, requiring an extra transfer in order to be used. The other two options
#    are do not need this transfer and so are more gas efficient.
#    This is the default.
# - "burn(address,uint256)"
#    this is a more gas efficient form but is not used extensively.
# - "burnFrom(address,uint256)"
#    this is one of the most gas efficient forms, is extensively used and frequetly alongside the burn(uint256) form
BURN_SIG="burn(uint256)"
MINTER_CONFIG=""
HARVEST_BOUNTY=""
HARVEST_CUT=""
REBALANCE_BOUNTY=""
REBALANCE_THRESHOLD=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --minter-fee-config-file | --mfcf)
      MINTER_CONFIG="true"
      record minter.feeConfigFile "$2"
      record_raw minter.feeConfig "$(<$2)"
      shift 2
      ;;
    --harvest-bounty)
      HARVEST_BOUNTY="true"
      record "stabilityPoolManager.harvestBountyRatio" "$2"
      shift 2
      ;;
    --harvest-cut)
      HARVEST_CUT="true"
      record "stabilityPoolManager.harvestCutRatio" "$2"
      shift 2
      ;;
    --rebalance-bounty)
      REBALANCE_BOUNTY="true"
      record "stabilityPoolManager.rebalanceBountyRatio" "$2"
      shift 2
      ;;
    --rebalance-threshold)
      REBALANCE_THRESHOLD="true"
      record "stabilityPoolManager.rebalanceThreshold" "$2"
      shift 2
      ;;
    --burn-sig)
      BURN_SIG="$2"
      record "arguments.burn-sig" "${BURN_SIG}"
      shift 2
      ;;
    --mock-price)
      MOCK_PRICE="$2"
      shift 2
      record "arguments.mockPrice" "${MOCK_PRICE}"
      ;;
    --developer)
      DEVELOPER="$2"
      record "arguments.developer" "${DEVELOPER}"
      shift 2
      ;;
    --developer-roles)
      if [[ $RPC_URL == "local" ]]; then
        DEVELOPER_ROLES="$2"
        record "arguments.developer-roles" "${DEVELOPER_ROLES}"
        record "arguments.developer" "${DEVELOPER}"
      else
        error "can only use --developer-roles with --rpc-url [local|anvil]"
      fi
      shift 2
      ;;
    --pegged | --anchored)
      PEGGED_SYMBOL="$2"
      record "arguments.pegged" "${PEGGED_SYMBOL}"
      shift 2
      ;;
    -*)
      error "unexpected option for ${THIS}: $1"
      exit 1
      ;;
    *)
      error "unexpected argument for ${THIS}: $1"
      exit 1
      ;;
  esac
done

###################################################################################################
# read the already deployed addresses
###################################################################################################

# shellcheck disable=SC2154 # PUBLIC_KEY is exported elsewhere
record_from_network owner.address baomultisig.address
record_from_network treasury.address safeGov.address

# collateral
record_from_network collateralToken.address steth.address
record_from_call collateralToken.symbol collateralToken "symbol()(string)"
COLLATERAL_SYMBOL=$(query collateralToken.symbol)
record_from_network collateralToken.priceFeed.usd.address steth.priceFeed.usd.address

# wrapped collateral
record_from_network wrappedCollateralToken.address wsteth.address

###################################################################################################
# deploy the stem for this deployer
###################################################################################################
# make the owner the deployer so the deployer can change it within 1 hour (else it goes there automatically)
deploy_contract Stem_v1 "lib/bao-base/src/Stem_v1.sol:Stem_v1" "--constructor-args" deployer 3600

###################################################################################################
# deploy the proxies, stemmed, recording the addresses
###################################################################################################

BaoOwnables=()
for contract in \
  peggedToken leveragedToken \
  stakedETHWrappedPriceOracle \
  minter reservePool feeReceiver \
  stabilityPoolManager \
  genesis; do
  deploy_stemmed "${contract}"
  BaoOwnables+=("${contract}")
done

###################################################################################################
# upgrade the proxies with implementations
###################################################################################################

# pegged token
# ---------------
deploy_contract PeggedToken_v1 "lib/bao-base/src/MintableBurnableERC20_v1.sol:MintableBurnableERC20_v1"
record peggedToken.symbol "ha${PEGGED_SYMBOL}"
record peggedToken.name "Harbor Anchored ${PEGGED_SYMBOL}"

upgrade_proxy peggedToken PeggedToken_v1 \
  "initialize(address,string,string)" owner peggedToken.name peggedToken.symbol

# leveraged token
# ---------------
deploy_contract LeveragedToken_v1 "lib/bao-base/src/MintableBurnableERC20_v1.sol:MintableBurnableERC20_v1"
LEVERAGED_SYMBOL="hs${PEGGED_SYMBOL}x${COLLATERAL_SYMBOL}"
record leveragedToken.symbol "hs${LEVERAGED_SYMBOL}"
record leveragedToken.name "Harbor Sail ${LEVERAGED_SYMBOL}"

upgrade_proxy leveragedToken LeveragedToken_v1 \
  "initialize(address,string,string)" owner leveragedToken.name leveragedToken.symbol

# priceOracle
# -----------
# mock price oracle
deploy_contract MockWrappedPriceOracle "test/mock/MockWrappedPriceOracle.sol:MockWrappedPriceOracle"

# real price oracle
deploy_library PriceOracle_v1 "src/price/PriceOracle_v1.sol:PriceOracle_v1"

deploy_contract StakedETHWrappedPriceOracle_v1 "src/price/StakedETHWrappedPriceOracle_v1.sol:StakedETHWrappedPriceOracle_v1" \
  --libraries PriceOracle_v1 \
  --constructor-args collateralToken.priceFeed.usd wrappedCollateralToken 3600 300 300 300

upgrade_proxy stakedETHWrappedPriceOracle StakedETHWrappedPriceOracle_v1 "initialize(address)" owner

local priceOracle
if [[ -n "${MOCK_PRICE}" ]]; then
  to_wei() {
    bc -l <<<"scale=0; (${1} * 10^18 + 0.5)/1"
  }
  priceOracle=MockWrappedPriceOracle.address
  if [[ "${MOCK_PRICE}" != "default" ]]; then
    local price="${MOCK_PRICE%%,*}"
    record MockWrappedPriceOracle.price "${price}"
    price=$(to_wei "${price}") || error "failed to convert price ${price} to wei"
    record MockWrappedPriceOracle.priceInWei "${price}"
    local rate="${MOCK_PRICE#*,}"
    record MockWrappedPriceOracle.rate "${rate}"
    rate=$(to_wei "${rate}") || error "failed to convert rate ${rate} to wei"
    record MockWrappedPriceOracle.rateInWei "${rate}"
    send_transaction MockWrappedPriceOracle "setLatestAnswer(uint256,uint256)" "${price}" "${rate}"
  fi
  warn "using mock price oracle: ${priceOracle}"
else
  priceOracle=stakedETHWrappedPriceOracle.address
fi
record priceOracle.address "${priceOracle}"

# token distribution
#####################

# token distributor
deploy_contract TokenDistributor_v1 "src/minter/TokenDistributor_v1.sol:TokenDistributor_v1"

# feeReceiver
# -----------
upgrade_proxy feeReceiver TokenDistributor_v1 "initialize(address,string)" owner "Fee Receiver"

# minter
#########

# reservePool
# -----------
deploy_contract ReservePool_v1 "src/minter/ReservePool_v1.sol:ReservePool_v1"
upgrade_proxy reservePool ReservePool_v1 "initialize(address)" owner

# minter
# ------
deploy_library Config_v1 src/minter/library/Config_v1.sol:Config_v1

deploy_contract Minter_v1 src/minter/Minter_v1.sol:Minter_v1 \
  --libraries Config_v1 \
  --constructor-args wrappedCollateralToken peggedToken leveragedToken "${BURN_SIG}"

upgrade_proxy minter Minter_v1 "initialize(address)" owner

grantRoles minter peggedToken.MINTER_ROLE
grantRoles minter peggedToken.BURNER_ROLE

grantRoles minter leveragedToken.MINTER_ROLE
grantRoles minter leveragedToken.BURNER_ROLE

grantRoles minter reservePool.REQUESTER_ROLE

send_transaction minter "updatePriceOracle(address)" priceOracle
send_transaction minter "updateFeeReceiver(address)" feeReceiver
send_transaction minter "updateReservePool(address)" reservePool

if [[ -n "${MINTER_CONFIG}" ]]; then
  send_transaction minter "updateConfig(((uint256[],int256[]),(uint256[],int256[]),(uint256[],int256[]),(uint256[],int256[])))" \
    "(($(query minter.feeConfig.mintPeggedIncentiveConfig.collateralRatioBandUpperBounds),$(query minter.feeConfig.mintPeggedIncentiveConfig.incentiveRatios)),\
     ($(query minter.feeConfig.redeemPeggedIncentiveConfig.collateralRatioBandUpperBounds),$(query minter.feeConfig.redeemPeggedIncentiveConfig.incentiveRatios)),\
     ($(query minter.feeConfig.mintLeveragedIncentiveConfig.collateralRatioBandUpperBounds),$(query minter.feeConfig.mintLeveragedIncentiveConfig.incentiveRatios)),\
     ($(query minter.feeConfig.redeemLeveragedIncentiveConfig.collateralRatioBandUpperBounds),$(query minter.feeConfig.redeemLeveragedIncentiveConfig.incentiveRatios)))"
fi

# stability pools
#################

# stabilityPools
# --------------
declare -A TOKEN_SYMBOL
TOKEN_SYMBOL[Collateral]="${COLLATERAL_SYMBOL}"
TOKEN_SYMBOL[Sail]="${LEVERAGED_SYMBOL}"
declare -A TOKEN_KEY
TOKEN_KEY[Collateral]="wrappedCollateralToken"
TOKEN_KEY[Sail]="leveragedToken"
# two stability pools
for liquidation in Collateral Sail; do
  # stability pool
  deploy_stemmed stabilityPool${liquidation}
  BaoOwnables+=("stabilityPool${liquidation}")

  # constructor(minter, liquidationToken, stabilityPoolToken, earlyFee, feeAddress, startDelay, windowPeriod)
  deploy_contract StabilityPool_v1${liquidation} "src/minter/StabilityPool_v1.sol:StabilityPool_v1" \
    --constructor-args minter ${TOKEN_KEY[$liquidation]} 25000000000000000 treasury 3600 90000 1e18
  upgrade_proxy stabilityPool${liquidation} StabilityPool_v1${liquidation} "initialize(address,uint256,address)" \
    owner 25000000000000000 treasury

  # grant stabilityPoolManager access
  grantRoles stabilityPoolManager stabilityPool${liquidation}.REBALANCER_ROLE
  grantRoles stabilityPoolManager stabilityPool${liquidation}.REWARD_DEPOSITOR_ROLE

done

# StabilityPoolManager
# --------------------
deploy_contract StabilityPoolManager_v1 "src/minter/StabilityPoolManager_v1.sol:StabilityPoolManager_v1" \
  --constructor-args minter treasury stabilityPoolCollateral stabilityPoolSail
upgrade_proxy stabilityPoolManager StabilityPoolManager_v1 "initialize(address)" owner
send_transaction stabilityPoolManager "updateFeeReceiver(address)" feeReceiver

grantRoles stabilityPoolManager minter.HARVESTER_ROLE
if [[ -n "${HARVEST_BOUNTY}" ]]; then
  send_transaction stabilityPoolManager "updateHarvestBountyRatio(uint256)" stabilityPoolManager.harvestBountyRatio
fi
if [[ -n "${HARVEST_CUT}" ]]; then
  send_transaction stabilityPoolManager "updateHarvestCutRatio(uint256)" stabilityPoolManager.harvestCutRatio
fi
if [[ -n "${REBALANCE_BOUNTY}" ]]; then
  send_transaction stabilityPoolManager "updateRebalanceBountyRatio(uint256)" stabilityPoolManager.rebalanceBountyRatio
fi
if [[ -n "${REBALANCE_THRESHOLD}" ]]; then
  send_transaction stabilityPoolManager "updateRebalanceThreshold(uint256)" stabilityPoolManager.rebalanceThreshold
fi

# genesis
#########
deploy_contract Genesis_v1 "src/minter/Genesis_v1.sol:Genesis_v1" --constructor-args minter

###################################################################################################
# developer options
###################################################################################################
if [[ -n "${DEVELOPER_ROLES}" ]]; then
  record developer.address "${DEVELOPER}"
  # initialize genesis with developer as finalOwner (pending owner)
  # This sets the pending owner to developer, allowing transfer within 1 hour
  upgrade_proxy genesis Genesis_v1 "initialize(address)" developer
  # Complete the ownership transfer to developer (must be done within 1 hour of initialization)
  log "completing genesis ownership transfer to developer ${DEVELOPER}."
  send_transaction genesis "transferOwnership(address)" developer
  for role in ${DEVELOPER_ROLES//,/ }; do
    log "granting ${role} to developer ${DEVELOPER}."
    grantRoles developer "${role}" || warn "failed to grant ${role} to developer ${DEVELOPER}, continuing anyway"
  done
else
  upgrade_proxy genesis Genesis_v1 "initialize(address)" owner
  # Complete the ownership transfer to owner (must be done within 1 hour of initialization)
  send_transaction genesis "transferOwnership(address)" owner
fi
grantRoles genesis minter.ZERO_FEE_ROLE

###################################################################################################
# upgrade the proxies with implementations
###################################################################################################
# finalise tokens by transferring ownership
for contract in ${BaoOwnables[@]}; do
  # skip genesis if developer roles are set (already transferred to developer)
  if [[ "${contract}" == "genesis" && -n "${DEVELOPER_ROLES}" ]]; then
    continue
  fi
  send_transaction "${contract}" "transferOwnership(address)" owner
done

log "deployed minter successfully."
