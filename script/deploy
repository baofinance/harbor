#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Fail fast if not in project root
[[ -f "foundry.toml" ]] || {
  echo "❌ Run from project root" >&2
  exit 1
}

usage() {
  cat <<EOF
Usage:
  $0 --network <net> --salt <salt> [--account <name>] [--local] [--peg <peg>]

Required:
  --network <net>   Network name from foundry.toml [rpc_endpoints] (e.g., mainnet) but not local.
	--salt <salt>     System salt for CREATE3 deployment (e.g., harbor_v1)
  --peg <peg>       Which peg to deploy. There must be a corresponding Deploy_<peg>_<network>.s.sol script.

Options:
  --account <name>  Foundry keystore account name (required for non-local)
  --local           Use local anvil (auto-impersonate, state in local directory)
  -h, --help        Show this help message
EOF
}

# Common argument parsing for deployment scripts
# Sets: NETWORK, SALT, ACCOUNT, USE_LOCAL, PEG
NETWORK=""
SALT=""
USE_LOCAL=false
FORGE_ARGS=()
ACCOUNT=""
PEG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --network)
      NETWORK=$2
      shift 2
      ;;
    --salt)
      SALT=$2
      shift 2
      ;;
    --account)
      ACCOUNT=$2
      shift 2
      ;;
    --local)
      USE_LOCAL=true
      shift
      ;;
    --peg)
      PEG=$2
      shift 2
      ;;
    --resume)
      FORGE_ARGS+=(--resume)
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      echo "Unexpected argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

[[ -n "$NETWORK" ]] || {
  echo "❌ --network required" >&2
  exit 1
}
[[ -n "$SALT" ]] || {
  echo "❌ --salt required" >&2
  exit 1
}
[[ -n "$PEG" ]] || {
  echo "❌ --peg required" >&2
  exit 1
}
[[ "$USE_LOCAL" == true || -n "$ACCOUNT" ]] || {
  echo "❌ --account required (or use --local)" >&2
  exit 1
}

if [[ "$USE_LOCAL" == true ]]; then
	RPC_URL="local"
	export DEPLOY_STATE_SUBDIR="local-$(date -u +%Y-%m-%dT%H:%M:%SZ)"
else
  RPC_URL=$NETWORK
fi
CHAIN_ID=$(cast chain-id --rpc-url "$RPC_URL" 2>/dev/null) || {
  echo "❌ RPC failed: $RPC_URL" >&2
  exit 1
}
FORGE_ARGS+=(--rpc-url "$RPC_URL")

if [[ "$USE_LOCAL" == true && -n "$ACCOUNT" ]]; then
  # Use provided account with anvil's auto-impersonate
  FORGE_ARGS+=(--account "$ACCOUNT" --unlocked)
elif [[ "$USE_LOCAL" == true ]]; then
  # Anvil's first account private key (fallback)
  FORGE_ARGS+=(--private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80)
elif [[ -n "$ACCOUNT" ]]; then
  FORGE_ARGS+=(--account "$ACCOUNT")
fi

FORGE_ARGS+=(--broadcast --slow) # leaving out the --slow arg means it is unreliable
[[ "$USE_LOCAL" == true ]] || FORGE_ARGS+=(--verify)

PEG_UPPER=$(echo "$PEG" | tr '[:lower:]' '[:upper:]')
SCRIPT_PATH="script/Deploy_${PEG_UPPER}_mainnet.s.sol:Deploy_${PEG_UPPER}_mainnet"

echo "======================================================"
echo "DEPLOYING MINTERS"
echo "======================================================"
echo "Salt:       $SALT"
echo "Network:    $NETWORK"
echo "Peg:        $PEG"
echo "rpc-url:    $RPC_URL"
echo "script:     $SCRIPT_PATH"
echo "forge args: ${FORGE_ARGS[*]}"

START_TIME=$(date +%s)

forge script "$SCRIPT_PATH" \
  --sig 'run(string,string)' "$SALT" "$NETWORK" \
  "${FORGE_ARGS[@]}"

END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))
MINS=$((ELAPSED / 60))
SECS=$((ELAPSED % 60))

echo "======================================================"
echo "DEPLOYMENT COMPLETE"
printf "Took: %dm %02ds\n" "$MINS" "$SECS"
echo "======================================================"
