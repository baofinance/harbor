#!/usr/bin/env bash
set -euo pipefail

# Deploy a minter peg to a network.
#
# Thin wrapper around run-script that adds minter-specific arguments (--peg,
# --deploy-peg, --collateral) and delegates to the Deploy_<PEG>_<network>
# Solidity script via run-script's -- pass-through.
#
# The Deploy_*_<network> scripts still use the legacy run(string,string,bool,string)
# signature. When those are migrated to SafeBatch's run(string), the --
# pass-through can be dropped.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<EOF
Usage:
  $0 --network <net> --salt <salt> --peg <peg> [--deploy-peg] [--collateral <name>] [options]

Required:
  --network <net>      Network name (e.g., mainnet)
  --salt <salt>        Salt prefix (e.g., harbor_v1)
  --peg <peg>          Which peg to deploy (BTC, ETH, EUR, GOLD, MCAP, SILVER)

Options:
  --deploy-peg         Deploy the pegged token (default: false)
  --collateral <name>  Collateral to deploy (e.g., stETH, fxUSD). Default: "*" (all markets)
  --account <name>     Foundry keystore account name (required for non-local)
  --local              Use local anvil (auto-impersonate, local state directory)
  --timestamp          Add timestamp to local state directory (requires --local)
  --resume             Resume a previous broadcast
  -h, --help           Show this help message
EOF
}

# ── Parse minter-specific args, collect passthrough for run-script ────────

NETWORK=""
SALT=""
PEG=""
DEPLOY_PEG=false
COLLATERAL="*"
PASSTHROUGH_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --peg)
      PEG=$2
      shift 2
      ;;
    --deploy-peg)
      DEPLOY_PEG=true
      shift
      ;;
    --collateral)
      COLLATERAL=$2
      shift 2
      ;;
    --network)
      NETWORK=$2
      PASSTHROUGH_ARGS+=(--network "$2")
      shift 2
      ;;
    --salt)
      SALT=$2
      PASSTHROUGH_ARGS+=(--salt "$2")
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      PASSTHROUGH_ARGS+=("$1")
      shift
      ;;
  esac
done

[[ -n "$NETWORK" ]] || { echo "❌ --network required" >&2; exit 1; }
[[ -n "$SALT" ]]    || { echo "❌ --salt required" >&2; exit 1; }
[[ -n "$PEG" ]]     || { echo "❌ --peg required" >&2; exit 1; }

PEG_UPPER=$(echo "$PEG" | tr '[:lower:]' '[:upper:]')

echo "  Peg:        $PEG_UPPER" >&2
echo "  Deploy peg: $DEPLOY_PEG" >&2
echo "  Collateral: $COLLATERAL" >&2

exec "$SCRIPT_DIR/run-script" "Deploy_${PEG_UPPER}_${NETWORK}" \
  --broadcast \
  "${PASSTHROUGH_ARGS[@]}" \
  -- --sig 'run(string,string,bool,string)' "$SALT" "$NETWORK" "$DEPLOY_PEG" "$COLLATERAL"
