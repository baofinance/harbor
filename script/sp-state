#!/usr/bin/env bash
#
# Capture or compare stability pool state
#
# Usage:
#   ./sp-state capture [--network NETWORK] [--output FILE]
#   ./sp-state compare [--network NETWORK] [--input FILE]
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${SCRIPT_DIR}/sp-config.json"

# View functions to capture (no parameters)
VIEW_CALLS=(
  "ASSET_TOKEN()(address)"
  "LIQUIDATION_TOKEN()(address)"
  "MIN_DEPOSIT()(uint256)"
  "MIN_TOTAL_ASSET_SUPPLY()(uint256)"
  "EXEMPT_WITHDRAWAL_FEE_ROLE()(uint256)"
  "REBALANCER_ROLE()(uint256)"
  "REWARD_DEPOSITOR_ROLE()(uint256)"
  "REWARD_MANAGER_ROLE()(uint256)"
  "REWARD_PERIOD_LENGTH()(uint40)"
  "UPGRADE_INTERFACE_VERSION()(string)"
  "WITHDRAWAL_END_WINDOW()(uint64)"
  "WITHDRAWAL_START_DELAY()(uint64)"
  "activeRewardTokens()(address[])"
  "getEarlyWithdrawalFee()(uint256)"
  "getFeeAddress()(address)"
  "getWithdrawalWindow()(uint64,uint64)"
  "historicalRewardTokens()(address[])"
  "lastAssetLossError()(uint256)"
  "owner()(address)"
  "totalAssetSupply()(uint256)"
)

usage() {
  cat <<'USAGE'
Usage: sp-state MODE [OPTIONS]

Modes:
  capture     Capture current state to JSON file
  compare     Capture current state and compare to stored JSON

Options:
  --network NETWORK   Network name (default: local)
  --file FILE         Output file for capture / Input file for compare
                      (default: sp-state.json)
  -h, --help          Show this help

Examples:
  ./sp-state capture --network local --file before.json
  ./sp-state compare --network local --file before.json
USAGE
}

# Defaults
MODE=""
NETWORK="local"
FILE="sp-state.json"

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    capture | compare)
      MODE="$1"
      shift
      ;;
    --network)
      NETWORK="$2"
      shift 2
      ;;
    --file)
      FILE="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Error: Unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [[ -z "$MODE" ]]; then
  echo "Error: Mode required (capture or compare)" >&2
  usage
  exit 1
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "Error: Config file not found: $CONFIG_FILE" >&2
  exit 1
fi

# Read proxies from config
readarray -t PROXIES < <(jq -r '.upgrades[].proxy' "$CONFIG_FILE")

# Escape a string for JSON (handles newlines, quotes, backslashes)
json_escape() {
  local s="$1"
  # Escape backslashes first, then quotes, then newlines
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# Capture state for a single proxy, output as JSON object
capture_proxy_state() {
  local proxy="$1"
  echo "  {"
  echo "    \"proxy\": \"$proxy\","
  local first=true
  for sig in "${VIEW_CALLS[@]}"; do
    local fn="${sig%%(*}"
    local val
    val=$(cast call --rpc-url "$NETWORK" "$proxy" "$sig" 2>/dev/null || echo "ERROR")
    val=$(json_escape "$val")
    if [[ "$first" == "true" ]]; then
      first=false
    else
      echo ","
    fi
    printf '    "%s": "%s"' "$fn" "$val"
  done
  echo ""
  echo "  }"
}

# Capture all proxies to JSON
capture_all() {
  echo "Capturing state from $NETWORK to $FILE..."
  {
    echo "["
    local first=true
    for proxy in "${PROXIES[@]}"; do
      if [[ "$first" == "true" ]]; then
        first=false
      else
        printf ",\n"
      fi
      echo "  Capturing $proxy..." >&2
      capture_proxy_state "$proxy"
    done
    echo ""
    echo "]"
  } >"$FILE"
  echo "State saved to $FILE"
}

# Compare current state to stored JSON
compare_all() {
  if [[ ! -f "$FILE" ]]; then
    echo "Error: File not found: $FILE" >&2
    exit 1
  fi

  echo "Comparing current state on $NETWORK to $FILE..."
  echo ""

  local has_any_diff=false

  for proxy in "${PROXIES[@]}"; do
    echo "=========================================="
    echo "Proxy: $proxy"
    echo "------------------------------------------"

    local has_diff=false

    for sig in "${VIEW_CALLS[@]}"; do
      local fn="${sig%%(*}"

      # Get stored value from JSON
      local stored
      stored=$(jq -r ".[] | select(.proxy == \"$proxy\") | .[\"$fn\"]" "$FILE" 2>/dev/null || echo "NOT_FOUND")

      # Get current value
      local current
      current=$(cast call --rpc-url "$NETWORK" "$proxy" "$sig" 2>/dev/null || echo "ERROR")

      if [[ "$stored" != "$current" ]]; then
        echo "  DIFF $fn:"
        echo "    stored:  $stored"
        echo "    current: $current"
        has_diff=true
        has_any_diff=true
      fi
    done

    if [[ "$has_diff" == "false" ]]; then
      echo "  No differences"
    fi
    echo ""
  done

  if [[ "$has_any_diff" == "true" ]]; then
    echo "=========================================="
    echo "Differences found!"
  else
    echo "=========================================="
    echo "All values match"
  fi
}

# Run the appropriate mode
case "$MODE" in
  capture)
    capture_all
    ;;
  compare)
    compare_all
    ;;
esac
