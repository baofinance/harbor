#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/../.."

usage() {
  cat <<EOF
Usage:
  $0 --network <net> --salt <salt> [--account <name>] [--local] [--peg <peg>]

Required:
  --network <net>   Network name from foundry.toml [rpc_endpoints] (e.g., mainnet, anvil)
  --salt <salt>     System salt for CREATE3 deployment (e.g., harbor_v1)

Options:
  --account <name>  Foundry keystore account name (required for non-local)
  --local           Use local anvil (auto-impersonate, state in local directory)
  --peg <peg>       Deploy only specific peg (ETH, BTC, GOLD, EUR, MCAP, SILVER). Default: all
  -h, --help        Show this help message
EOF
}

source "script/lib/deploy-cli"

# Determine script path based on --peg parameter
if [[ -n "$PEG" ]]; then
  PEG_UPPER=$(echo "$PEG" | tr '[:lower:]' '[:upper:]')
  case "$PEG_UPPER" in
    ETH | BTC | GOLD | EUR | MCAP | SILVER)
      SCRIPT_PATH="script/deployment2/Deploy_${PEG_UPPER}_mainnet.s.sol:Deploy_${PEG_UPPER}_mainnet"
      ;;
    *)
      echo "Error: Invalid peg '$PEG'. Must be one of: ETH, BTC, GOLD, EUR, MCAP, SILVER" >&2
      exit 1
      ;;
  esac
else
  SCRIPT_PATH="script/deployment2/DeployMinters_mainnet.s.sol:DeployMinters_mainnet"
fi

echo "=== Deploy Minters ==="
echo "Salt:       $SALT"
echo "Network:    $NETWORK"
echo "Use Local:  $USE_LOCAL"
echo "Peg:        ${PEG:-all}"
echo "forge args: ${FORGE_ARGS[*]}"

forge script "$SCRIPT_PATH" \
  --sig 'run(string,string,bool)' "$SALT" "$NETWORK" "$USE_LOCAL" \
  "${FORGE_ARGS[@]}"

echo "=== Deployment Complete ==="
