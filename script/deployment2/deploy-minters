#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/../.."

usage() {
  cat <<EOF
Usage:
  $0 --network <net> --salt <salt> [--account <name>] [--local]

Required:
  --network <net>   Network name from foundry.toml [rpc_endpoints] (e.g., mainnet, anvil)
  --salt <salt>     System salt for CREATE3 deployment (e.g., harbor_v1)

Options:
  --account <name>  Foundry keystore account name (required for non-local)
  --local           Use local anvil (auto-impersonate, state in local directory)
  -h, --help        Show this help message
EOF
}

source "script/lib/deploy-cli"

SCRIPT_PATH="script/deployment2/DeployMinters.s.sol:DeployMinters"

echo "=== Deploy Minters ==="
echo "Salt:       $SALT"
echo "Network:    $NETWORK"
echo "Use Local:  $USE_LOCAL"
echo "forge args: ${FORGE_ARGS[*]}"

forge script "$SCRIPT_PATH" \
  --sig 'run(string,string,bool)' "$SALT" "$NETWORK" "$USE_LOCAL" \
  "${FORGE_ARGS[@]}"

echo "=== Deployment Complete ==="
