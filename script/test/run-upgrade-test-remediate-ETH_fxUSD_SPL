#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR/../.."

cd "$PROJECT_ROOT"

# ── Configuration ──────────────────────────────────────────────────────────────

FORGE_VERBOSITY="${FORGE_VERBOSITY:--vv}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      echo "Usage: $(basename "$0")"
      echo ""
      echo "Runs the ETH::fxUSD SPL remediation verification workflow:"
      echo "  1. Start anvil fork at latest"
      echo "  2. Pause the SPL (upgrade to BaoPauser)"
      echo "  3. Deploy remediation contract, remediate, restore to SP_v2"
      echo "  4. Run assertions against post-remediation state"
      echo ""
      echo "Environment variables:"
      echo "  FORGE_VERBOSITY     Forge verbosity flag (default: -vv)"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

# ── Helpers ────────────────────────────────────────────────────────────────────

prompt() {
  local msg="$1"
  echo ""
  echo "──────────────────────────────────────────────────────────────"
  echo "$msg"
  echo "──────────────────────────────────────────────────────────────"
  read -rn1 -p "Ready? [Y/n] " response
  echo ""
  if [[ "$response" =~ ^[Nn]$ ]]; then
    echo "Aborted."
    exit 1
  fi
}

# ── Main ───────────────────────────────────────────────────────────────────────

echo "======================================================================"
echo "  ETH::fxUSD SPL Remediation Verification"
echo "======================================================================"

# ── Step 1: Start anvil ──────────────────────────────────────────────────────

prompt "Start anvil fork at latest:  script/anvil --block latest"

# ── Step 2: Pause ─────────────────────────────────────────────────────────────

echo ""
echo "Pausing ETH::fxUSD stabilityPoolLeveraged..."
./script/run-script Pause_SPL_ETH_fxUSD --network mainnet --salt harbor_v1 --broadcast --local

# ── Step 3: Remediate and restore ─────────────────────────────────────────────

echo ""
echo "Deploying remediation, remediating, and restoring..."
./script/run-script Remediate_SPL_ETH_fxUSD --network mainnet --salt harbor_v1 --broadcast --local

# ── Step 4: Run assertions ────────────────────────────────────────────────────

echo ""
echo "Running post-remediation assertions..."
forge test \
  --match-path script/test/SPLRemediationTest.t.sol \
  --fork-url local $FORGE_VERBOSITY

echo ""
echo "Done."
