#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR/../.."

cd "$PROJECT_ROOT"

# ── Configuration ──────────────────────────────────────────────────────────────

FORGE_VERBOSITY="${FORGE_VERBOSITY:--vv}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      echo "Usage: $(basename "$0")"
      echo ""
      echo "Runs the ETH::fxUSD SPL remediation verification on local anvil."
      echo "See doc/remediation-ETH-fxUSD-SPL.md for full details."
      echo ""
      echo "The SPL must already be paused on mainnet."
      echo ""
      echo "Steps:"
      echo "  1. Start anvil fork"
      echo "  2. Deploy and execute all 5 Safe batches locally"
      echo "  3. Run assertions against v2 correct state"
      echo ""
      echo "Environment variables:"
      echo "  FORGE_VERBOSITY     Forge verbosity flag (default: -vv)"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

# ── Helpers ────────────────────────────────────────────────────────────────────

prompt() {
  local msg="$1"
  echo ""
  echo "──────────────────────────────────────────────────────────────"
  echo "$msg"
  echo "──────────────────────────────────────────────────────────────"
  read -rn1 -p "Ready? [Y/n] " response
  echo ""
  if [[ "$response" =~ ^[Nn]$ ]]; then
    echo "Aborted."
    exit 1
  fi
}

# ── Main ───────────────────────────────────────────────────────────────────────

echo "======================================================================"
echo "  ETH::fxUSD SPL Remediation Verification"
echo "======================================================================"

# ── Step 1: Start anvil ──────────────────────────────────────────────────────

prompt "Start anvil fork (SPL already paused):  script/anvil --block latest"

# ── Step 2: Deploy, approve, remediate, restore ──────────────────────────────
# In --local mode, the script pranks as each signer (Claimer, bounty receiver,
# multisig) to simulate all 5 batches end-to-end on the local anvil fork.

echo ""
echo "Deploying remediation, executing all batches locally..."
./script/run-script Remediate_SPL_ETH_fxUSD --network mainnet --salt harbor_v1 --broadcast --local

# ── Step 3: Run assertions ────────────────────────────────────────────────────

echo ""
echo "Running post-remediation assertions..."
forge test \
  --match-path script/test/SPLRemediationTest.t.sol \
  --fork-url local $FORGE_VERBOSITY

echo ""
echo "Done. See results/post_remediation.csv"
