        // First fork: capture pre-rebalance values (the target)
        vm.createSelectFork(rpc, PRE_REBALANCE_BLOCK);
        _setSaltPrefix("harbor_v1");

        stabilityPoolLeveraged = _predictAddress("ETH", "fxUSD", "stabilityPoolLeveraged");
        stabilityPoolCollateral = _predictAddress("ETH", "fxUSD", "stabilityPoolCollateral");
        minter = _predictAddress("ETH", "fxUSD", "minter");
        pegged = _predictAddress("ETH", "pegged");
        leveraged = _predictAddress("ETH", "fxUSD", "leveraged");
        wrappedCollateral = IMinter(minter).WRAPPED_COLLATERAL_TOKEN();

        _initHolders();
        _capturePreRebalanceValues();

        // Second fork: the actual state just before the pause
        vm.createSelectFork(rpc, FORK_BLOCK);
        // Re-predict addresses (fork changed, labels need re-setting)
        _setSaltPrefix("harbor_v1");
        stabilityPoolLeveraged = _predictAddress("ETH", "fxUSD", "stabilityPoolLeveraged");
        stabilityPoolCollateral = _predictAddress("ETH", "fxUSD", "stabilityPoolCollateral");
        minter = _predictAddress("ETH", "fxUSD", "minter");
        pegged = _predictAddress("ETH", "pegged");
        leveraged = _predictAddress("ETH", "fxUSD", "leveraged");
        proxyOwner = IBaoOwnable(stabilityPoolLeveraged).owner();

        // Read existing v2 implementation from ERC-1967 slot
        existingV2Impl = address(uint160(uint256(vm.load(
            stabilityPoolLeveraged,
            0x360894a13ba1a3210667c828492db98dca3e2076cc3735a920a3ca505d382bbc
        ))));
    }

