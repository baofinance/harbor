    /// @dev Snapshot all holder balances into storage arrays.
    function _snapshotAll() private {
        IStabilityPool spl = IStabilityPool(stabilityPoolLeveraged);
        IMultipleRewardAccumulator acc = IMultipleRewardAccumulator(stabilityPoolLeveraged);
        address liqToken = spl.LIQUIDATION_TOKEN();

        for (uint256 i = 0; i < holders.length; i++) {
            address h = holders[i];
            assetBalBefore.push(spl.assetBalanceOf(h));
            levBalBefore.push(IERC20(leveraged).balanceOf(h));
            pegBalBefore.push(IERC20(pegged).balanceOf(h));
            claimableBefore.push(acc.claimable(h, liqToken));
            claimedBefore.push(acc.claimed(h, liqToken));
            spcDepositBefore.push(IStabilityPool(stabilityPoolCollateral).assetBalanceOf(h));
        }
    }

    /// @dev Verify all holder balances match pre-upgrade snapshot.
    function _verifyAll() private view {
        IStabilityPool spl = IStabilityPool(stabilityPoolLeveraged);
        address liqToken = spl.LIQUIDATION_TOKEN();
        uint256 failures;

        for (uint256 i = 0; i < holders.length; i++) {
            address h = holders[i];

            uint256 assetBal = spl.assetBalanceOf(h);
            uint256 levBal = IERC20(leveraged).balanceOf(h);
            uint256 pegBal = IERC20(pegged).balanceOf(h);
            uint256 claimable = IMultipleRewardAccumulator(stabilityPoolLeveraged).claimable(h, liqToken);
            uint256 spcDeposit = IStabilityPool(stabilityPoolCollateral).assetBalanceOf(h);

            bool anyDiff = assetBal != assetBalBefore[i]
                || levBal != levBalBefore[i]
                || pegBal != pegBalBefore[i]
                || claimable != claimableBefore[i]
                || spcDeposit != spcDepositBefore[i];

            if (anyDiff) {
                console.log("  DIFF %s", h);
                if (assetBal != assetBalBefore[i])
                    console.log("    SPL deposit:  %e -> %e", assetBalBefore[i], assetBal);
                if (levBal != levBalBefore[i])
                    console.log("    sailETH bal:  %e -> %e", levBalBefore[i], levBal);
                if (pegBal != pegBalBefore[i])
                    console.log("    haETH bal:    %e -> %e", pegBalBefore[i], pegBal);
                if (claimable != claimableBefore[i])
                    console.log("    claimable:    %e -> %e", claimableBefore[i], claimable);
                if (spcDeposit != spcDepositBefore[i])
                    console.log("    SPC deposit:  %e -> %e", spcDepositBefore[i], spcDeposit);
                failures++;
            }
        }

        assertEq(failures, 0, "some holders have changed state");
    }

    /// @dev Log holders with non-zero positions.
    function _logHoldings() private view {
        IStabilityPool spl = IStabilityPool(stabilityPoolLeveraged);
        address liqToken = spl.LIQUIDATION_TOKEN();

        for (uint256 i = 0; i < holders.length; i++) {
            address h = holders[i];
            uint256 levBal = IERC20(leveraged).balanceOf(h);
            uint256 pegBal = IERC20(pegged).balanceOf(h);
            uint256 splDep = spl.assetBalanceOf(h);
            uint256 spcDep = IStabilityPool(stabilityPoolCollateral).assetBalanceOf(h);
            uint256 claimable = IMultipleRewardAccumulator(stabilityPoolLeveraged).claimable(h, liqToken);

            if (levBal == 0 && pegBal == 0 && splDep == 0 && spcDep == 0 && claimable == 0) continue;

            console.log("  %s", h);
            if (levBal > 0)    console.log("    sailETH:   %e", levBal);
            if (pegBal > 0)    console.log("    haETH:     %e", pegBal);
            if (splDep > 0)    console.log("    SPL dep:   %e", splDep);
            if (spcDep > 0)    console.log("    SPC dep:   %e", spcDep);
            if (claimable > 0) console.log("    claimable: %e", claimable);
        }
    }

    // Prices captured before and after remediation
    uint256 levPriceBefore;
    uint256 levPriceAfter;
    uint256 pegPrice;

    /// @dev Capture each holder's current value (post-bug, pre-remediation).
    function _captureCurrentValues() private {
        for (uint256 i = 0; i < holders.length; i++) {
            currentValue.push(_holderValueAt(holders[i], levPriceBefore));
        }
    }

    /// @dev Total value for a holder in ETH, including:
    /// - leveraged tokens (held + claimable from SPL) at levPrice
    /// - pegged tokens (held + SPL deposit + SPC deposit) at pegPrice
    /// - collateral rewards (claimable from SPC + held wCol) at wCol price
    function _holderValueAt(address h, uint256 levPrice) private view returns (uint256 value) {
        // Leveraged side
        IMultipleRewardAccumulator splAcc = IMultipleRewardAccumulator(stabilityPoolLeveraged);
        uint256 totalLev = IERC20(leveraged).balanceOf(h) + splAcc.claimable(h, leveraged);

        // Pegged side: wallet + sail stability pool deposit only.
        // SPC deposit and fxSAVE rewards are excluded from all columns because
        // the collateral stability pool side is unaffected by the bug — pegged
        // was correctly exchanged for collateral. Including either side without
        // the other creates a false gain/loss from the conversion.
        uint256 totalPeg = IERC20(pegged).balanceOf(h)
            + IStabilityPool(stabilityPoolLeveraged).assetBalanceOf(h);

        value = totalLev * levPrice / 1 ether
            + totalPeg * pegPrice / 1 ether;
    }

    /// @notice Test the full pause -> remediate -> restore cycle.
    function test_pause_remediate_restore() public {
        console.log("=== PRE-REMEDIATION HOLDINGS ===");
        _logHoldings();

        uint256 totalAssetsBefore = IStabilityPool(stabilityPoolLeveraged).totalAssetSupply();
        uint256 levSupplyBefore = IERC20(leveraged).totalSupply();

        levPriceBefore = IMinter(minter).leveragedTokenPrice();
        pegPrice = IMinter(minter).peggedTokenPrice();

        console.log("");
        console.log("=== POOL TOTALS ===");
        console.log("  totalAssetSupply:  %e", totalAssetsBefore);
        console.log("  SPL lev balance:   %e", IERC20(leveraged).balanceOf(stabilityPoolLeveraged));
        console.log("  lev totalSupply:   %e", levSupplyBefore);
        console.log("  lev price:         %e", levPriceBefore);

        _snapshotAll();

        // Capture "value now" (post-bug, pre-remediation) for each holder
        _captureCurrentValues();

        // ---- Pause -> Remediate -> Restore ----
        _doRemediate();

        levPriceAfter = IMinter(minter).leveragedTokenPrice();
        uint256 levSupplyAfter = IERC20(leveraged).totalSupply();

        console.log("");
        console.log("=== POST-REMEDIATION STATE ===");
        console.log("  lev price before:  %e", levPriceBefore);
        console.log("  lev price after:   %e", levPriceAfter);
        console.log("  lev supply:        %e -> %e", levSupplyBefore, levSupplyAfter);
        console.log("  tokens burned:     %e", levSupplyBefore - levSupplyAfter);

        assertEq(IStabilityPool(stabilityPoolLeveraged).totalAssetSupply(), totalAssetsBefore, "totalAssetSupply changed");
        assertGt(levPriceAfter, levPriceBefore, "lev price should increase");

        // ---- Value analysis ----
        _logTables();
    }

    /// @dev Execute the full pause -> remediate -> restore sequence.
    function _doRemediate() private {
        // Pause
        vm.prank(proxyOwner);
        UUPSUpgradeable(stabilityPoolLeveraged).upgradeToAndCall(PAUSER, "");

        // Grant BURNER_ROLE
        vm.prank(IBaoOwnable(leveraged).owner());
        IBaoRoles(leveraged).grantRoles(stabilityPoolLeveraged, 1 << 1);

        // Remediate
        PostRebalanceRemediationForStabilityPool_v2 impl =
            new PostRebalanceRemediationForStabilityPool_v2(leveraged, proxyOwner);
        vm.prank(proxyOwner);
        UUPSUpgradeable(stabilityPoolLeveraged).upgradeToAndCall(
            address(impl),
            abi.encodeCall(PostRebalanceRemediationForStabilityPool_v2.remediate, ())
        );

        // Restore
        vm.prank(proxyOwner);
        UUPSUpgradeable(stabilityPoolLeveraged).upgradeToAndCall(existingV2Impl, "");
    }

    /// @dev Write combined value + token count CSV.
    function _logTables() private {
        // Build CSV content
        string memory csv = "Address,Value Target ($),Value Now ($),Value Post ($),Recovered ($),vs Target ($),sailETH Pre-Held,sailETH Now-Held,sailETH Claimable,sailETH Excess\n";

        int256 totalRecovered;
        int256 totalVsTarget;

        for (uint256 i = 0; i < holders.length; i++) {
            if (holders[i] == stabilityPoolLeveraged || holders[i] == stabilityPoolCollateral) continue;

            (bool show, int256 rec, int256 vt, string memory row) = _csvRow(i);
            if (!show) continue;
            totalRecovered += rec;
            totalVsTarget += vt;
            csv = string.concat(csv, row, "\n");
        }

        // Add totals row
        csv = string.concat(csv,
            "TOTAL,,,,",
            _signedCsvUsd(totalRecovered), ",",
            _signedCsvUsd(totalVsTarget), ",,,,\n"
        );

        vm.createDir("tmp", true);
        vm.writeFile("tmp/remediation_analysis.csv", csv);
        console.log("  Analysis written to tmp/remediation_analysis.csv");
        console.log(string.concat("  Recovered by remediation: ", _signedCsvUsd(totalRecovered)));
        console.log(string.concat("  vs Target: ", _signedCsvUsd(totalVsTarget), " (includes ETH price movement)"));
    }

    // Temp storage for row data to avoid stack depth issues
    uint256[7] private _row;  // target, now, post, preHeld, nowHeld, claimable, claimed

    function _csvRow(uint256 i) private returns (bool show, int256 recovered, int256 vsTarget, string memory row) {
        IMultipleRewardAccumulator acc = IMultipleRewardAccumulator(stabilityPoolLeveraged);
        _row[0] = preRebalanceValue[i];
        _row[1] = currentValue[i];
        _row[2] = _holderValueAt(holders[i], levPriceAfter);
        _row[3] = preRebalanceLevBal[i];
        _row[4] = IERC20(leveraged).balanceOf(holders[i]);
        _row[5] = acc.claimable(holders[i], leveraged);
        _row[6] = acc.claimed(holders[i], leveraged);

        if (_row[0] == 0 && _row[1] == 0 && _row[2] == 0 && _row[3] == 0 && _row[4] == 0)
            return (false, 0, 0, "");

        show = true;
        recovered = int256(_row[2]) - int256(_row[1]);
        vsTarget = int256(_row[2]) - int256(_row[0]);

        uint256 heldIncrease = _row[4] > _row[3] ? _row[4] - _row[3] : 0;
        uint256 excess = heldIncrease > _row[6] ? heldIncrease : _row[6];

        row = string.concat(
            vm.toString(holders[i]), ",",
            _csvUsd(_row[0]), ",",
            _csvUsd(_row[1]), ",",
            _csvUsd(_row[2]), ","
        );
        row = string.concat(row,
            _signedCsvUsd(recovered), ",",
            _signedCsvUsd(vsTarget), ",",
            _fmtTokens(_row[3]), ",",
            _fmtTokens(_row[4]), ",",
            _fmtTokens(_row[5]), ",",
            excess == 0 ? "" : _fmtTokens(excess)
        );
    }

    /// @dev Format wei as CSV-friendly USD: "1234.56" (no $ sign, for spreadsheet).
    function _csvUsd(uint256 wei_) private pure returns (string memory) {
        uint256 cents = wei_ * ETH_USD / 1e16;
        uint256 whole = cents / 100;
        uint256 frac = cents % 100;
        string memory fracStr = vm.toString(frac);
        if (bytes(fracStr).length < 2) fracStr = string.concat("0", fracStr);
        return string.concat(vm.toString(whole), ".", fracStr);
    }

    function _signedCsvUsd(int256 v) private pure returns (string memory) {
        if (v >= 0) return _csvUsd(uint256(v));
        return string.concat("-", _csvUsd(uint256(-v)));
    }

    /// @dev Left-pad (right-align) a string to width.
    function _pad(string memory s, uint256 width) private pure returns (string memory) {
        bytes memory b = bytes(s);
        if (b.length >= width) return s;
        uint256 padding = width - b.length;
        bytes memory padded = new bytes(width);
        for (uint256 i = 0; i < padding; i++) padded[i] = " ";
        for (uint256 i = 0; i < b.length; i++) padded[padding + i] = b[i];
        return string(padded);
    }

    /// @dev Format token amount as "X.XXXX" with 4 decimal places.
    function _fmtTokens(uint256 amount) private pure returns (string memory) {
        uint256 whole = amount / 1 ether;
        uint256 frac = (amount % 1 ether) / 1e14;
        string memory fracStr = vm.toString(frac);
        while (bytes(fracStr).length < 4) fracStr = string.concat("0", fracStr);
        return string.concat(vm.toString(whole), ".", fracStr);
    }

    function _signedTokens(int256 v) private pure returns (string memory) {
        if (v >= 0) return string.concat("+", _fmtTokens(uint256(v)));
        return string.concat("-", _fmtTokens(uint256(-v)));
    }

    function _shortAddr(address a) private pure returns (string memory) {
        string memory full = vm.toString(a);
        // Return first 6 + last 4 chars: 0x1234...abcd
        bytes memory b = bytes(full);
        bytes memory result = new bytes(13); // "0x1234...abcd"
        for (uint256 i = 0; i < 6; i++) result[i] = b[i];
        result[6] = ".";
        result[7] = ".";
        result[8] = ".";
        for (uint256 i = 0; i < 4; i++) result[9 + i] = b[b.length - 4 + i];
        return string(result);
    }

    function _signedUsd(int256 v) private pure returns (string memory) {
        if (v >= 0) {
            return string.concat("+", _usd(uint256(v)));
        } else {
            return string.concat("-", _usd(uint256(-v)));
        }
    }

    uint256 constant ETH_USD = 2151; // ETH price in USD

    /// @dev Format wei as "$X.YY" (USD via ETH price).
    function _usd(uint256 wei_) private pure returns (string memory) {
        uint256 cents = wei_ * ETH_USD / 1e16; // wei -> cents (1e18 * price / 1e18 * 100)
        uint256 whole = cents / 100;
        uint256 frac = cents % 100;
        string memory fracStr = vm.toString(frac);
        if (bytes(fracStr).length < 2) {
            fracStr = string.concat("0", fracStr);
        }
        return string.concat("$", vm.toString(whole), ".", fracStr);
    }

    function _logTableRow(address h, uint256 valB, uint256 valA, int256 delta) private pure {
        uint256 absDelta = delta > 0 ? uint256(delta) : uint256(-delta);
        console.log(string.concat(
            "| ", vm.toString(h),
            " | ", _usd(valB),
            " | ", _usd(valA),
            " | ", delta < 0 ? "-" : "+", _usd(absDelta),
            " |"
        ));
    }
}
