#!/usr/bin/env bash
set -euo pipefail

# Universal forge script runner for Harbor.
#
# Runs a Solidity script with standardised environment and forge arguments.
# Scripts using the SafeBatch pattern get their batch JSON saved automatically.
#
# Default entry point: run(string) with the salt prefix.
# Use -- to override the forge --sig (e.g., for legacy deploy scripts).

[[ -f "foundry.toml" ]] || { echo "❌ Run from project root" >&2; exit 1; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<EOF
Usage:
  $0 <ScriptName> --network <net> --salt <salt> [options] [-- <extra forge args>]

Required:
  <ScriptName>       Solidity script contract name (e.g., Deploy_StabilityPool_v2_mainnet)
  --network <net>    Network name (mainnet, arbitrum, base)
  --salt <salt>      Salt prefix (e.g., harbor_v1)

Options:
  --broadcast        Broadcast transactions on-chain (adds --broadcast --slow --ffi --verify)
  --account <name>   Foundry keystore account name (required for non-local broadcast)
  --local            Use local anvil node (auto-impersonate, local state directory)
  --timestamp        Add timestamp to local state directory (requires --local)
  --resume           Resume a previous broadcast
  -m, --message      Override safe batch description (max 256 chars)
  -h, --help         Show this help message

Pass-through:
  -- <args>          Extra arguments passed directly to forge script.
                     If --sig is included, it overrides the default "run(string)".

Examples:
  $0 Deploy_StabilityPool_v2_mainnet --salt harbor_v1 --network mainnet --broadcast --local
  $0 UpdateVolatility_Example --salt harbor_v1 --network mainnet
EOF
}

NETWORK=""
SALT=""
SCRIPT_NAME=""
USE_LOCAL=false
USE_TIMESTAMP=false
USE_BROADCAST=false
ACCOUNT=""
MESSAGE=""
FORGE_EXTRA=()
EXTRA_FORGE_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --)
      shift
      EXTRA_FORGE_ARGS=("$@")
      break
      ;;
    --network)   NETWORK=$2;       shift 2 ;;
    --salt)      SALT=$2;          shift 2 ;;
    --broadcast) USE_BROADCAST=true; shift ;;
    --account)   ACCOUNT=$2;       shift 2 ;;
    --local)     USE_LOCAL=true;    shift ;;
    --timestamp) USE_TIMESTAMP=true; shift ;;
    --resume)    FORGE_EXTRA+=(--resume); shift ;;
    -m|--message) MESSAGE=$2;      shift 2 ;;
    -h|--help)   usage; exit 0 ;;
    -*)          echo "❌ Unknown option: $1" >&2; exit 1 ;;
    *)           SCRIPT_NAME="$1"; shift ;;
  esac
done

# ── Validation ────────────────────────────────────────────────────────────

[[ -n "$SCRIPT_NAME" ]] || { echo "❌ Script name required" >&2; usage >&2; exit 1; }
[[ -n "$NETWORK" ]]     || { echo "❌ --network required" >&2; exit 1; }
[[ -n "$SALT" ]]        || { echo "❌ --salt required" >&2; exit 1; }
[[ "$USE_TIMESTAMP" == false || "$USE_LOCAL" == true ]] || { echo "❌ --timestamp requires --local" >&2; exit 1; }
[[ "$USE_BROADCAST" == true || "$USE_LOCAL" == true || -n "$ACCOUNT" ]] || true  # account optional

SCRIPT_PATH="script/${SCRIPT_NAME}.s.sol"
[[ -f "$SCRIPT_PATH" ]] || { echo "❌ Script not found: $SCRIPT_PATH" >&2; exit 1; }

# ── RPC and state directory ───────────────────────────────────────────────

if [[ "$USE_LOCAL" == true ]]; then
  RPC_URL="local"
  if [[ "$USE_TIMESTAMP" == true ]]; then
    export DEPLOY_STATE_SUBDIR="local-$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  else
    export DEPLOY_STATE_SUBDIR="local"
  fi
else
  RPC_URL=$NETWORK
fi

CHAIN_ID=$(cast chain-id --rpc-url "$RPC_URL" 2>/dev/null) || {
  echo "❌ RPC failed: $RPC_URL" >&2
  exit 1
}

FORGE_ARGS=(--rpc-url "$RPC_URL")

# ── Account / signer ─────────────────────────────────────────────────────

if [[ "$USE_LOCAL" == true && -n "$ACCOUNT" ]]; then
  FORGE_ARGS+=(--account "$ACCOUNT" --unlocked)
elif [[ "$USE_LOCAL" == true ]]; then
  FORGE_ARGS+=(--unlocked --sender 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266)
elif [[ -n "$ACCOUNT" ]]; then
  FORGE_ARGS+=(--account "$ACCOUNT")
fi

# ── Broadcast mode ────────────────────────────────────────────────────────

if [[ "$USE_BROADCAST" == true ]]; then
  FORGE_ARGS+=(--broadcast --slow --ffi)
  # MegaETH and Monad use Etherscan API v2 (chainid in URL); skip default Forge verify (Sourcify doesn't support 4326/143).
  # Verify those separately via Etherscan API v2 (see doc/DEPLOY-NEW-MARKETS-PREP.md and bao-factory script).
  if [[ "$USE_LOCAL" == true ]]; then
    :
  elif [[ "$NETWORK" == "megaeth" || "$NETWORK" == "monad" ]]; then
    :
  else
    FORGE_ARGS+=(--verify)
  fi
  # Skip simulation on broadcast to avoid "intrinsic gas too low" on L2s (MegaETH, etc.)
  FORGE_ARGS+=(--skip-simulation)
fi

# ── Environment for Solidity ──────────────────────────────────────────────

export NETWORK
export SAFE_BATCH_NAME="$SCRIPT_NAME"
export SAFE_BATCH_TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)

if [[ -n "$MESSAGE" ]]; then
  DESCRIPTION="$MESSAGE"
else
  DESCRIPTION="$SCRIPT_NAME --salt $SALT"
fi
if [[ ${#DESCRIPTION} -gt 256 ]]; then
  DESCRIPTION="${DESCRIPTION:0:253}..."
fi
export SAFE_BATCH_DESCRIPTION="$DESCRIPTION"

if [[ "$USE_LOCAL" == true ]]; then
  export EXECUTE_LOCAL=true
fi

# ── Append extra forge flags ──────────────────────────────────────────────

FORGE_ARGS+=("${FORGE_EXTRA[@]}")

# ── Display ───────────────────────────────────────────────────────────────

echo "======================================================" >&2
echo "  RUN SCRIPT: $SCRIPT_NAME" >&2
echo "======================================================" >&2
echo "  Salt:       $SALT" >&2
echo "  Network:    $NETWORK ($RPC_URL, chainId: $CHAIN_ID)" >&2
echo "  Broadcast:  $USE_BROADCAST" >&2
echo "  Local:      $USE_LOCAL" >&2
[[ -z "$ACCOUNT" ]] || echo "  Account:    $ACCOUNT" >&2
echo "  forge args: ${FORGE_ARGS[*]}" >&2
echo "" >&2

START_TIME=$(date +%s)

# Default: --sig "run(string)" with salt.
# If -- was used and includes --sig, the caller controls the entry point.
if [[ ${#EXTRA_FORGE_ARGS[@]} -gt 0 ]]; then
  forge script "$SCRIPT_PATH" --tc "$SCRIPT_NAME" "${EXTRA_FORGE_ARGS[@]}" "${FORGE_ARGS[@]}"
else
  forge script "$SCRIPT_PATH" --tc "$SCRIPT_NAME" --sig "run(string)" "$SALT" "${FORGE_ARGS[@]}"
fi

END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))
MINS=$((ELAPSED / 60))
SECS=$((ELAPSED % 60))

echo "" >&2
echo "======================================================" >&2
echo "  COMPLETE" >&2
printf "  Took: %dm %02ds\n" "$MINS" "$SECS" >&2
echo "======================================================" >&2
