#!/usr/bin/env bash
set -euo pipefail

# Validate Harbor minter deployments against blockchain state
#
# This script verifies:
#   1. Proxy address matches salt prediction from BaoFactory
#   2. All addresses have deployed code
#   3. Proxies have ERC1967 implementation slot (UUPS pattern)
#   4. Proxy owner() returns expected treasury address
#   5. ERC1967 implementation slot matches state file
#   6. Implementations are NOT the UUPSProxyDeployStub (upgrade completed)
#   7. wrappedPriceAggregator is deployed for each market
#
# Items are grouped by peg, then by market (peg::collateral).

# ── Constants ──────────────────────────────────────────────────────────────

CAST=cast
BAO_FACTORY=0xD696E56b3A054734d4C6DCBD32E11a278b0EC458
EXPECTED_OWNER=0x9bABfC1A1952a6ed2caC1922BFfE80c0506364a2

# ── Shared variables ───────────────────────────────────────────────────────

CHAIN_ID=""
STATE_FILE=""
RPC_URL=""
NETWORK=""

# ── Library functions ──────────────────────────────────────────────────────

has_code() {
  local addr=$1
  local code
  code=$("$CAST" code "$addr" --rpc-url "$RPC_URL" 2>/dev/null | head -n 1 || echo "0x")
  [[ "$code" != "0x" ]]
}

# Check if contract is a UUPS proxy by reading the ERC1967 implementation slot.
# Both OpenZeppelin and Solady UUPS proxies use the same slot for storing the implementation.
# This is more robust than calling UUPS-specific functions which differ between implementations:
#   - OZ has UPGRADE_INTERFACE_VERSION() callable through proxy
#   - Solady's proxiableUUID() reverts through proxy due to notDelegated modifier
is_uups_proxy() {
  local addr=$1
  local impl
  impl=$("$CAST" implementation "$addr" --rpc-url "$RPC_URL" 2>/dev/null || echo "")
  [[ -n "$impl" && "$impl" != "0x0000000000000000000000000000000000000000" ]]
}

# Get owner from contract
get_owner() {
  local addr=$1
  "$CAST" call "$addr" "owner()(address)" --rpc-url "$RPC_URL" 2>/dev/null || echo ""
}

# Read ERC1967 implementation slot
get_erc1967_implementation() {
  local proxy=$1
  local impl
  impl=$("$CAST" implementation "$proxy" --rpc-url "$RPC_URL" 2>/dev/null)
  if [[ -z "$impl" || "$impl" == "0x0000000000000000000000000000000000000000" ]]; then
    echo ""
    return 1
  fi
  "$CAST" to-check-sum-address "$impl"
}

# Check if implementation is the UUPSProxyDeployStub
# The stub is a minimal contract that only has: owner(), upgradeTo(), upgradeToAndCall(), proxiableUUID()
# Real implementations have many more functions. We detect the stub by checking:
# 1. It has owner() and upgradeToAndCall()
# 2. It does NOT have typical implementation functions like name(), symbol(), decimals(), etc.
is_uups_stub() {
  local impl_addr=$1

  # Check if it has owner() - the stub always has this
  if ! "$CAST" call "$impl_addr" "owner()(address)" --rpc-url "$RPC_URL" &>/dev/null; then
    return 1 # Not a stub (doesn't even have owner)
  fi

  # The stub's owner() returns the deployer (test harness), not the treasury
  # Real upgraded implementations return the treasury
  local impl_owner
  impl_owner=$("$CAST" call "$impl_addr" "owner()(address)" --rpc-url "$RPC_URL" 2>/dev/null || echo "")

  # Try a function that real implementations have but the stub doesn't
  # The stub bytecode is very small (~500 bytes), real implementations are much larger
  local code_size
  code_size=$("$CAST" code "$impl_addr" --rpc-url "$RPC_URL" 2>/dev/null | wc -c)

  # Stub bytecode is roughly 500-800 chars (hex), real impls are 10000+ chars
  if [[ "$code_size" -lt 2000 ]]; then
    return 0 # Likely the stub (very small bytecode)
  fi

  return 1 # Not a stub
}

# Predict proxy address from salt string using BaoFactory
predict_proxy_address() {
  local salt_str=$1
  local salt_b32
  salt_b32=$("$CAST" keccak "$("$CAST" from-utf8 "$salt_str")")
  "$CAST" call "$BAO_FACTORY" "predictAddress(bytes32)(address)" "$salt_b32" --rpc-url "$RPC_URL"
}

# Get implementation info by address
get_implementation_info() {
  local state_file=$1
  local addr=$2
  local field=$3
  jq -r --arg addr "$addr" --arg field "$field" '.implementations[$addr][$field] // "-"' "$state_file"
}

check_project_root() {
  if [[ ! -f "foundry.toml" ]] || [[ ! -d "src" ]]; then
    echo "❌ Must be run from the project root (missing foundry.toml or src/)" >&2
    exit 1
  fi
}

# Check if a named check is enabled. Called 6x per proxy in the main loop.
check_enabled() {
  local name=$1
  [[ -z "$CHECKS" ]] || [[ ",$CHECKS," == *",$name,"* ]]
}

# ── Usage ──────────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
Usage:
  $0 --network <network> --salt <salt> [options]

Required:
  --network       Network name (mainnet, arbitrum, base)
  --salt          Salt prefix (e.g., harbor_v1, test3)

Optional:
  --local         Use local anvil node (--rpc-url local, deployments/local/<network>/)
  --verbose, -v   Show passing check details (default: only show failures)
  --since [WHEN]  Only check items deployed since WHEN (default: 1 day)
                    Relative:  2 hours, 3 days, 1 week, 1 year
                    Absolute:  11-Feb-2026
                    Special:   yesterday (since midnight local time)
  --full          With --since: check all items in qualifying markets
                    (default: only check updated items + aggregator if minter changed)
  --update        Interactively update state file when implementation
                    mismatches a known on-chain address
  --filter TERMS  Only show items whose salt contains all TERMS (case-insensitive)
                    e.g., --filter BTC Leverag
  --check NAMES   Only run specific checks (comma-separated, default: all)
                    Available: salt, code, uups, owner, implementation, stub

Examples:
  $0 --network mainnet --salt harbor_v1
  $0 --network mainnet --salt harbor_v1 --since
  $0 --network mainnet --salt harbor_v1 --since 2 days
  $0 --network mainnet --salt harbor_v1 --since yesterday --check implementation,owner
  $0 --network mainnet --salt harbor_v1 --local

State file: deployments/<network>/<salt>.state.json
       or:  deployments/local/<network>/<salt>.state.json (with --local)
EOF
}

# ── Argument parsing ───────────────────────────────────────────────────────

NETWORK=""
SALT=""
USE_LOCAL=false
SINCE_SPEC=""
CHECKS=""
VERBOSE=false
FULL=false
UPDATE=false
FILTER_TERMS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --network)
      NETWORK=${2:-}
      shift 2
      ;;
    --salt)
      SALT=${2:-}
      shift 2
      ;;
    --local)
      USE_LOCAL=true
      shift
      ;;
    --check)
      CHECKS=${2:-}
      shift 2
      ;;
    --verbose | -v)
      VERBOSE=true
      shift
      ;;
    --full)
      FULL=true
      shift
      ;;
    --update)
      UPDATE=true
      shift
      ;;
    --filter)
      shift
      while [[ $# -gt 0 && "$1" != --* ]]; do
        FILTER_TERMS+=("$1")
        shift
      done
      ;;
    --since)
      next="${2:-}"
      if [[ -z "$next" || "$next" == --* ]]; then
        SINCE_SPEC="1 day"
        shift
      elif [[ "$next" == "yesterday" ]]; then
        SINCE_SPEC="yesterday"
        shift 2
      elif [[ "$next" =~ ^[0-9]+$ ]]; then
        unit="${3:-}"
        if [[ "$unit" =~ ^(hours?|days?|weeks?|months?|years?)$ ]]; then
          SINCE_SPEC="$next $unit"
          shift 3
        else
          SINCE_SPEC="$next days"
          shift 2
        fi
      elif [[ "$next" =~ ^[0-9]+\ (hours?|days?|weeks?|months?|years?)$ ]]; then
        SINCE_SPEC="$next"
        shift 2
      else
        SINCE_SPEC="$next"
        shift 2
      fi
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "❌ Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      echo "❌ Unexpected argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

# ── Validation ─────────────────────────────────────────────────────────────

check_project_root

if [[ -z "$NETWORK" ]]; then
  echo "❌ Missing --network" >&2
  usage >&2
  exit 1
fi

if [[ -z "$SALT" ]]; then
  echo "❌ Missing --salt" >&2
  usage >&2
  exit 1
fi

# Validate --check names
if [[ -n "$CHECKS" ]]; then
  IFS=',' read -ra check_list <<<"$CHECKS"
  for c in "${check_list[@]}"; do
    case "$c" in
      salt | code | uups | owner | implementation | stub) ;;
      *)
        echo "❌ Unknown check: $c" >&2
        echo "   Available: salt, code, uups, owner, implementation, stub" >&2
        exit 1
        ;;
    esac
  done
fi

# ── Initialize ─────────────────────────────────────────────────────────────

if [[ "$USE_LOCAL" == true ]]; then
  RPC_URL="local"
  STATE_FILE="deployments/local/${NETWORK}/${SALT}.state.json"
else
  RPC_URL="$NETWORK"
  STATE_FILE="deployments/${NETWORK}/${SALT}.state.json"
fi

if ! CHAIN_ID=$("$CAST" chain-id --rpc-url "$RPC_URL" 2>&1); then
  echo "❌ Failed to fetch chainId from RPC '$RPC_URL'" >&2
  echo "   $CHAIN_ID" >&2
  exit 1
fi
if [[ ! -f "$STATE_FILE" ]]; then
  echo "❌ State file not found: $STATE_FILE" >&2
  exit 1
fi

# Validate network matches
state_network=$(jq -r '.network // empty' "$STATE_FILE")
if [[ -n "$state_network" && "$state_network" != "$NETWORK" ]]; then
  echo "❌ State file network mismatch: $state_network (expected $NETWORK)" >&2
  exit 1
fi

# ── Parse --since ──────────────────────────────────────────────────────────

SINCE_CUTOFF=""
if [[ -n "$SINCE_SPEC" ]]; then
  if [[ "$SINCE_SPEC" == "yesterday" ]]; then
    SINCE_CUTOFF=$(date -d "yesterday 00:00:00" -u +%Y-%m-%dT%H:%M:%SZ)
  elif [[ "$SINCE_SPEC" =~ ^[0-9]+\ (hours?|days?|weeks?|months?|years?)$ ]]; then
    SINCE_CUTOFF=$(date -d "$SINCE_SPEC ago" -u +%Y-%m-%dT%H:%M:%SZ)
  else
    if ! SINCE_CUTOFF=$(date -d "$SINCE_SPEC" -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null); then
      echo "❌ Cannot parse --since value: $SINCE_SPEC" >&2
      echo "   Supported: N hour/day/week/month/year, yesterday, DD-Mon-YYYY" >&2
      exit 1
    fi
  fi
fi

# ── Main ───────────────────────────────────────────────────────────────────

echo ""
echo "═══════════════════════════════════════════════════════════"
echo "  BLOCKCHAIN VALIDATION"
echo "  Network: $NETWORK (chainId: $CHAIN_ID)"
echo "  RPC:     $RPC_URL"
echo "  State:   $STATE_FILE"
echo "  Owner:   $EXPECTED_OWNER"
if [[ -n "$SINCE_CUTOFF" ]]; then
  if [[ "$FULL" == true ]]; then
    echo "  Since:   $SINCE_CUTOFF ($SINCE_SPEC) [full]"
  else
    echo "  Since:   $SINCE_CUTOFF ($SINCE_SPEC) [updated only]"
  fi
fi
if (( ${#FILTER_TERMS[@]} > 0 )); then
  echo "  Filter:  ${FILTER_TERMS[*]}"
fi
if [[ -n "$CHECKS" ]]; then
  echo "  Checks:  $CHECKS"
fi
echo "═══════════════════════════════════════════════════════════"

passed=0
failed=0
failure_summary=""

# ── Build items, add aggregators, filter, sort — all in one jq call ───────
# Outputs pre-sorted TSV: PEG  MARKET  ITEM_TYPE  TIMESTAMP  KEY_SUFFIX  PROXY_ADDR  IMPL_ADDR  SALT  CONTRACT_TYPE
# MARKET = "_peg" for pegged proxies, collateral name for market items.
# ITEM_TYPE = "proxy", "aggregator", "remaining"
# Items are sorted by: peg (most recent market desc), _peg first then markets
# (most recent desc), aggregator then proxy (by key) then remaining (by key).

FULL_ARG=false; [[ "$FULL" == true ]] && FULL_ARG=true
FILTER_JSON="[]"
if (( ${#FILTER_TERMS[@]} > 0 )); then
  FILTER_JSON=$(printf '%s\n' "${FILTER_TERMS[@]}" | jq -R 'ascii_downcase' | jq -s '.')
fi
sorted_items=$(jq -r --arg salt "$SALT" --arg cutoff "${SINCE_CUTOFF:-}" --argjson full "$FULL_ARG" --argjson filter "$FILTER_JSON" '
  .proxies as $proxies | .implementations as $impls |
  ($proxies | [.[].implementation]) as $active |

  # ── Build all items ──
  [
    ($proxies | to_entries[] |
      (.key | split("::")) as $parts |
      .value.implementation as $impl_addr |
      if ($parts | length) == 2 then
        { peg: $parts[0], market: "_peg", type: "proxy",
          ts: ($impls[$impl_addr].deploymentTime // "-"),
          key: $parts[1], proxy: .value.address, impl: $impl_addr,
          salt: .value.salt, contract: ($impls[$impl_addr].contractType // "-") }
      else
        { peg: $parts[0], market: $parts[1], type: "proxy",
          ts: ($impls[$impl_addr].deploymentTime // "-"),
          key: $parts[2], proxy: .value.address, impl: $impl_addr,
          salt: .value.salt, contract: ($impls[$impl_addr].contractType // "-") }
      end
    ),
    ($impls | to_entries[] |
      select((.key) as $k | ($active | index($k)) | not) |
      ((.value.proxy // "") | split("::")) as $parts |
      if ($parts | length) == 2 then
        { peg: $parts[0], market: "_peg", type: "remaining",
          ts: (.value.deploymentTime // "-"),
          key: $parts[1], proxy: "-", impl: .key, salt: "-",
          contract: (.value.contractType // "-") }
      elif ($parts | length) >= 3 then
        { peg: $parts[0], market: $parts[1], type: "remaining",
          ts: (.value.deploymentTime // "-"),
          key: $parts[2], proxy: "-", impl: .key, salt: "-",
          contract: (.value.contractType // "-") }
      else
        { peg: "_shared", market: "_standalone", type: "remaining",
          ts: (.value.deploymentTime // "-"),
          key: (.value.contractType // .key), proxy: "-", impl: .key, salt: "-",
          contract: (.value.contractType // "-") }
      end
    )
  ] |

  # ── Add synthetic aggregator for each unique market ──
  ([ .[] | select(.market != "_peg" and .market != "_standalone") | { peg, market } ] | unique) as $markets |
  . + [ $markets[] |
    { peg, market, type: "aggregator", ts: "-", key: "wrappedPriceAggregator",
      proxy: "-", impl: "-",
      salt: ($salt + "::" + .market + "::" + .peg + "::wrappedPriceAggregator"),
      contract: "-" }
  ] |

  # ── Apply --filter (case-insensitive match on peg::market::key) ──
  (if ($filter | length) > 0 then
    [ .[] | select(
      ((.peg + "::" + .market + "::" + .key) | ascii_downcase) as $match |
      all($filter[]; . as $term | ($match | contains($term)))
    )]
  else . end) |

  # ── Group by market, compute max timestamps ──
  group_by([.peg, .market]) |
  map({
    peg: .[0].peg, market: .[0].market, items: .,
    max_ts: ([ .[].ts | select(. != "" and . != "-") ] | if length > 0 then max else "" end)
  }) |

  # ── Group by peg, compute peg-level max timestamp ──
  group_by(.peg) |
  map({
    peg: .[0].peg, markets: .,
    peg_max_ts: ([ .[] | select(.market != "_peg") | .max_ts | select(. != "" and . != "-") ]
                 | if length > 0 then max else "" end)
  }) |

  # ── Apply --since filter at market level ──
  (if $cutoff != "" then
    [ .[] | select(.peg_max_ts >= $cutoff) |
      .markets = [ .markets[] | select(.market == "_peg" or .max_ts >= $cutoff) ]
    ]
  else . end) |

  # ── Item-level filter: only check updated items (unless --full) ──
  # Per-key max timestamp: if a remaining impl is recent, also check its proxy.
  # If any minter key is recent, also include the aggregator for that market.
  (if $cutoff != "" and ($full | not) then
    [ .[] |
      .markets = [ .markets[] |
        ([.items[] | {key: .key, ts: .ts}] | group_by(.key) |
         map({key: .[0].key, value: ([.[].ts | select(. != "" and . != "-")] |
           if length > 0 then max else "" end)}) | from_entries) as $key_max |
        ($key_max["minter"] // "" | . >= $cutoff) as $has_recent_minter |
        .items = [ .items[] | select(
          ($key_max[.key] // "") >= $cutoff or
          (.type == "aggregator" and $has_recent_minter)
        )]
      | select((.items | length) > 0) ]
    | select((.markets | length) > 0) ]
  else . end) |

  # ── Sort pegs by max timestamp desc ──
  sort_by(.peg_max_ts) | reverse |

  # ── Sort markets within peg: _peg first, then by max_ts desc ──
  # ── Sort items within market: aggregator, proxy (by key), remaining (by key) ──
  [ .[] |
    .markets = (
      [ .markets[] | select(.market == "_peg") ] +
      ([ .markets[] | select(.market != "_peg") ] | sort_by(.max_ts) | reverse)
    ) |
    .markets = [ .markets[] |
      .items = (
        [ .items[] | select(.type == "aggregator") ] +
        ([ .items[] | select(.type == "proxy") ] | sort_by(.key)) +
        ([ .items[] | select(.type == "remaining") ] | sort_by(.key))
      )
    ]
  ] |

  # ── Flatten to sorted TSV ──
  .[] | .markets[] | .items[] |
  [.peg, .market, .type, .ts, .key, .proxy, .impl, .salt, .contract] | @tsv
' "$STATE_FILE")

if [[ -z "$sorted_items" ]]; then
  echo ""
  if [[ -n "$SINCE_CUTOFF" ]]; then
    echo "No markets deployed since $SINCE_CUTOFF"
  else
    echo "No items found in state file."
  fi
  echo ""
  echo "✅ ALL CHECKS PASSED"
  exit 0
fi

# ── Iterate pre-sorted items ─────────────────────────────────────────────

current_peg=""
current_market=""
in_remaining=false
pending_updates=()

while IFS=$'\t' read -r peg market item_type timestamp key_suffix proxy_addr impl_addr salt contract_type; do
  [[ -z "$item_type" ]] && continue

  # ── Peg change → print peg header ──
  if [[ "$peg" != "$current_peg" ]]; then
    current_peg="$peg"
    current_market=""
    echo ""
    echo "══ $peg ════════════════════════════════════════════════════"
  fi

  # ── Market change → flush pending updates, print market header ──
  if [[ "$market" != "$current_market" ]]; then
    for upd in "${pending_updates[@]}"; do
      IFS='|' read -r upd_key upd_addr upd_type <<< "$upd"
      echo ""
      printf "  Update %s to %s (%s)? [y/N] " "$upd_key" "$upd_addr" "$upd_type" >/dev/tty
      read -n1 -r answer </dev/tty
      echo "" >/dev/tty
      if [[ "$answer" == [yY] ]]; then
        jq --arg key "$upd_key" --arg addr "$upd_addr" \
          '.proxies[$key].implementation = $addr' "$STATE_FILE" > "${STATE_FILE}.tmp" \
          && mv "${STATE_FILE}.tmp" "$STATE_FILE"
        echo "  ✅ Updated." >/dev/tty
        failed=$((failed - 1))
        passed=$((passed + 1))
      else
        echo "  Skipped." >/dev/tty
      fi
    done
    pending_updates=()
    current_market="$market"
    in_remaining=false
    echo ""
    if [[ "$market" == "_peg" ]]; then
      echo "── ${peg}::pegged ──────────────────────────────────────"
    else
      echo "── ${peg}::${market} ──────────────────────────────────────"
    fi
  fi

  # ── "not active" separator ──
  if [[ "$item_type" == "remaining" && "$in_remaining" == false ]]; then
    in_remaining=true
    echo "  ── not active ──"
  fi

  # ── Full key for failure summary ──
  if [[ "$market" == "_peg" ]]; then
    full_key="${peg}::${key_suffix}"
  else
    full_key="${peg}::${market}::${key_suffix}"
  fi
  ts_short="${timestamp%%T*}"

    # ══════════════════════════════════════════════════════════════════════
    # Proxy / Aggregator checks
    # ══════════════════════════════════════════════════════════════════════
    if [[ "$item_type" == "proxy" || "$item_type" == "aggregator" ]]; then

      # For aggregator, predict the proxy address from salt
      if [[ "$item_type" == "aggregator" ]]; then
        proxy_addr=$(predict_proxy_address "$salt")
      fi

      item_failed=false
      item_failures=""
      item_passes=""

      # Check 1: Salt prediction (proxy only — aggregator has no state address to compare)
      if [[ "$item_type" == "proxy" ]] && check_enabled salt; then
        predicted_addr=$(predict_proxy_address "$salt")
        if [[ "${proxy_addr,,}" != "${predicted_addr,,}" ]]; then
          item_failures+="      Address/salt mismatch"$'\n'
          item_failures+="         State address:      $proxy_addr"$'\n'
          item_failures+="         Predicted from salt: $predicted_addr"$'\n'
          item_failed=true
        else
          item_passes+="      ✓ Salt prediction matches"$'\n'
        fi
      fi

      # Check 2: Has deployed code
      if check_enabled code; then
        if ! has_code "$proxy_addr"; then
          item_failures+="      No code at address $proxy_addr"$'\n'
          item_failed=true
        else
          item_passes+="      ✓ Has deployed code"$'\n'
        fi
      fi

      # Check 3: Has ERC1967 implementation slot (UUPS proxy)
      if check_enabled uups; then
        if ! is_uups_proxy "$proxy_addr"; then
          item_failures+="      No ERC1967 implementation slot - not a UUPS proxy"$'\n'
          item_failed=true
        else
          item_passes+="      ✓ Has ERC1967 implementation slot (UUPS)"$'\n'
        fi
      fi

      # Check 4: Owner is expected address
      if check_enabled owner; then
        actual_owner=$(get_owner "$proxy_addr")
        if [[ -z "$actual_owner" ]]; then
          item_failures+="      Failed to read owner()"$'\n'
          item_failed=true
        elif [[ "${actual_owner,,}" != "${EXPECTED_OWNER,,}" ]]; then
          item_failures+="      Owner mismatch"$'\n'
          item_failures+="         Expected: $EXPECTED_OWNER"$'\n'
          item_failures+="         Actual:   $actual_owner"$'\n'
          item_failed=true
        else
          item_passes+="      ✓ Owner is treasury ($EXPECTED_OWNER)"$'\n'
        fi
      fi

      # Check 5: ERC1967 implementation matches state (proxy only)
      if [[ "$item_type" == "proxy" ]] && check_enabled implementation; then
        actual_impl=$(get_erc1967_implementation "$proxy_addr")
        if [[ -z "$actual_impl" ]]; then
          item_failures+="      Failed to read ERC1967 implementation slot"$'\n'
          item_failed=true
        elif [[ "${actual_impl,,}" != "${impl_addr,,}" ]]; then
          actual_contract_type=$(get_implementation_info "$STATE_FILE" "$actual_impl" contractType)
          item_failures+="      Implementation mismatch"$'\n'
          item_failures+="         Expected: $impl_addr ($contract_type)"$'\n'
          item_failures+="         Actual:   $actual_impl ($actual_contract_type)"$'\n'
          item_failed=true
          if [[ "$UPDATE" == true && "$actual_contract_type" != "-" ]]; then
            pending_updates+=("${full_key}|${actual_impl}|${actual_contract_type}")
          fi
        else
          item_passes+="      ✓ Implementation matches state ($actual_impl)"$'\n'
        fi
      fi

      # Check 6: Implementation is NOT the UUPSProxyDeployStub
      if check_enabled stub; then
        stub_target="$impl_addr"
        if [[ "$item_type" == "aggregator" ]]; then
          stub_target=$(get_erc1967_implementation "$proxy_addr" 2>/dev/null || echo "")
        fi
        if [[ -n "$stub_target" && "$stub_target" != "-" ]] && is_uups_stub "$stub_target"; then
          item_failures+="      Implementation is still UUPSProxyDeployStub (upgrade not completed)"$'\n'
          item_failed=true
        else
          item_passes+="      ✓ Implementation is not UUPSProxyDeployStub"$'\n'
        fi
      fi

      # ── Output ──
      if [[ "$VERBOSE" == true ]]; then
        echo "  ── $key_suffix ──────────────────────────────────"
        if [[ "$item_type" == "aggregator" ]]; then
          echo "    Address:  $proxy_addr (predicted from salt)"
          echo "    Salt:     $salt"
        else
          echo "    Proxy:          $proxy_addr"
          echo "    Salt:           $salt"
          echo "    Implementation: $impl_addr ($contract_type)"
          echo "    Deployed:       $timestamp"
        fi
        printf "%s" "$item_passes"
        printf "%s" "$item_failures"
        if [[ "$item_failed" == true ]]; then
          echo "    ❌ FAILED"
        else
          echo "    ✅ PASSED"
        fi
      else
        if [[ "$item_type" == "aggregator" ]]; then
          if [[ "$item_failed" == true ]]; then
            echo "  ❌ FAILED ─ $proxy_addr ─ $key_suffix"
          else
            echo "  ✅ PASSED ─ $proxy_addr ─ $key_suffix"
          fi
        else
          if [[ "$item_failed" == true ]]; then
            echo "  ❌ FAILED ─ $proxy_addr ─ $key_suffix ─ $contract_type ─ $ts_short"
          else
            echo "  ✅ PASSED ─ $proxy_addr ─ $key_suffix ─ $contract_type ─ $ts_short"
          fi
        fi
        if [[ "$item_failed" == true ]]; then
          printf "%s" "$item_failures"
        fi
      fi

      if [[ "$item_failed" == true ]]; then
        ((++failed))
        failure_summary+="  FAILED $full_key ($contract_type)"$'\n'
        failure_summary+="$item_failures"
      else
        ((++passed))
      fi

    # ══════════════════════════════════════════════════════════════════════
    # Remaining implementation (not active) — code check only
    # ══════════════════════════════════════════════════════════════════════
    else
      impl_has_code=true
      if check_enabled code && ! has_code "$impl_addr"; then
        impl_has_code=false
      fi

      if [[ "$VERBOSE" == true ]]; then
        echo "  ── $key_suffix ──────────────────────────────────"
        echo "    Implementation: $impl_addr ($contract_type)"
        echo "    Deployed:       $timestamp"
        if [[ "$impl_has_code" == true ]]; then
          echo "    ✓ Has deployed code"
          echo "    ✅ PASSED"
        else
          echo "    ❌ No code at implementation address"
        fi
      else
        if [[ "$impl_has_code" == true ]]; then
          echo "  ✅ PASSED ─ $impl_addr ─ $key_suffix ─ $contract_type ─ $ts_short"
        else
          echo "  ❌ FAILED ─ $impl_addr ─ $key_suffix ─ $contract_type ─ $ts_short"
          echo "      No code at implementation address"
        fi
      fi

      if [[ "$impl_has_code" == true ]]; then
        ((++passed))
      else
        ((++failed))
        failure_summary+="  FAILED $full_key (not active) ($contract_type)"$'\n'
        failure_summary+="    No code at implementation address"$'\n'
      fi
    fi

done <<< "$sorted_items"

# ── Flush remaining pending updates ──
for upd in "${pending_updates[@]}"; do
  IFS='|' read -r upd_key upd_addr upd_type <<< "$upd"
  echo ""
  printf "  Update %s to %s (%s)? [y/N] " "$upd_key" "$upd_addr" "$upd_type" >/dev/tty
  read -n1 -r answer </dev/tty
  echo "" >/dev/tty
  if [[ "$answer" == [yY] ]]; then
    jq --arg key "$upd_key" --arg addr "$upd_addr" \
      '.proxies[$key].implementation = $addr' "$STATE_FILE" > "${STATE_FILE}.tmp" \
      && mv "${STATE_FILE}.tmp" "$STATE_FILE"
    echo "  ✅ Updated." >/dev/tty
    failed=$((failed - 1))
    passed=$((passed + 1))
  else
    echo "  Skipped." >/dev/tty
  fi
done
pending_updates=()

# ── Summary ────────────────────────────────────────────────────────────────

echo ""
echo "═══════════════════════════════════════════════════════════"
echo "  SUMMARY"
echo "═══════════════════════════════════════════════════════════"
echo "  Passed: $passed"
echo "  Failed: $failed"
echo ""

if [[ "$failed" -gt 0 ]]; then
  echo "Failing items:"
  echo ""
  printf "%s" "$failure_summary"
  echo ""
  echo "❌ VALIDATION FAILED ($failed failures)"
  exit 1
else
  echo "✅ ALL CHECKS PASSED"
  exit 0
fi
