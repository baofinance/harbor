#!/usr/bin/env bash
#
# Read minter config and format as JSON matching deployment file format
#
# Usage: ./minter-config <address> [--network NETWORK]
#

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: minter-config ADDRESS [OPTIONS]

Arguments:
  ADDRESS           Minter contract address

Options:
  --network NETWORK   Network/RPC URL (default: mainnet)
  -h, --help          Show this help

Examples:
  ./minter-config 0x33e32ff4d0677862fa31582CC654a25b9b1e4888
  ./minter-config 0x33e32ff4d0677862fa31582CC654a25b9b1e4888 --network local
USAGE
}

ADDRESS=""
NETWORK="mainnet"

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --network)
      NETWORK="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "Error: Unknown option: $1" >&2
      usage
      exit 1
      ;;
    *)
      if [[ -z "$ADDRESS" ]]; then
        ADDRESS="$1"
      else
        echo "Error: Unexpected argument: $1" >&2
        usage
        exit 1
      fi
      shift
      ;;
  esac
done

if [[ -z "$ADDRESS" ]]; then
  echo "Error: Address required" >&2
  usage
  exit 1
fi

# Call the contract
RAW=$(cast call --rpc-url "$NETWORK" "$ADDRESS" 'config()(((uint256[],int256[]),(uint256[],int256[]),(uint256[],int256[]),(uint256[],int256[])))' 2>/dev/null)

if [[ -z "$RAW" ]]; then
  echo "Error: Failed to call config() on $ADDRESS" >&2
  exit 1
fi

# Parse the output using a Python script for reliable parsing
python3 <<PYTHON
import re
import json

raw = '''$RAW'''

# Extract tuples - the format is nested with arrays
# Pattern: ([bounds], [ratios])
# The output looks like:
# (([b1, b2], [r1, r2, r3]), ([b1, b2, b3, b4], [r1, r2, r3, r4, r5]), ...)

def parse_number(s):
    """Parse a number, handling scientific notation and negative numbers"""
    s = s.strip()
    # Remove the [scientific] suffix if present
    if '[' in s:
        s = s.split('[')[0].strip()
    return int(s)

def format_number(n):
    """Format as scientific notation like deployment files"""
    if n == 0:
        return 0
    # Use scientific notation
    exp = 0
    val = abs(n)
    while val >= 10:
        val /= 10
        exp += 1
    while val < 1 and val > 0:
        val *= 10
        exp -= 1

    # Simplify: just return the value with E notation
    if n == 0:
        return 0

    # Find the exponent
    s = f"{n:.0f}"
    if n > 0:
        # Count trailing zeros for positive
        zeros = len(s) - len(s.rstrip('0'))
        if zeros > 0:
            mantissa = float(s.rstrip('0') or '0')
            return f"{mantissa}E+{zeros + len(s.rstrip('0')) - 1}" if mantissa != int(mantissa) else f"{int(mantissa)}E+{zeros + len(s.rstrip('0')) - 1}"

    # Just return as number for simplicity, let jq handle formatting
    return n

def extract_arrays(s):
    """Extract all arrays from the string"""
    arrays = []
    depth = 0
    start = -1
    for i, c in enumerate(s):
        if c == '[':
            if depth == 0:
                start = i
            depth += 1
        elif c == ']':
            depth -= 1
            if depth == 0 and start >= 0:
                arrays.append(s[start+1:i])
                start = -1
    return arrays

# Extract all arrays
arrays = extract_arrays(raw)

# Should have 8 arrays: 4 pairs of (bounds, ratios)
if len(arrays) != 8:
    print(f"Error: Expected 8 arrays, got {len(arrays)}", file=__import__('sys').stderr)
    __import__('sys').exit(1)

def parse_array(s):
    """Parse comma-separated numbers"""
    if not s.strip():
        return []
    parts = s.split(',')
    return [parse_number(p) for p in parts]

# Parse into config structure
# Order from cast output: mintPegged, redeemPegged, mintLeveraged, redeemLeveraged
configs = {
    "mintPeggedIncentiveConfig": {
        "collateralRatioBandUpperBounds": parse_array(arrays[0]),
        "incentiveRatios": parse_array(arrays[1])
    },
    "redeemPeggedIncentiveConfig": {
        "collateralRatioBandUpperBounds": parse_array(arrays[2]),
        "incentiveRatios": parse_array(arrays[3])
    },
    "mintLeveragedIncentiveConfig": {
        "collateralRatioBandUpperBounds": parse_array(arrays[4]),
        "incentiveRatios": parse_array(arrays[5])
    },
    "redeemLeveragedIncentiveConfig": {
        "collateralRatioBandUpperBounds": parse_array(arrays[6]),
        "incentiveRatios": parse_array(arrays[7])
    }
}

# Custom encoder to format large numbers in scientific notation
class SciEncoder(json.JSONEncoder):
    def encode(self, o):
        if isinstance(o, dict):
            items = []
            for k, v in o.items():
                items.append(f'{json.dumps(k)}: {self.encode(v)}')
            return '{' + ', '.join(items) + '}'
        elif isinstance(o, list):
            return '[' + ', '.join(self.encode(x) for x in o) + ']'
        elif isinstance(o, int) and o != 0:
            # Format as scientific notation
            s = str(abs(o))
            exp = len(s) - 1
            mantissa = o / (10 ** exp)
            if mantissa == int(mantissa):
                mantissa = int(mantissa)
            sign = '' if o > 0 else '-'
            return f'{sign}{mantissa}E+{exp}' if exp > 0 else str(o)
        else:
            return json.dumps(o)

# Pretty print with indentation
def format_sci(n, scale=16):
    """Format number in scientific notation scaled to 1e{scale}, no + sign"""
    if n == 0:
        return '0'
    sign = '-' if n < 0 else ''
    val = abs(n)
    # Scale to 1e{scale} base
    mantissa = val / (10 ** scale)
    if mantissa == int(mantissa):
        mantissa = int(mantissa)
    return f'{sign}{mantissa}e{scale}'

def pretty_print(obj, indent=0):
    sp = '  '
    if isinstance(obj, dict):
        print('{')
        items = list(obj.items())
        for i, (k, v) in enumerate(items):
            print(f'{sp * (indent + 1)}"{k}": ', end='')
            pretty_print(v, indent + 1)
            print(',' if i < len(items) - 1 else '')
        print(f'{sp * indent}}}', end='')
    elif isinstance(obj, list):
        print('[')
        for i, item in enumerate(obj):
            print(f'{sp * (indent + 1)}', end='')
            if isinstance(item, int) and item != 0:
                print(format_sci(item), end='')
            else:
                print(item, end='')
            print(',' if i < len(obj) - 1 else '')
        print(f'{sp * indent}]', end='')
    else:
        print(obj, end='')

pretty_print(configs)
print()
PYTHON
