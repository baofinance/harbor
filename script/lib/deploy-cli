# Minimal CLI helpers for Harbor deployment scripts
#
# Source: source "$(dirname "$0")/lib/deploy-cli"
#
# On source: validates project root (fails fast if wrong directory)
# Provides:
#   - parse_deploy_args "$@"      → sets NETWORK, SALT, ACCOUNT, USE_LOCAL
#   - init_rpc NETWORK USE_LOCAL  → sets RPC_URL, CHAIN_ID
#   - init_signer USE_LOCAL ACCOUNT → sets SIGNER_ARGS array
#   - init_forge_args             → sets FORGE_ARGS array (call after init_rpc/init_signer)

set -euo pipefail

# Fail fast if not in project root
[[ -f "foundry.toml" ]] || {
  echo "❌ Run from project root" >&2
  exit 1
}

# Common argument parsing for deployment scripts
# Sets: NETWORK, SALT, ACCOUNT, USE_LOCAL, PEG
NETWORK=""
SALT=""
USE_LOCAL=false
FORGE_ARGS=()
ACCOUNT=""
PEG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --network)
      NETWORK=$2
      shift 2
      ;;
    --salt)
      SALT=$2
      shift 2
      ;;
    --account)
      ACCOUNT=$2
      shift 2
      ;;
    --local)
      USE_LOCAL=true
      shift
      ;;
    --peg)
      PEG=$2
      shift 2
      ;;
    --resume)
      FORGE_ARGS+=(--resume)
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      echo "Unexpected argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

[[ -n "$NETWORK" ]] || {
  echo "❌ --network required" >&2
  exit 1
}
[[ -n "$SALT" ]] || {
  echo "❌ --salt required" >&2
  exit 1
}
[[ "$USE_LOCAL" == true || -n "$ACCOUNT" ]] || {
  echo "❌ --account required (or use --local)" >&2
  exit 1
}

if [[ "$USE_LOCAL" == true ]]; then
  RPC_URL="local"
else
  RPC_URL=$NETWORK
fi
CHAIN_ID=$(cast chain-id --rpc-url "$RPC_URL" 2>/dev/null) || {
  echo "❌ RPC failed: $RPC_URL" >&2
  exit 1
}
FORGE_ARGS+=(--rpc-url "$RPC_URL")

if [[ "$USE_LOCAL" == true && -n "$ACCOUNT" ]]; then
  # Use provided account with anvil's auto-impersonate
  FORGE_ARGS+=(--account "$ACCOUNT" --unlocked)
elif [[ "$USE_LOCAL" == true ]]; then
  # Anvil's first account private key (fallback)
  FORGE_ARGS+=(--private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80)
elif [[ -n "$ACCOUNT" ]]; then
  FORGE_ARGS+=(--account "$ACCOUNT")
fi

FORGE_ARGS+=(--broadcast --slow) # leaving out the --slow arg means it is unreliable
[[ "$USE_LOCAL" == true ]] || FORGE_ARGS+=(--verify)
