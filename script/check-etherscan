#!/usr/bin/env bash
set -euo pipefail

# Generate Etherscan verification report for Harbor minter deployments
#
# This script reads the state file and generates a markdown report with
# Etherscan verification status and links for all proxies and remaining
# implementations (those not currently used by any proxy).
#
# With --update (the default) it reads the previous report and asks Etherscan
# only about what that report does not show verified. Verification on
# Etherscan is permanent, so a ✓ stays true; a ✗ is asked again. With --all it
# asks about everything. The report is written to a .pending file, which
# replaces the report only when the whole run succeeds.

# ── Constants ──────────────────────────────────────────────────────────────

CAST=cast

# What Etherscan's getabi answers, with status "0", for an address with no
# verified source; getsourcecode gives it, with status "1", as the ABI.
NOT_VERIFIED="Contract source code not verified"

# The start of what Etherscan answers, with status "0", to a request over the
# key's calls per second. Such a request is asked again a second later, up to
# ETHERSCAN_ATTEMPTS times in all.
RATE_LIMITED="Max calls per sec rate limit reached"
ETHERSCAN_ATTEMPTS=5

# ── Shared variables ───────────────────────────────────────────────────────

CHAIN_ID=""
STATE_FILE=""
RPC_URL=""
NETWORK=""

# ── Library functions ──────────────────────────────────────────────────────

# Get all proxy keys (e.g., "BTC::fxUSD::minter", "EUR::pegged")
get_proxy_keys() {
  local state_file=$1
  jq -r '.proxies | keys[]' "$state_file" 2>/dev/null || echo ""
}

# Get all implementation addresses
get_implementation_addresses() {
  local state_file=$1
  jq -r '.implementations | keys[]' "$state_file" 2>/dev/null | sort || echo ""
}

# Get implementation info by address
get_implementation_info() {
  local state_file=$1
  local addr=$2
  local field=$3
  jq -r --arg addr "$addr" --arg field "$field" '.implementations[$addr][$field] // "-"' "$state_file"
}

# Get proxy info by key
get_proxy_info() {
  local state_file=$1
  local key=$2
  local field=$3
  jq -r --arg key "$key" --arg field "$field" '.proxies[$key][$field] // "-"' "$state_file"
}

check_project_root() {
  if [[ ! -f "foundry.toml" ]] || [[ ! -d "src" ]]; then
    echo "❌ Must be run from the project root (missing foundry.toml or src/)" >&2
    exit 1
  fi
}

# ── Usage ──────────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
Usage:
  $0 --network <network> --salt <salt> [--update | --all]

Required:
  --network     Network name (mainnet, arbitrum, base)
  --salt        Salt prefix (e.g., harbor_v1, test3)

Optional:
  --update      Ask Etherscan only about what the previous report does not
                show verified (the default). Without a previous report,
                ask about everything.
  --all         Ask Etherscan about everything.

Examples:
  $0 --network mainnet --salt harbor_v1
  $0 --network mainnet --salt harbor_v1 --all

State file: deployments/<network>/<salt>.state.json
Output:     deployments/<network>/<salt>.state.md
EOF
}

# ── Argument parsing ───────────────────────────────────────────────────────

NETWORK=""
SALT=""
MODE=update

while [[ $# -gt 0 ]]; do
  case "$1" in
    --network)
      NETWORK=${2:-}
      shift 2
      ;;
    --salt)
      SALT=${2:-}
      shift 2
      ;;
    --update | --all)
      MODE=${1#--}
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "❌ Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      echo "❌ Unexpected argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

# ── Validation ─────────────────────────────────────────────────────────────

check_project_root

if [[ -z "$NETWORK" ]]; then
  echo "❌ Missing --network" >&2
  usage >&2
  exit 1
fi

if [[ -z "$SALT" ]]; then
  echo "❌ Missing --salt" >&2
  usage >&2
  exit 1
fi

# ── Initialize ─────────────────────────────────────────────────────────────

RPC_URL="$NETWORK"
STATE_FILE="deployments/${NETWORK}/${SALT}.state.json"

if ! CHAIN_ID=$("$CAST" chain-id --rpc-url "$RPC_URL" 2>&1); then
  echo "❌ Failed to fetch chainId from RPC '$RPC_URL'" >&2
  echo "   $CHAIN_ID" >&2
  exit 1
fi

STATE_FILE="deployments/${NETWORK}/${SALT}.state.json"
if [[ ! -f "$STATE_FILE" ]]; then
  echo "❌ State file not found: $STATE_FILE" >&2
  exit 1
fi

# Validate network matches
state_network=$(jq -r '.network // empty' "$STATE_FILE")
if [[ -n "$state_network" && "$state_network" != "$NETWORK" ]]; then
  echo "❌ State file network mismatch: $state_network (expected $NETWORK)" >&2
  exit 1
fi

ETHERSCAN_API_KEY=$(forge config --json 2>/dev/null | jq -r '.etherscan_api_key // empty')

OUTPUT_FILE="${STATE_FILE%.json}.md"
PENDING_FILE="${OUTPUT_FILE}.pending"
if [[ -f "$PENDING_FILE" ]]; then
  echo "  Report: cleaning up stale .pending from prior run" >&2
  rm -f "$PENDING_FILE"
fi
trap 'if [[ -f "$PENDING_FILE" ]]; then echo "  Report: .pending left for debugging at $PENDING_FILE" >&2; fi' EXIT

case "$NETWORK" in
  mainnet) EXPLORER_URL="https://etherscan.io" ;;
  arbitrum) EXPLORER_URL="https://arbiscan.io" ;;
  base) EXPLORER_URL="https://basescan.org" ;;
  *) EXPLORER_URL="https://etherscan.io" ;;
esac

# ── Helper functions ───────────────────────────────────────────────────────

# Ask Etherscan's contract API `action` about `address`, and print the reply.
# A rate-limit reply is asked again a second later. Exits when the request
# fails, when the reply is not JSON with a status, and when its status is not
# "1" and its result is not the "not verified" answer.
etherscan_contract() {
  local action=$1
  local address=$2

  local attempt response status result
  for ((attempt = 1; ; attempt++)); do
    if ! response=$(curl -sS "https://api.etherscan.io/v2/api?chainid=${CHAIN_ID}&module=contract&action=${action}&address=${address}&apikey=${ETHERSCAN_API_KEY}"); then
      echo "❌ Etherscan $action $address: the request failed" >&2
      exit 1
    fi
    if ! status=$(jq -er '.status' <<<"$response"); then
      echo "❌ Etherscan $action $address: the reply is not JSON with a status: $response" >&2
      exit 1
    fi
    if [[ "$status" == "1" ]]; then
      break
    fi
    result=$(jq -r '.result' <<<"$response")
    if [[ "$result" == "$NOT_VERIFIED" ]]; then
      break
    fi
    if [[ "$result" != "$RATE_LIMITED"* ]]; then
      echo "❌ Etherscan $action $address: status $status: $result" >&2
      exit 1
    fi
    if [[ $attempt -eq $ETHERSCAN_ATTEMPTS ]]; then
      echo "❌ Etherscan $action $address: status $status: $result, on each of $ETHERSCAN_ATTEMPTS attempts" >&2
      exit 1
    fi
    sleep 1
  done
  echo "$response"
}

# Check proxy verification status on Etherscan
# Returns: source_verified|impl_linked|proxy_flag (1 or 0 for each)
check_proxy_etherscan() {
  local address=$1

  local abi_response abi_status source_ok
  abi_response=$(etherscan_contract getabi "$address") || exit 1
  abi_status=$(jq -r '.status' <<<"$abi_response")
  if [[ "$abi_status" == "1" ]]; then source_ok=1; else source_ok=0; fi

  local src_response results
  src_response=$(etherscan_contract getsourcecode "$address") || exit 1
  results=$(jq -r '.result | if type == "array" then "\(length) results" else "a \(type)" end' <<<"$src_response")
  if [[ "$results" != "1 results" ]]; then
    echo "❌ Etherscan getsourcecode $address: expected 1 result, the reply holds $results" >&2
    exit 1
  fi

  local implementation impl_ok
  implementation=$(jq -r '.result[0].Implementation' <<<"$src_response")
  if [[ -n "$implementation" && "$implementation" != "null" && "$implementation" != "" ]]; then
    impl_ok=1
  else
    impl_ok=0
  fi

  local proxy_flag proxy_ok
  proxy_flag=$(echo "$src_response" | jq -r '.result[0].Proxy')
  if [[ "$proxy_flag" == "1" ]]; then proxy_ok=1; else proxy_ok=0; fi

  echo "${source_ok}|${impl_ok}|${proxy_ok}"
}

# Check implementation verification status: from the previous report when it
# shows the implementation verified, from Etherscan otherwise
# Returns: 1 if verified, 0 if not
check_impl_etherscan() {
  local address=$1

  if [[ -n "${verified_impls[${address,,}]:-}" ]]; then
    echo "1"
    return
  fi
  local response status
  response=$(etherscan_contract getabi "$address") || exit 1
  status=$(jq -r '.status' <<<"$response")
  if [[ "$status" == "1" ]]; then echo "1"; else echo "0"; fi
}

# ── Main ───────────────────────────────────────────────────────────────────

echo ""
echo "═══════════════════════════════════════════════════════════"
echo "  ETHERSCAN VERIFICATION REPORT"
echo "  Network: $NETWORK (chainId: $CHAIN_ID)"
echo "  State:   $STATE_FILE"
echo "  Report:  $OUTPUT_FILE"
echo "═══════════════════════════════════════════════════════════"
echo ""

# Get keys for use in report generation
proxy_keys=$(get_proxy_keys "$STATE_FILE")
impl_addrs=$(get_implementation_addresses "$STATE_FILE")

# Build set of implementations currently used by proxies
declare -A used_impls
for key in $proxy_keys; do
  impl=$(get_proxy_info "$STATE_FILE" "$key" implementation)
  if [[ -n "$impl" && "$impl" != "-" ]]; then
    used_impls["${impl,,}"]=1
  fi
done

# ── Previous report ────────────────────────────────────────────────────────
# With --update, the ✓ marks of the previous report are carried into the new
# one without asking Etherscan again. A proxy's three columns are carried when
# all three were ✓ for the same proxy and implementation; Impl Verified is
# carried by implementation, from either table.

declare -A verified_proxies # "proxy|implementation" → 1
declare -A verified_impls   # implementation → 1
if [[ "$MODE" == update && -f "$OUTPUT_FILE" ]]; then
  while IFS= read -r line; do
    if [[ "$line" != "| ["* ]]; then
      continue
    fi
    mapfile -t addresses < <(grep -oE '0x[0-9a-fA-F]{40}' <<<"$line")
    mapfile -t marks < <(grep -oE '\[(✓|✗)\]' <<<"$line")
    if [[ ${#marks[@]} -eq 4 && ${#addresses[@]} -eq 5 ]]; then
      # Role, Source, Impl Linked and Proxy Flag link the proxy; Impl Verified links the implementation.
      if [[ "${marks[0]}${marks[1]}${marks[2]}" == "[✓][✓][✓]" ]]; then
        pair="${addresses[0],,}|${addresses[4],,}"
        verified_proxies["$pair"]=1
      fi
      if [[ "${marks[3]}" == "[✓]" ]]; then
        verified_impls["${addresses[4],,}"]=1
      fi
    elif [[ ${#marks[@]} -eq 1 && ${#addresses[@]} -eq 2 ]]; then
      # A remaining implementation: Role and Verified both link it.
      if [[ "${marks[0]}" == "[✓]" ]]; then
        verified_impls["${addresses[1],,}"]=1
      fi
    elif [[ ${#marks[@]} -ne 0 || "$line" != *"| - | - | - | - |" ]]; then
      echo "❌ Cannot read this row of $OUTPUT_FILE (${#marks[@]} marks, ${#addresses[@]} addresses):" >&2
      echo "   $line" >&2
      exit 1
    fi
  done <"$OUTPUT_FILE"
fi

# ── Generate Etherscan Report ──────────────────────────────────────────────

echo "Generating Etherscan verification report..."
updated=$(date -u '+%Y-%m-%d %H:%M:%S UTC')

{
  echo "# Harbor Minter Verification Report"
  echo ""
  echo "- **Network:** $NETWORK (chainId: $CHAIN_ID)"
  echo "- **Salt:** $SALT"
  echo "- **Updated:** $updated"
  echo "- **State file:** $STATE_FILE"
  echo ""
  echo "## Verification Legend"
  echo ""
  echo "- **Source**: Proxy source code verified (links to code page)"
  echo "- **Impl Linked**: Implementation address linked on Etherscan (links to proxy checker)"
  echo "- **Proxy Flag**: Marked as proxy on Etherscan (links to proxy checker)"
  echo "- **Impl Verified**: Implementation source code verified (links to code page)"
  echo ""

  echo "## Proxies"
  echo ""
  echo "| Role | Source | Impl Linked | Proxy Flag | Impl Verified |"
  echo "|------|--------|-------------|------------|---------------|"

  for key in $proxy_keys; do
    proxy_addr=$(get_proxy_info "$STATE_FILE" "$key" address)
    expected_impl=$(get_proxy_info "$STATE_FILE" "$key" implementation)

    if [[ -n "$expected_impl" && "$expected_impl" != "-" ]]; then
      pair="${proxy_addr,,}|${expected_impl,,}"
      if [[ -n "${verified_proxies[$pair]:-}" ]]; then
        proxy_status="1|1|1"
      else
        proxy_status=$(check_proxy_etherscan "$proxy_addr") || exit 1
      fi
      IFS='|' read -r src_ok impl_ok proxy_ok <<<"$proxy_status"
      impl_verified=$(check_impl_etherscan "$expected_impl") || exit 1

      # Build linked ticks
      proxy_code_url="$EXPLORER_URL/address/$proxy_addr#code"
      proxy_checker_url="$EXPLORER_URL/proxyContractChecker?a=$proxy_addr"
      impl_code_url="$EXPLORER_URL/address/$expected_impl#code"

      if [[ "$src_ok" == "1" ]]; then src_tick="[✓]($proxy_code_url)"; else src_tick="[✗]($proxy_code_url)"; fi
      if [[ "$impl_ok" == "1" ]]; then impl_tick="[✓]($proxy_checker_url)"; else impl_tick="[✗]($proxy_checker_url)"; fi
      if [[ "$proxy_ok" == "1" ]]; then proxy_tick="[✓]($proxy_checker_url)"; else proxy_tick="[✗]($proxy_checker_url)"; fi
      if [[ "$impl_verified" == "1" ]]; then impl_v_tick="[✓]($impl_code_url)"; else impl_v_tick="[✗]($impl_code_url)"; fi

      echo "| [$key]($proxy_code_url) | $src_tick | $impl_tick | $proxy_tick | $impl_v_tick |"
    else
      proxy_code_url="$EXPLORER_URL/address/$proxy_addr#code"
      echo "| [$key]($proxy_code_url) | - | - | - | - |"
    fi
  done

  # Find remaining implementations (not used by any proxy)
  remaining_impls=()
  for addr in $impl_addrs; do
    if [[ -z "${used_impls[${addr,,}]:-}" ]]; then
      remaining_impls+=("$addr")
    fi
  done

  if [[ ${#remaining_impls[@]} -gt 0 ]]; then
    echo ""
    echo "## Remaining Implementations"
    echo ""
    echo "These implementations are recorded in the state file but are not currently"
    echo "used by any proxy (e.g., previous versions after upgrade, or implementations"
    echo "awaiting proxy deployment)."
    echo ""
    echo "| Role | Contract | Verified |"
    echo "|------|----------|----------|"

    for addr in "${remaining_impls[@]}"; do
      role=$(get_implementation_info "$STATE_FILE" "$addr" proxy)
      contract_type=$(get_implementation_info "$STATE_FILE" "$addr" contractType)
      impl_verified=$(check_impl_etherscan "$addr") || exit 1
      impl_code_url="$EXPLORER_URL/address/$addr#code"
      if [[ "$impl_verified" == "1" ]]; then impl_tick="[✓]($impl_code_url)"; else impl_tick="[✗]($impl_code_url)"; fi
      echo "| [$role]($impl_code_url) | $contract_type | $impl_tick |"
    done
  fi

} >"$PENDING_FILE"

mv "$PENDING_FILE" "$OUTPUT_FILE"
echo "📄 Report written to: $OUTPUT_FILE"
echo ""
