#!/usr/bin/env bash
#
# Generate a markdown file with Etherscan links for deployed contracts
#
# Reads: harbor_v1*.logs/mainnet/latest.json (relative to script directory)
# Outputs: etherscan-links.md (in script directory)
#
# Options:
#   --etherscan-api-key KEY   Check verification status via Etherscan API
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ETHERSCAN_API_KEY=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --etherscan-api-key)
      ETHERSCAN_API_KEY="$2"
      shift 2
      ;;
    *)
      echo "Error: Unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

# Check proxy verification status - returns three status indicators:
# 1. Proxy source verified (getabi returns status 1)
# 2. Implementation readable (getsourcecode has non-empty Implementation)
# 3. Proxy flag set (getsourcecode has Proxy == "1")
check_proxy_status() {
  local address="$1"
  if [[ -z "$ETHERSCAN_API_KEY" ]]; then
    echo ""
    return
  fi

  # Check proxy source verification
  local abi_response
  abi_response=$(curl -s "https://api.etherscan.io/v2/api?chainid=1&module=contract&action=getabi&address=${address}&apikey=${ETHERSCAN_API_KEY}")
  local abi_status
  abi_status=$(echo "$abi_response" | jq -r '.status')

  local source_tick
  if [[ "$abi_status" == "1" ]]; then
    source_tick="✓"
  else
    source_tick="✗"
  fi

  # Check getsourcecode for Implementation and Proxy fields
  local src_response
  src_response=$(curl -s "https://api.etherscan.io/v2/api?chainid=1&module=contract&action=getsourcecode&address=${address}&apikey=${ETHERSCAN_API_KEY}")

  local result_count
  result_count=$(echo "$src_response" | jq '.result | length')

  if [[ "$result_count" != "1" ]]; then
    echo " ${source_tick}⚠⚠"
    return
  fi

  local implementation
  implementation=$(echo "$src_response" | jq -r '.result[0].Implementation')
  local impl_tick
  if [[ -n "$implementation" && "$implementation" != "null" && "$implementation" != "" ]]; then
    impl_tick="✓"
  else
    impl_tick="✗"
  fi

  local proxy_flag
  proxy_flag=$(echo "$src_response" | jq -r '.result[0].Proxy')
  local proxy_tick
  if [[ "$proxy_flag" == "1" ]]; then
    proxy_tick="✓"
  else
    proxy_tick="✗"
  fi

  echo " ${source_tick}${impl_tick}${proxy_tick}"
}

# Check implementation source verification - returns "✓" if verified, "✗" if not
check_impl_status() {
  local address="$1"
  if [[ -z "$ETHERSCAN_API_KEY" ]]; then
    echo ""
    return
  fi

  local response
  response=$(curl -s "https://api.etherscan.io/v2/api?chainid=1&module=contract&action=getabi&address=${address}&apikey=${ETHERSCAN_API_KEY}")

  local status
  status=$(echo "$response" | jq -r '.status')

  if [[ "$status" == "1" ]]; then
    echo " ✓"
  else
    echo " ✗"
  fi
}

OUTPUT_FILE="${SCRIPT_DIR}/etherscan-links.md"

{
  echo "# Harbor Deployment Addresses"
  echo ""
  echo "Generated: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
  echo ""

  for src in "${SCRIPT_DIR}"/harbor_v1*.logs/mainnet/latest.json; do
    [[ -f "$src" ]] || continue

    # Extract base name (e.g., harbor_v1::BTC from harbor_v1::BTC.logs)
    logs_dir=$(basename "$(dirname "$(dirname "$src")")")
    base_name="${logs_dir%.logs}"

    echo "## ${base_name}"
    echo ""

    # Extract all contract addresses using jq, including implementation if present
    jq -r '.contracts | to_entries[] | select(.value.address != null) | "\(.key)\t\(.value.address)\t\(.value.implementation.address // "")\t\(.value.implementation.contractType // "")"' "$src" | while IFS=$'\t' read -r contract_name address impl_address impl_type; do
      if [[ -n "$impl_address" ]]; then
        # Proxy contract with implementation
        proxy_status=$(check_proxy_status "$address")
        impl_status=$(check_impl_status "$impl_address")
        echo "- [${base_name} ${contract_name}](https://etherscan.io/address/${address}#code)"
        echo "  - [[verify proxy](https://etherscan.io/proxyContractChecker?a=${address})]${proxy_status} [[${impl_type}](https://etherscan.io/address/${impl_address}#code)]${impl_status}"
      else
        # Non-proxy contract
        echo "- [${base_name} ${contract_name}](https://etherscan.io/address/${address}#code)"
      fi
    done

    echo ""
  done
} >"$OUTPUT_FILE"

echo "Generated: $OUTPUT_FILE"
