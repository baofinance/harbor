pragma solidity >=0.8.28 <0.9.0;

import {Deployment} from "@bao-script/deployment/Deployment.sol";
import {MintableBurnableERC20_v1} from "@bao/MintableBurnableERC20_v1.sol";
import {HarborKeys} from "@harbor-script/deployment/HarborKeys.sol";

/**
 * @title PeggedTokenDeployer
 * @notice Library for deploying pegged token (baoUSD)
 */
library PeggedTokenDeployer {
    /**
     * @notice Deploy MintableBurnableERC20 pegged token from config
     * @param deployment The deployment registry
     * @param admin Admin address
     * @param name Token name
     * @param symbol Token symbol
     * @return Address of deployed pegged token proxy
     */
    function deploy(
        Deployment deployment,
        address admin,
        string memory name,
        string memory symbol
    ) external returns (address) {
        MintableBurnableERC20_v1 impl = new MintableBurnableERC20_v1();

        return
            deployment.deployProxy(
                HarborKeys.PEGGED,
                address(impl),
                abi.encodeCall(MintableBurnableERC20_v1.initialize, (admin, name, symbol)),
                "pegged-v1"
            );
    }
}
