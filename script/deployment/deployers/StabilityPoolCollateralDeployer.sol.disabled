// SPDX-License-Identifier: MIT
pragma solidity >=0.8.28 <0.9.0;

import {Deployment} from "@bao-script/deployment/Deployment.sol";
import {BaseStabilityPoolDeployer} from "@harbor-script/deployment/deployers/BaseStabilityPoolDeployer.sol";
import {HarborKeys} from "@harbor-script/deployment/HarborKeys.sol";

/**
 * @title StabilityPoolCollateralDeployer
 * @notice Library for deploying collateral stability pool
 */
library StabilityPoolCollateralDeployer {
    /**
     * @notice Deploy collateral stability pool from config
     * @param deployment The deployment registry
     * @param admin Admin address
     * @param minter Minter address
     * @param wrappedCollateral Wrapped collateral token address (used as liquidation token)
     * @param earlyWithdrawalFee Early withdrawal fee
     * @param feeReceiver Fee receiver address
     * @param rewardManager Reward manager address
     * @param rewardDepositor Reward depositor address
     * @param rebalancer Rebalancer address
     * @return Address of deployed stability pool
     */
    function deploy(
        Deployment deployment,
        address admin,
        address minter,
        address wrappedCollateral,
        uint256 earlyWithdrawalFee,
        address feeReceiver,
        address rewardManager,
        address rewardDepositor,
        address rebalancer
    ) external returns (address) {
        return
            BaseStabilityPoolDeployer.deploy(
                deployment,
                BaseStabilityPoolDeployer.DeployParams({
                    registryKey: HarborKeys.STABILITY_POOL_COLLATERAL,
                    admin: admin,
                    minter: minter,
                    wrappedCollateral: wrappedCollateral,
                    liquidationToken: wrappedCollateral, // liquidationToken = wrappedCollateral
                    earlyWithdrawalFee: earlyWithdrawalFee,
                    feeReceiver: feeReceiver,
                    rewardManager: rewardManager,
                    rewardDepositor: rewardDepositor,
                    rebalancer: rebalancer,
                    saltString: "stability-pool-collateral-v1"
                })
            );
    }
}
