// SPDX-License-Identifier: MIT
pragma solidity >=0.8.28 <0.9.0;

import {Deployment} from "@bao-script/deployment/Deployment.sol";
import {IBaoRoles} from "@bao/interfaces/IBaoRoles.sol";
import {MintableBurnableERC20_v1} from "@bao/MintableBurnableERC20_v1.sol";
import {ReservePool_v1} from "@harbor/minter/ReservePool_v1.sol";
import {Minter_v1} from "@harbor/minter/Minter_v1.sol";
import {IMinter} from "@harbor/interfaces/IMinter.sol";
import {HarborKeys} from "@harbor-script/deployment/HarborKeys.sol";

/**
 * @title MinterDeployer
 * @notice Library for deploying Minter
 * @dev Minter requires WRAPPED_COLLATERAL, PEGGED, LEVERAGED, RESERVE_POOL, FEE_RECEIVER, and ORACLE to be deployed first
 *      Note: Config_v1 library is automatically deployed and linked by Foundry
 *      For Wake tests, deploy Config_v1 manually before calling this function
 */
library MinterDeployer {
    /**
     * @notice Deploy Minter from config
     * @param deployment The deployment registry
     * @param admin Admin address
     * @param wrappedCollateral Collateral token address
     * @param pegged Pegged token address
     * @param leveraged Leveraged token address
     * @param reservePool Reserve pool address
     * @param feeReceiver Fee receiver address
     * @param oracle Oracle address
     * @return Address of deployed minter proxy
     */
    function deploy(
        Deployment deployment,
        address admin,
        address wrappedCollateral,
        address pegged,
        address leveraged,
        address reservePool,
        address feeReceiver,
        address oracle
    ) external returns (address) {
        // Minter constructor requires token addresses and burn signature
        string memory peggedBurnSig = "burnFrom(address,uint256)";
        Minter_v1 impl = new Minter_v1(wrappedCollateral, pegged, leveraged, peggedBurnSig);

        address minter = deployment.deployProxy(
            HarborKeys.MINTER,
            address(impl),
            abi.encodeCall(Minter_v1.initialize, (admin)),
            "minter-v1"
        );

        // Grant minter roles on tokens
        // Grant MINTER_ROLE and BURNER_ROLE on pegged token
        IBaoRoles(pegged).grantRoles(minter, MintableBurnableERC20_v1(pegged).MINTER_ROLE());
        IBaoRoles(pegged).grantRoles(minter, MintableBurnableERC20_v1(pegged).BURNER_ROLE());

        // Grant MINTER_ROLE and BURNER_ROLE on leveraged token
        IBaoRoles(leveraged).grantRoles(minter, MintableBurnableERC20_v1(leveraged).MINTER_ROLE());
        IBaoRoles(leveraged).grantRoles(minter, MintableBurnableERC20_v1(leveraged).BURNER_ROLE());

        // Grant REQUESTER_ROLE on reserve pool
        IBaoRoles(reservePool).grantRoles(minter, ReservePool_v1(reservePool).REQUESTER_ROLE());

        // Configure minter dependencies
        IMinter(minter).updatePriceOracle(oracle);
        IMinter(minter).updateFeeReceiver(feeReceiver);
        IMinter(minter).updateReservePool(reservePool);

        return minter;
    }
}
