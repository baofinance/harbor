pragma solidity >=0.8.28 <0.9.0;

import {Deployment} from "@bao-script/deployment/Deployment.sol";
import {ReservePool_v1} from "@harbor/minter/ReservePool_v1.sol";
import {HarborKeys} from "@harbor-script/deployment/HarborKeys.sol";

/**
 * @title ReservePoolDeployer
 * @notice Library for deploying ReservePool
 */
library ReservePoolDeployer {
    /**
     * @notice Deploy ReservePool from config
     * @param deployment The deployment registry
     * @param admin Admin address
     * @return Address of deployed reserve pool proxy
     */
    function deploy(Deployment deployment, address admin) external returns (address) {
        ReservePool_v1 impl = new ReservePool_v1();

        return
            deployment.deployProxy(
                HarborKeys.RESERVE_POOL,
                address(impl),
                abi.encodeCall(ReservePool_v1.initialize, (admin)),
                "reserve-pool-v1"
            );
    }
}
