pragma solidity >=0.8.28 <0.9.0;

import {Deployment} from "@bao-script/deployment/Deployment.sol";
import {IBaoRoles} from "@bao/interfaces/IBaoRoles.sol";
import {Genesis_v1} from "@harbor/minter/Genesis_v1.sol";
import {Minter_v1} from "@harbor/minter/Minter_v1.sol";
import {HarborKeys} from "@harbor-script/deployment/HarborKeys.sol";

/**
 * @title GenesisDeployer
 * @notice Library for deploying Genesis contract
 */
library GenesisDeployer {
    /**
     * @notice Deploy Genesis contract from config
     * @param deployment The deployment registry
     * @param admin Admin address
     * @param minter Minter address
     * @return Address of deployed genesis proxy
     */
    function deploy(Deployment deployment, address admin, address minter) external returns (address) {
        // Genesis constructor requires minter address
        Genesis_v1 impl = new Genesis_v1(minter);

        address genesis = deployment.deployProxy(
            HarborKeys.GENESIS,
            address(impl),
            abi.encodeCall(Genesis_v1.initialize, (admin)),
            "genesis-v1"
        );

        // Grant ZERO_FEE_ROLE on minter to genesis
        IBaoRoles(minter).grantRoles(genesis, Minter_v1(minter).ZERO_FEE_ROLE());

        return genesis;
    }
}
