#!/usr/bin/env bash
# Check, before the Minter v2 -> v3 upgrade, that every deployed market upgrades: each market is upgraded on a mainnet
# fork by the function the upgrade script runs, which loads each minter's stored incentive config through the v3 loader.
# Every config must be accepted and read back unchanged, and no minter may halt once upgraded - its recorded backing
# covered by its wrapped holding at the low edge of the rate band. Read-only, on a fork at the capture's block.
#
# The capture is a REQUIRED argument: the upgrade migrates each pool's holders from it, and the block comes from its
# manifest, so the run measures chain state at the block its holder list was scanned to.
#
# Fails unless the preflight's tests actually ran - see script/verify/run-campaign-test.
#
# Usage:
#   script/verify/minter-v3-upgrade/run-preflight --holders-dir <capture>
#
# Produce a capture first with:
#   script/holders/capture-holders --to-block <block>
#
# Needs MAINNET_RPC_URL, archival at the capture's block. The full output is kept in
# tmp/minter-v3-upgrade-preflight.log.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/../../.."

HOLDERS_DIR=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --holders-dir) HOLDERS_DIR="$2"; shift 2 ;;
    -h|--help)     sed -n '2,/^$/p' "$0"; exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

if [[ -z "$HOLDERS_DIR" ]]; then
  echo "ERROR: --holders-dir is required (the capture the upgrade reads)" >&2
  echo "       produce one with: script/holders/capture-holders --to-block <block>" >&2
  exit 1
fi
if [[ ! -f "${HOLDERS_DIR}/manifest.txt" ]]; then
  echo "ERROR: ${HOLDERS_DIR} is not a capture (no manifest.txt)" >&2
  exit 1
fi

HOLDERS_DIR="$HOLDERS_DIR" exec script/verify/run-campaign-test script/verify/minter-v3-upgrade \
  tmp/minter-v3-upgrade-preflight.log --mc MinterUpgradePreflight "${FORGE_VERBOSITY:--vv}"
