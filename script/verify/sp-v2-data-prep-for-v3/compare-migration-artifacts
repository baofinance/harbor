#!/usr/bin/env bash
# compare-migration-artifacts DIR1 DIR2
#
# Compare two directories produced by run-migrate-StabilityPool_v2-data --compare-dir.
# Applies transforms to eliminate known run-to-run noise before diffing.
# Originals in DIR1/DIR2 are never modified.
#
# Transforms applied to forge-log-raw.txt:
#   - ISO timestamp in the batch JSON filename logged by the Deployer
#   - Elapsed time reported by run-script
# Each transform replaces at most one occurrence (no /g flag).
#
# batch-decoded.txt is generated from batch-raw.json with:
#   - Pool addresses annotated with their name (from the holder .txt files)
#   - Holder addresses annotated with letters A, B, C... (position in the holder
#     file, consistent across both batches so meld aligns deletions correctly)
#
# Holder labels are read from script/Migrate_StabilityPool_v2_Data_mainnet/ if
# present (git-tracked filtered files), otherwise from tmp/sp-holders/ (raw).
#
# Usage:
#   compare-migration-artifacts tmp/comparison/run1 tmp/comparison/run2
#   compare-migration-artifacts tmp/comparison/inefficient tmp/comparison/efficient

set -euo pipefail

# Resolve dirs to absolute paths before cd changes cwd.
DIR1="$(cd "${1:?usage: $0 DIR1 DIR2}" && pwd)"
DIR2="$(cd "${2:?usage: $0 DIR1 DIR2}" && pwd)"

cd "$(git rev-parse --show-toplevel)"

[[ -d "$DIR1" ]] || { echo "ERROR: $DIR1 is not a directory" >&2; exit 1; }
[[ -d "$DIR2" ]] || { echo "ERROR: $DIR2 is not a directory" >&2; exit 1; }

TMP1=$(mktemp -d)
TMP2=$(mktemp -d)
trap 'rm -rf "$TMP1" "$TMP2"' EXIT

cp -r "$DIR1/." "$TMP1/"
cp -r "$DIR2/." "$TMP2/"

# ── Transforms (forge-log-raw.txt only) ──────────────────────────────────────

# ISO timestamp embedded in the batch JSON filename: 2026-06-03T12:45:30Z
sed -Ei \
  's|Migrate_StabilityPool_v2_Data_mainnet_[0-9T:Z-]+_harbor_multisig\.json|Migrate_StabilityPool_v2_Data_mainnet_<timestamp>_harbor_multisig.json|' \
  "$TMP1/forge-log-raw.txt" "$TMP2/forge-log-raw.txt"

# Elapsed time: "  Took: 0m 42s"
sed -Ei \
  's/  Took: [0-9]+m [0-9]+s/  Took: <time>/' \
  "$TMP1/forge-log-raw.txt" "$TMP2/forge-log-raw.txt"

# ── Decode batch-raw.json → batch-decoded.txt ────────────────────────────────
# Pool names come from the holder .txt files.  Holder labels (A, B, C...) are
# assigned by position in the holder file so the same address gets the same
# label in both batches — meld can then show deletions as individual lines.

python3 - "$TMP1/batch-raw.json" "$TMP1/batch-decoded.txt" \
           "$TMP2/batch-raw.json" "$TMP2/batch-decoded.txt" << 'DECODE_PY'
import json, sys, os, string

FILTERED_DIR = "script/Migrate_StabilityPool_v2_Data_mainnet"
RAW_DIR      = "tmp/sp-holders"
LABELS = list(string.ascii_uppercase) + [f"A{c}" for c in string.ascii_uppercase]

def build_lookup():
    """Return {pool_addr_lower: {'name': str, 'holders': {addr_lower: label}}}."""
    holders_dir = (FILTERED_DIR if os.path.isdir(FILTERED_DIR)
                   else RAW_DIR if os.path.isdir(RAW_DIR)
                   else None)
    lookup = {}
    if not holders_dir:
        return lookup
    for fname in sorted(os.listdir(holders_dir)):
        if not fname.endswith('.txt'):
            continue
        pool_addr = pool_name = None
        holder_labels = {}
        idx = 0
        with open(os.path.join(holders_dir, fname)) as f:
            for line in f:
                line = line.rstrip('\n')
                if line.startswith('# Stability pool holders:'):
                    pool_name = line.split(':', 1)[1].strip()
                elif line.startswith('# proxy:'):
                    ox = line.find('0x')
                    if ox >= 0:
                        pool_addr = line[ox:ox + 42].lower()
                elif line.startswith('# no-work:'):
                    # filtered holder — still occupies a label slot
                    addr = line.replace('# no-work:', '').strip()[:42].lower()
                    if addr.startswith('0x'):
                        holder_labels[addr] = LABELS[idx] if idx < len(LABELS) else str(idx + 1)
                        idx += 1
                elif not line.startswith('#') and line.strip():
                    addr = line.strip()[:42].lower()
                    holder_labels[addr] = LABELS[idx] if idx < len(LABELS) else str(idx + 1)
                    idx += 1
        if pool_addr and pool_name:
            lookup[pool_addr] = {'name': pool_name, 'holders': holder_labels}
    return lookup

REMEDIATE_SEL = '0xeea46331'
UPGRADE_SEL   = '0x4f1ef286'

def read_addrs(args, offset):
    n = int.from_bytes(args[offset:offset + 32], 'big')
    return ['0x' + args[offset + 32 + i * 32 + 12:offset + 32 + i * 32 + 32].hex()
            for i in range(n)]

def decode_remediate(data_hex):
    raw = bytes.fromhex(data_hex[2:] if data_hex.startswith('0x') else data_hex)
    args = raw[4:]
    return (read_addrs(args, int.from_bytes(args[0:32], 'big')),
            read_addrs(args, int.from_bytes(args[32:64], 'big')))

def decode_impl(data_hex):
    raw = bytes.fromhex(data_hex[2:] if data_hex.startswith('0x') else data_hex)
    return '0x' + raw[4 + 12:4 + 32].hex()

def decode_batch(in_path, out_path, lookup):
    txs = json.load(open(in_path))['transactions']
    lines = []
    prev_sel = cur_pool = None
    for t in txs:
        sel = t['data'][:10]
        pool = t['to']
        if sel == UPGRADE_SEL:
            if prev_sel == REMEDIATE_SEL:
                lines.append(f"  restore-to  {decode_impl(t['data'])}")
            else:
                cur_pool = pool
                info = lookup.get(pool.lower())
                name = f"  # {info['name']}" if info else ""
                lines.append(f"pool {pool}{name}")
                lines.append(f"  upgrade-to  {decode_impl(t['data'])}")
        elif sel == REMEDIATE_SEL:
            tokens, holders = decode_remediate(t['data'])
            lines.append(f"  remediate   tokens={len(tokens)}")
            pool_info = lookup.get((cur_pool or '').lower(), {})
            holder_labels = pool_info.get('holders', {})
            for h in holders:
                label = holder_labels.get(h.lower(), '?')
                lines.append(f"    {h}  # {label}")
        else:
            lines.append(f"  {sel}")
        prev_sel = sel
    with open(out_path, 'w') as f:
        f.write('\n'.join(lines) + '\n')

lookup = build_lookup()
decode_batch(sys.argv[1], sys.argv[2], lookup)
decode_batch(sys.argv[3], sys.argv[4], lookup)
DECODE_PY

# ── Compare ──────────────────────────────────────────────────────────────────

DIFF_EXIT=0
diff -ru "$TMP1" "$TMP2" || DIFF_EXIT=$?

if command -v meld >/dev/null 2>&1; then
  meld "$TMP1" "$TMP2"   # foreground: blocks until user closes meld, then trap cleans up
fi

exit $DIFF_EXIT
