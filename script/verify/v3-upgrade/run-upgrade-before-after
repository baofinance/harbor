#!/usr/bin/env bash
# Verify the upgrade of every live market to Minter_v3, StabilityPool_v3 and StabilityPoolManager_v2 by running the
# upgrade script itself on anvil, and comparing what every market contract reads before and after it.
#
#   Prong A (black-box): MarketsCapture records every contract - minter, both pools, manager - and each pool's
#     behaviour under the same interactions. The before is a fork of mainnet at the capture's block, the last before
#     the pause; the after is a fork of anvil once the upgrade script has run there. MarketsExpectedAfter then writes
#     the record each contract must have after: its before record, changed only where an expectation says, with the
#     reason. The expected and the actual after records must not differ.
#   Prong B (white-box): MarketsStorageCopy checks the storage the upgrade copied - each holder's reward records,
#     each reward stream, each pool's ledger gap - against the frozen pools.
#
# forge test forks anvil in memory and writes nothing back to it. run-script --broadcast --local sends the upgrade to
# anvil and executes each market's batch as the multisig would. So one anvil session serves the whole run.
#
# The capture is a REQUIRED argument, the one the upgrade script is given: taken to the last block before the pause.
# Its block comes from its manifest.
#
# Usage:
#   script/verify/v3-upgrade/run-upgrade-before-after --holders-dir <capture>
#
# The live markets' capture is script/UpgradeStabilityPool_v2_v3/holders-26248723. Produce another with:
#   script/holders/capture-holders --to-block <block>
#
# Needs MAINNET_RPC_URL, archival at the capture's block. The records are written to tmp/v3-upgrade/, and each step's
# output is kept there in a .log file.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/../../.."

SALT="harbor_v1"
NETWORK="mainnet"
OUT="tmp/v3-upgrade"
FORGE_VERBOSITY="${FORGE_VERBOSITY:--vv}"

HOLDERS_DIR=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --holders-dir)
      HOLDERS_DIR="$2"
      shift 2
      ;;
    -h | --help)
      sed -n '2,/^$/p' "$0"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

if [[ -z "$HOLDERS_DIR" ]]; then
  echo "ERROR: --holders-dir is required (the capture the upgrade reads)" >&2
  echo "       produce one with: script/holders/capture-holders --to-block <block>" >&2
  exit 1
fi
if [[ ! -f "${HOLDERS_DIR}/manifest.txt" ]]; then
  echo "ERROR: ${HOLDERS_DIR} is not a capture (no manifest.txt)" >&2
  exit 1
fi
CAPTURE_BLOCK="$(sed -n 's/^to-block: *//p' "${HOLDERS_DIR}/manifest.txt")"
if [[ ! "$CAPTURE_BLOCK" =~ ^[0-9]+$ ]]; then
  echo "ERROR: the manifest of ${HOLDERS_DIR} gives no numeric to-block: '${CAPTURE_BLOCK}'" >&2
  exit 1
fi

echotty() {
  echo "$*"
  if [[ ! -t 1 ]]; then
    echo "$*" >/dev/tty
  fi
}

prompt() {
  echotty ""
  echotty "──────────────────────────────────────────────────────────────"
  echotty "$1"
  echotty "──────────────────────────────────────────────────────────────"
  read -rn1 -p "Ready? [Y/n] " response
  echotty "" >/dev/tty
  if [[ "$response" =~ ^[Nn]$ ]]; then
    echotty "Aborted."
    exit 1
  fi
}

# Run the campaign's tests matching <contract> with the given forge arguments, logging to $OUT/<log>. The capture runs
# every market's interactions in one test call, so the block gas limit is lifted, as for the rehearsal.
campaign_test() {
  local log="$1" contract="$2"
  shift 2
  script/verify/run-campaign-test script/verify/v3-upgrade "$OUT/$log" --mc "$contract" "$@" \
    "$FORGE_VERBOSITY" --disable-block-gas-limit
}

echo "======================================================================"
echo "  Upgrade of every live market to v3: before and after"
echo "======================================================================"
echo "  Capture:        $HOLDERS_DIR (to block $CAPTURE_BLOCK)"
echo "  Salt:           $SALT"

# The records of an earlier run would hide one this run fails to write.
rm -rf "$OUT/before" "$OUT/after" "$OUT/expected-after" "$OUT/compare"
mkdir -p "$OUT"

prompt "Start a fresh anvil fork of the chain's head:  script/anvil --block latest"

# The upgrade script reads the deployed addresses from the local state file, so it starts as mainnet's.
mkdir -p "deployments/local/$NETWORK"
cp "deployments/$NETWORK/$SALT.state.json" "deployments/local/$NETWORK/$SALT.state.json"
echo "  Local state:    copied from deployments/$NETWORK/$SALT.state.json"

HEAD_BLOCK="$(cast block-number --rpc-url local)"
if [[ ! "$HEAD_BLOCK" =~ ^[0-9]+$ || "$HEAD_BLOCK" -le "$CAPTURE_BLOCK" ]]; then
  echo "ERROR: anvil's head is block '${HEAD_BLOCK}', not after the capture's block ${CAPTURE_BLOCK}" >&2
  exit 1
fi
# Both captures are warped to the same time, well after anvil's head, so the blocks the upgrade adds stay before it.
HEAD_TIMESTAMP="$(cast block latest -f timestamp --rpc-url local)"
START_TIMESTAMP=$((HEAD_TIMESTAMP + 12000))
echo "  anvil head:     block $HEAD_BLOCK"
echo "  START_TIMESTAMP: $START_TIMESTAMP (anvil head's time + 12000s)"

echo ""
echo "Prong A: capturing the before, on mainnet at block $CAPTURE_BLOCK..."
VERSION=before HOLDERS_DIR="$HOLDERS_DIR" START_TIMESTAMP="$START_TIMESTAMP" \
  campaign_test before.log MarketsCapture --fork-url "$NETWORK" --fork-block-number "$CAPTURE_BLOCK"

echo ""
echo "Running Upgrade_MarketsToV3_mainnet on anvil (--broadcast --local)..."
set +e
HOLDERS_DIR="$HOLDERS_DIR" script/run-script Upgrade_MarketsToV3_mainnet --salt "$SALT" --network "$NETWORK" \
  --broadcast --local 2>&1 | tee "$OUT/upgrade.log"
status=${PIPESTATUS[0]}
set -e
if [[ "$status" -ne 0 ]]; then
  echo "ERROR: the upgrade script failed (exit $status) - see $OUT/upgrade.log" >&2
  exit "$status"
fi

echo ""
echo "Prong A: capturing the after, on anvil..."
VERSION=after HOLDERS_DIR="$HOLDERS_DIR" START_TIMESTAMP="$START_TIMESTAMP" \
  campaign_test after.log MarketsCapture --fork-url local

echo ""
echo "Prong B: checking the storage the upgrade copied..."
HOLDERS_DIR="$HOLDERS_DIR" campaign_test storage-copy.log MarketsStorageCopy --fork-url local

echo ""
echo "Prong A: writing the expected after..."
campaign_test expected-after.log MarketsExpectedAfter

# Each record with its keys sorted, so the diff compares values, not the order they were written in.
for side in expected-after after; do
  while IFS= read -r -d '' file; do
    mkdir -p "$OUT/compare/$side/$(dirname "$file")"
    jq -S . "$OUT/$side/$file" >"$OUT/compare/$side/$file"
  done < <(cd "$OUT/$side" && find . -name '*.json' -print0)
done

echo ""
echo "======================================================================"
echo "  Prong A: the expected after against the after - expect NO differences"
echo "======================================================================"
if diff -ru "$OUT/compare/expected-after" "$OUT/compare/after"; then
  echo "  ✅ PASS: every contract reads after the upgrade as it did before, or as expected"
  exit 0
fi
if command -v meld >/dev/null 2>&1; then
  meld "$OUT/compare/expected-after" "$OUT/compare/after" &
fi
echo "  ❌ FAIL: the differences above are neither unchanged nor expected"
exit 1
