#!/usr/bin/env bash
# Rehearse the upgrade of every live market to Minter_v3, StabilityPool_v3 and StabilityPoolManager_v2: run the upgrade
# script itself on anvil, as it will run on mainnet but for --local, and compare what every market contract reads
# before and after it.
#
#   Read point: FrozenMarketsReadPoint checks the state the upgrade reads is the state it runs on - the pause changed
#     only which implementation each minter and pool runs, and nothing earlier in the pause's block changed a market.
#   Native settings: UpgradedMarketsMatchANativeDeploy upgrades each peg's markets by the upgrade script's own function,
#     on a fork of mainnet at the block after the capture, deploys the same peg natively beside them, and requires
#     every contract of each market to hold the settings the native deploy sets.
#   Prong A (black-box): MarketsCapture records every contract - minter, both pools, manager - and each pool's
#     behaviour under the same interactions. The before is a fork of mainnet at the block of the upgrade's capture
#     (FROZEN_MARKETS_CAPTURE in script/Upgrade_MarketsToV3_mainnet.s.sol), the last before the pause; the after is a
#     fork of anvil once the upgrade script has run there. MarketsExpectedAfter then writes the record each contract
#     must have after: its before record, changed only where an expectation says, with the reason. The expected and the
#     actual after records must not differ.
#   Prong B (white-box): MarketsStorageCopy checks the storage the upgrade copied - each holder's reward records,
#     each reward stream, each pool's ledger gap - against the frozen pools.
#
# forge test forks anvil in memory and writes nothing back to it. run-script --broadcast --local sends the upgrade to
# anvil and executes each market's batch as the multisig would. So one anvil session serves the whole run.
#
# Usage:
#   script/verify/v3-upgrade/run-upgrade-rehearsal
#
# Fails unless each step's tests actually ran - see script/verify/run-campaign-test.
#
# Needs MAINNET_RPC_URL, archival at the capture's block. The records are written to tmp/v3-upgrade/, and each step's
# output is kept there in a .log file.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/../../.."

SALT="harbor_v1"
NETWORK="mainnet"
OUT="tmp/v3-upgrade"
FORGE_VERBOSITY="${FORGE_VERBOSITY:--vv}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      sed -n '2,/^$/p' "$0"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

echotty() {
  echo "$*"
  if [[ ! -t 1 ]]; then
    echo "$*" >/dev/tty
  fi
}

prompt() {
  echotty ""
  echotty "──────────────────────────────────────────────────────────────"
  echotty "$1"
  echotty "──────────────────────────────────────────────────────────────"
  read -rn1 -p "Ready? [Y/n] " response
  echotty "" >/dev/tty
  if [[ "$response" =~ ^[Nn]$ ]]; then
    echotty "Aborted."
    exit 1
  fi
}

# Run the campaign's tests matching <contract> with the given forge arguments, logging to $OUT/<log>. The capture runs
# every market's interactions in one test call, so the block gas limit is lifted. A step given an RPC (--rpc-url
# mainnet for one forking mainnet from inside its tests, --fork-url local for one against anvil) has the provider's
# refusals (HTTP 429, a rate limit) retried with a backoff - forge accepts the retry options only with an RPC - and
# one forking mainnet paces its requests too, as the other campaign runners do; a step against anvil is not paced,
# anvil being local, and a step forking nothing is given nothing.
campaign_test() {
  local log="$1" contract="$2"
  shift 2
  local pacing=()
  if [[ " $* " == *" --rpc-url "* || " $* " == *" --fork-url "* ]]; then
    pacing=(--fork-retries 100 --fork-retry-backoff 5000)
    [[ " $* " == *" local "* ]] || pacing+=(--compute-units-per-second 50)
  fi
  script/verify/run-campaign-test script/verify/v3-upgrade "$OUT/$log" --mc "$contract" "$@" \
    "$FORGE_VERBOSITY" --disable-block-gas-limit "${pacing[@]}"
}

echo "======================================================================"
echo "  Upgrade of every live market to v3: rehearsal"
echo "======================================================================"
echo "  Salt:           $SALT"

# The records of an earlier run would hide one this run fails to write.
rm -rf "$OUT/before" "$OUT/after" "$OUT/expected-after" "$OUT/compare"
mkdir -p "$OUT"

# The expected-after records are built by this library; its own tests run first, before anything is forked.
echo ""
echo "Expectations library: a record expected after is built as its tests say..."
campaign_test expectations.log CaptureExpectations

echo ""
echo "Read point: the state the upgrade reads is the state it runs on..."
campaign_test read-point.log FrozenMarketsReadPoint --rpc-url mainnet

# Independent of the rehearsal below: a failure here is reported at the end, after the rehearsal has run.
echo ""
echo "Native settings: each upgraded market holds the settings a native deploy sets..."
set +e
campaign_test native-settings.log UpgradedMarketsMatchANativeDeploy --rpc-url mainnet
native_status=$?
set -e

prompt "Start a fresh anvil fork of the chain's head:  script/anvil --block latest"

# The upgrade script reads the deployed addresses from the local state file, so it starts as mainnet's.
mkdir -p "deployments/local/$NETWORK"
cp "deployments/$NETWORK/$SALT.state.json" "deployments/local/$NETWORK/$SALT.state.json"
echo "  Local state:    copied from deployments/$NETWORK/$SALT.state.json"

# Both captures are warped to the same time, well after anvil's head, so the blocks the upgrade adds stay before it.
HEAD_BLOCK="$(cast block-number --rpc-url local)"
HEAD_TIMESTAMP="$(cast block latest -f timestamp --rpc-url local)"
START_TIMESTAMP=$((HEAD_TIMESTAMP + 12000))
echo "  anvil head:     block $HEAD_BLOCK"
echo "  START_TIMESTAMP: $START_TIMESTAMP (anvil head's time + 12000s)"

echo ""
echo "Prong A: capturing the before, on mainnet at the capture's block..."
VERSION=before START_TIMESTAMP="$START_TIMESTAMP" campaign_test before.log MarketsCapture --rpc-url mainnet

echo ""
echo "Running Upgrade_MarketsToV3_mainnet on anvil (--broadcast --local)..."
set +e
script/run-script Upgrade_MarketsToV3_mainnet --salt "$SALT" --network "$NETWORK" --broadcast --local 2>&1 |
  tee "$OUT/upgrade.log"
status=${PIPESTATUS[0]}
set -e
if [[ "$status" -ne 0 ]]; then
  echo "ERROR: the upgrade script failed (exit $status) - see $OUT/upgrade.log" >&2
  exit "$status"
fi

echo ""
echo "Prong A: capturing the after, on anvil..."
VERSION=after START_TIMESTAMP="$START_TIMESTAMP" campaign_test after.log MarketsCapture --fork-url local

echo ""
echo "Prong B: checking the storage the upgrade copied..."
campaign_test storage-copy.log MarketsStorageCopy --fork-url local

echo ""
echo "Prong A: writing the expected after..."
# The compensated markets' expectations read the minters' events on anvil, from the block after its head.
START_TIMESTAMP="$START_TIMESTAMP" UPGRADE_FROM_BLOCK="$HEAD_BLOCK" campaign_test expected-after.log MarketsExpectedAfter \
  --rpc-url mainnet

# Each record with its keys sorted, so the diff compares values, not the order they were written in.
for side in expected-after after; do
  while IFS= read -r -d '' file; do
    mkdir -p "$OUT/compare/$side/$(dirname "$file")"
    jq -S . "$OUT/$side/$file" >"$OUT/compare/$side/$file"
  done < <(cd "$OUT/$side" && find . -name '*.json' -print0)
done

echo ""
echo "======================================================================"
echo "  Prong A: the expected after against the after - expect NO differences"
echo "======================================================================"
if diff -ru "$OUT/compare/expected-after" "$OUT/compare/after"; then
  echo "  ✅ PASS: every contract reads after the upgrade as it did before, or as expected"
  rehearsal_status=0
else
  if command -v meld >/dev/null 2>&1; then
    meld "$OUT/compare/expected-after" "$OUT/compare/after" &
  fi
  echo "  ❌ FAIL: the differences above are neither unchanged nor expected"
  rehearsal_status=1
fi

if [[ "$native_status" -eq 0 ]]; then
  echo "  ✅ PASS: every upgraded market holds the settings a native deploy sets"
else
  echo "  ❌ FAIL: an upgraded market's settings differ from a native deploy's - see $OUT/native-settings.log"
fi
if [[ "$rehearsal_status" -ne 0 || "$native_status" -ne 0 ]]; then
  exit 1
fi
exit 0
