#!/usr/bin/env bash
# Regenerate the figures of the 2026-10-16 rebalance dilution exploits. For each exploited market (BTC::stETH and
# EUR::stETH), in doc/incidents/2026-10-16-rebalance-dilution/:
#   - <PEG>-<collateral>-figures.md and -accounts.csv, on a mainnet fork at its exploit's transaction;
#   - -new-contracts.md and -new-contracts-accounts.csv, with the market upgraded just before it;
#   - -holders.md, every holder followed from the exploit to the pause, the fork moved block by block.
# Read-only on chain. No log query goes to the RPC: the holders and the logs come from the captures in that directory. A
# market's files are written only when every one of its checks passes. The tests run one after the other, so their reads
# do not share the RPC's rate limit.
#
# Fails unless the generator actually ran - see script/verify/run-campaign-test.
#
# Usage:
#   script/verify/incidents/run-rebalance-dilution-report
#
# Needs MAINNET_RPC_URL on an archival node. The full output is kept in tmp/rebalance-dilution-report.log.
#
# The reads are throttled for an RPC that answers a burst of requests with HTTP 429, as a free plan does: forge waits
# after each 429 (--compute-units-per-second sets how long) and retries up to --fork-retries times, from a backoff of
# --fork-retry-backoff milliseconds. forge accepts those two only with --rpc-url, so every test first runs on a fork
# pinned to the block before the first exploit, before its setUp creates the fork it reads. With the reads in forge's RPC
# cache, a run takes minutes; uncached, a reading of the holders' history took about 50 seconds (2026-10-24).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/../../.."

exec script/verify/run-campaign-test script/verify/incidents tmp/rebalance-dilution-report.log \
  --mc RebalanceDilutionReport --threads 1 "${FORGE_VERBOSITY:--vv}" \
  --rpc-url mainnet --fork-block-number 26204583 --fork-retries 100 --fork-retry-backoff 5000 \
  --compute-units-per-second 50
