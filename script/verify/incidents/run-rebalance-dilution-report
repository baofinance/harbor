#!/usr/bin/env bash
# Regenerate the figures of the 2026-10-16 rebalance dilution exploits: for each exploited market (BTC::stETH and
# EUR::stETH), doc/incidents/2026-10-16-rebalance-dilution/<PEG>-<collateral>-figures.md and -accounts.csv. Each on a
# mainnet fork at its exploit's transaction; read-only on chain. A market's files are written only when every one of its
# checks passes. The two run one after the other, so their log queries do not share the RPC's rate limit.
#
# Fails unless the generator actually ran - see script/verify/run-campaign-test.
#
# Usage:
#   script/verify/incidents/run-rebalance-dilution-report
#
# Needs MAINNET_RPC_URL on an archival node. Each market makes about 750 log and code queries, paced under the RPC's
# rate limit, so the whole run takes about twenty minutes. The full output is kept in tmp/rebalance-dilution-report.log.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/../../.."

exec script/verify/run-campaign-test script/verify/incidents tmp/rebalance-dilution-report.log \
  --mc RebalanceDilutionReport --threads 1 "${FORGE_VERBOSITY:--vv}"
