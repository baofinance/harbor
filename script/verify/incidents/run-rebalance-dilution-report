#!/usr/bin/env bash
# Regenerate the figures of the report on the 2026-10-16 rebalance dilution exploit of BTC::stETH:
# doc/incidents/2026-10-16-rebalance-dilution-figures.md. On a mainnet fork at the exploit's transaction; read-only on
# chain. The file is written only when every check passes.
#
# Fails unless the generator actually ran - see script/verify/run-campaign-test.
#
# Usage:
#   script/verify/incidents/run-rebalance-dilution-report
#
# Needs MAINNET_RPC_URL on an archival node. It makes about 750 log and code queries, paced under the RPC's rate limit,
# so it takes a few minutes. The full output is kept in tmp/rebalance-dilution-report.log.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/../../.."

exec script/verify/run-campaign-test script/verify/incidents tmp/rebalance-dilution-report.log \
  --mc RebalanceDilutionReport "${FORGE_VERBOSITY:--vv}"
