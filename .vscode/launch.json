{
  "configurations": [
    {
      "name": "Debug anvil.py directly",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/bao-base/bin/anvil.py",
      "args": ["steal", "--erc20", "wsteth", "--to", "me", "--amount", "1"],
      "console": "integratedTerminal"
    },
    {
      "name": "Python: bao-base bin poetry anvil steal",
      "type": "debugpy",
      "request": "launch",
      "module": "poetry",
      "args": [
        "run",
        "--directory",
        "${workspaceFolder}/lib/bao-base/bin",
        "${workspaceFolder}/lib/bao-base/bin/anvil.py",
        "steal",
        "--erc20",
        "wsteth",
        "--to",
        "me",
        "--amount",
        "1"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug anvil with Poetry ecosystem",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/bao-base/bin/anvil.py",
      "args": ["steal", "--erc20", "wsteth", "--to", "me", "--amount", "1"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib/bao-base/bin"
      },
      "preLaunchTask": "prepare-poetry-env"
    }
  ]
}
