{
  "license": "MIT",
  "scripts": {
    "pre-push": "./lib/bao-base/run pre-push",
    "prettier": "prettier --log-level warn '{src,test,script}/**/*.sol'",
    "fmt": "yarn prettier --write",
    "fmt:check": "yarn prettier --check",
    "test": "forge test -vvv --nmp script/**/*.t.sol --summary",
    "test:deploy": "forge test --summary --mp script/**/*.t.sol",
    "gas": "yarn test --gas-report | ./lib/bao-base/bin/extract-gas | tee results/gas-report.txt",
    "coverage": "./lib/bao-base/run coverage",
    "wake": "wake detect all",
    "slither": "./lib/bao-base/run slither .",
    "script": "forge script --force --ffi",
    "disabled": "echo 'disabled tests:' && grep -n -e '^\\s*function\\s*test.*(.*).*private' test/**/*.t.sol",
    "doc": "forge doc",
    "svg": "cd results && find . -name \"*.gp\" -exec gnuplot -e \"set output '{}.svg'\" {} \\;",
    "png": "cd results && find . -name \"*.svg\" -exec convert {} {}.png \\;",
    "deploy:one": "forge script --force --ffi script/deploy.s.sol:Deploy --broadcast --slow",
    "deploy": "RESUME=false yarn deploy:one && RESUME=true yarn deploy:one",
    "deploy:local": "NETWORK=local yarn deploy",
    "deploy:local:test": "NETWORK=local:test yarn deploy",
    "contracts": "awk '/gas_reports *=/ {flag=1; next} /]/ {flag=0} flag {gsub(/\"|,/, \"\"); print $1}' foundry.toml",
    "contracts:regexp": "yarn contracts | paste -sd '|'",
    "sizes:raw:contracts": "yarn sizes:raw | grep -E \"^\\| Contract |^\\|---|$(yarn contracts:regexp)\"",
    "sizes:raw": "forge clean; forge build --sizes",
    "sizes": "echo \"generating contract-sizes.txt ...\"; yarn sizes:raw:contracts > ./results/contract-sizes.txt",
    "lint": "solhint 'src/**/*.sol' --config ./lib/bao-base/.solhint.json --disc",
    "dotfiles": "git ls-tree -r HEAD | grep 120000 | awk '{print $4}'"
  },
  "prettier": "./lib/bao-base/prettier.config.js",
  "dependencies": {
    "prettier": "^3.2.5",
    "prettier-plugin-solidity": "^1.3.1",
    "solhint": "^5.0.3"
  },
  "packageManager": "yarn@4.5.0"
}
