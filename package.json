{
  "license": "MIT",
  "scripts": {
    "prettier": "prettier --write 'src/**/*.sol'",
    "build": "forge build",
    "test": "echo 'running tests (logged to ./results/test.log) ...' && forge test -v --gas-report | tee ./results/test.log | grep -v '^|.*|$' | cat -s && grep -A1 '^|.*|$' ./results/test.log > ./results/gas-report.txt && echo; yarn disabled && echo; yarn coverage && yarn sizes:contracts > ./results/contract-sizes.txt",
    "test1": "forge test -vvv --gas-report",
    "coverage": "echo 'generating coverage (logged to results/coverage.log) ...' && forge coverage --report summary --report lcov > ./results/coverage.log && grep '\\(-\\|^| \\(src/\\|Total \\|File \\).* |$\\)' ./results/coverage.log > ./results/coverage.txt && lcov --extract ./lcov.info --output-file lcov.info 'src/*' > /dev/null && echo 'done.'",
    "coverage1": "forge coverage --report summary --report lcov ",
    "wake": "wake detect all",
    "slither": "slither . --exclude incorrect-versions-of-solidity,assembly-usage,different-pragma-directives-are-used,incorrect-versions-of-solidity --filter-paths \"lib/openzeppelin.*|lib/forge-std.*\"",
    "script": "forge script --force --ffi",
    "disabled": "echo 'disabled tests:' && grep -n -e '^\\s*function\\s*test.*(.*).*private' test/**/*.t.sol",
    "doc": "forge doc",
    "svg": "cd results && find . -name \"*.gp\" -exec gnuplot -e \"set output '{}.svg'\" {} \\;",
    "png": "cd results && find . -name \"*.svg\" -exec convert {} {}.png \\;",
    "deploy": "forge script --force --ffi script/deploy.s.sol:Deploy --broadcast --slow",
    "deploy:local": "NETWORK=local yarn deploy",
    "deploy:local:test": "NETWORK=local:test yarn deploy",
    "contracts": "awk '/gas_reports *=/ {flag=1; next} /]/ {flag=0} flag {gsub(/\"|,/, \"\"); print $1}' foundry.toml",
    "contracts:regexp": "yarn contracts | paste -sd '|'",
    "sizes:contracts": "yarn sizes | grep -E \"^\\| Contract |^\\|---|$(yarn contracts:regexp)\"",
    "sizes": "forge clean; forge build --sizes",
    "fmt:check": "prettier --log-level warn --ignore-path .gitignore '{src,test}/**/*.sol' --check",
    "fmt": "prettier --log-level warn --ignore-path .gitignore '{src,test}/**/*.sol' --write",
    "lint": "solhint 'src/**/*.sol' --disc",
    "dotfiles": "git ls-tree -r HEAD | grep 120000 | awk '{print $4}' | xargs ls -l",
    "dotfiles:bad": "yarn dotfiles | grep ' -> /'"
  },
  "dependencies": {
    "prettier": "^3.2.5",
    "prettier-plugin-solidity": "^1.3.1",
    "solhint": "^5.0.3"
  },
  "packageManager": "yarn@4.2.2"
}