#!/usr/bin/env bash
#
# Recover, as they were at a git ref, the graphs whose results have changed since - a runnable "before" of every
# graph that moved, in tmp/, to set beside results/ as it is now.
#
# The tracked CSVs under results/ are the regression evidence: a change to the protocol shows up as a change to
# them, and the question that follows is always "which graph do I look at?". This answers it in three steps, each
# reading the files as they were at the ref:
#
#   1. the CSVs that changed;
#   2. the plots - .gp files that read a CSV - that read one of those, or whose own text changed, each with every
#      CSV it reads, so that it draws;
#   3. the .gp files those plots load, such as style.gp, which they cannot run without.
#
# "Changed" means present on both sides and not identical. A file on one side only is reported, and recovered only
# where a step takes it - so a change to style.gp alone recovers nothing, since no plot's data or text moved.
#
# --open opens step 2's plots in VSCode, each recovered one beside its current version. Step 3's files draw nothing
# of their own and are never opened.
#
# The copy keeps results/'s own flat shape, because that is what makes it usable: a .gp file names its data by bare
# filename, so `cd` into the recovered directory and `gnuplot foo.gp` renders the before of exactly what
# `cd results && gnuplot foo.gp` renders now. Nothing is written into results/ itself: the comparison is between
# what is there now and what is recovered here.
#
# Unlike the scripts under lib/bao-base/bin, this one is executed rather than sourced.
#
#   ./bin/results-at                 # against the previous commit
#   ./bin/results-at HEAD~5
#   ./bin/results-at some-branch
#   ./bin/results-at HEAD~5 --open   # ...and open each recovered plot beside its current version
#
# --open is opt-in so that the report still works where there is no editor to open - over ssh, in CI, or when the
# answer to "what moved?" is all that was wanted.

set -euo pipefail
# `set -e` stops the script without a word, so say where. -E carries the trap into functions and subshells.
set -E
trap 'echo "results-at: stopped at line ${LINENO}, exit $?: ${BASH_COMMAND}" >&2' ERR

open_in_editor=""
ref=""
for arg in "$@"; do
    case "${arg}" in
        --open)
            open_in_editor=1
            ;;
        -*)
            echo "results-at: unknown option '${arg}'" >&2
            exit 1
            ;;
        *)
            if [[ -n "${ref}" ]]; then
                echo "results-at: more than one ref given ('${ref}' and '${arg}')" >&2
                exit 1
            fi
            ref="${arg}"
            ;;
    esac
done
ref="${ref:-HEAD~1}"

# A ref may name a branch with slashes in it, which cannot be a single directory component.
dir="tmp/results/${ref//\//_}"

if ! git rev-parse --verify --quiet "${ref}^{commit}" > /dev/null; then
    echo "results-at: '${ref}' is not a commit this repository knows" >&2
    exit 1
fi

rm -rf "${dir}"
mkdir -p "${dir}"

# `git archive` reads the tree at the ref, so the working tree and the index are both left alone. The whole of
# results/ comes across, the steps read it, and whatever no step takes is removed at the end.
git archive "${ref}" results | tar -x -C "${dir}" --strip-components=1
status=("${PIPESTATUS[@]}")
if [[ "${status[0]}" -ne 0 || "${status[1]}" -ne 0 ]]; then
    echo "results-at: could not extract results/ from '${ref}'" >&2
    exit 1
fi

# The CSVs a .gp file reads, and the .gp files it pulls in with gnuplot's own `load "other.gp"`, by bare filename.
# Comment lines are skipped: several .gp files document example command lines naming CSVs they do not draw. grep
# exits 1 when it selects nothing, which here means only that the file names none - style.gp reads no CSV. Any
# other failure still stops the script.
csvs_read_by() {
    { grep -v '^[[:space:]]*#' "$1" || [[ $? -eq 1 ]]; } \
        | { grep -oE '[A-Za-z0-9_:.-]+\.csv' || [[ $? -eq 1 ]]; } \
        | sort -u
}
gp_files_loaded_by() {
    { grep -v '^[[:space:]]*#' "$1" || [[ $? -eq 1 ]]; } \
        | { grep -oE "load[[:space:]]+['\"][A-Za-z0-9_:.-]+\.gp['\"]" || [[ $? -eq 1 ]]; } \
        | { grep -oE '[A-Za-z0-9_:.-]+\.gp' || [[ $? -eq 1 ]]; } \
        | sort -u
}

# What changed, and what is on one side only - read before anything is removed.
declare -A changed=() # CSV or .gp name -> how many lines differ, so a header-only rename reads differently from a behaviour change
declare -a added=() removed=()
for path in "${dir}"/*.csv "${dir}"/*.gp; do
    [[ -e "${path}" ]] || continue
    name="$(basename "${path}")"
    if [[ ! -f "results/${name}" ]]; then
        removed+=("${name}")
    elif ! cmp -s "${path}" "results/${name}"; then
        changed["${name}"]="$(diff "${path}" "results/${name}" | grep -c '^[<>]' || true)"
    fi
done
for path in results/*.csv results/*.gp; do
    [[ -e "${path}" ]] || continue
    name="$(basename "${path}")"
    if [[ ! -f "${dir}/${name}" ]]; then
        added+=("${name}")
    fi
done

declare -A keep=()     # what the steps take; everything else is removed
declare -A drawn_by=() # a changed CSV -> the plots of step 2 that read it
declare -a plots=()    # step 2's plots, which --open opens

# 1. The CSVs that changed.
for name in "${!changed[@]}"; do
    if [[ "${name}" == *.csv ]]; then
        keep["${name}"]=1
    fi
done

# 2. The plots that read one of those, or whose own text changed, each with every CSV it reads.
for path in "${dir}"/*.gp; do
    [[ -e "${path}" ]] || continue
    name="$(basename "${path}")"
    reads="$(csvs_read_by "${path}")"
    if [[ -z "${reads}" ]]; then
        continue # not a plot: it draws nothing of its own
    fi

    wanted=""
    if [[ -n "${changed[${name}]:-}" ]]; then
        wanted=1
    fi
    for csv in ${reads}; do
        if [[ -n "${changed[${csv}]:-}" ]]; then
            wanted=1
            drawn_by["${csv}"]="${drawn_by[${csv}]:-}${name} "
        fi
    done
    if [[ -z "${wanted}" ]]; then
        continue
    fi

    plots+=("${name}")
    keep["${name}"]=1
    for csv in ${reads}; do
        keep["${csv}"]=1
    done
done

# 3. The .gp files those plots load, and any those load in turn, so a chain of any length is covered.
loading=("${plots[@]}")
while [[ "${#loading[@]}" -gt 0 ]]; do
    name="${loading[0]}"
    loading=("${loading[@]:1}")
    if [[ ! -f "${dir}/${name}" ]]; then
        continue # loaded, but absent at the ref: nothing to read or recover
    fi
    for loaded in $(gp_files_loaded_by "${dir}/${name}"); do
        if [[ -z "${keep[${loaded}]:-}" ]]; then
            keep["${loaded}"]=1
            loading+=("${loaded}")
        fi
    done
done

# Whatever no step took goes, including anything in a subdirectory, since the steps take bare names only.
while IFS= read -r -d '' path; do
    if [[ -z "${keep[${path#"${dir}/"}]:-}" ]]; then
        rm -f "${path}"
    fi
done < <(find "${dir}" -type f -print0)
find "${dir}" -mindepth 1 -type d -empty -delete

# Plot files name themselves in the graph they draw, but they have not always done so, and a recovered
# one from before that renders with no title at all. Two graphs opened side by side are then told apart
# only by which window they are in, which is exactly the moment it matters.
#
# So where the version NOW titles itself and the recovered one does not, give it one - marked with the
# ref, because the point is to identify the before and two identical titles would not. A plot that
# already titles itself at the ref is left exactly as it was: what it said then is what it said.
titled=0
for then in "${dir}"/*.gp; do
    [[ -e "${then}" ]] || continue
    name="$(basename "${then}")"
    [[ -f "results/${name}" ]] || continue

    # Where the title goes depends on the plot: a multiplot carries one overall title on its own
    # `set multiplot` line, and anything else takes a `set title` before it draws. Each is checked for a
    # title in the place it would go, so a multiplot whose PANELS are titled still gains its overall one.
    if grep -qE '^[[:space:]]*set[[:space:]]+multiplot' "${then}"; then
        grep -qE '^[[:space:]]*set[[:space:]]+multiplot.*[[:space:]]title[[:space:]]' "${then}" && continue
        grep -qE '^[[:space:]]*set[[:space:]]+multiplot.*[[:space:]]title[[:space:]]' "results/${name}" || continue
        # `noenhanced` because every one of these names carries underscores, which enhanced text would
        # render as subscripts.
        awk -v label="${name} at ${ref}" '
            !done && /^[[:space:]]*set[[:space:]]+multiplot/ {
                print $0 " title \"" label "\" noenhanced"
                done = 1
                next
            }
            { print }
        ' "${then}" > "${then}.titled"
    else
        grep -qE '^[[:space:]]*set[[:space:]]+title[[:space:]]' "${then}" && continue
        grep -qE '^[[:space:]]*set[[:space:]]+title[[:space:]]' "results/${name}" || continue
        # Before the first line that actually draws. `s?plot` anchored at the start of the line so that
        # neither `replot` nor a `plot` named in one of the example command lines is mistaken for it.
        awk -v label="${name} at ${ref}" '
            !done && /^[[:space:]]*s?plot([[:space:]]|$)/ {
                print "set title \"" label "\" noenhanced"
                done = 1
            }
            { print }
        ' "${then}" > "${then}.titled"
    fi

    if [[ -s "${then}.titled" ]]; then
        mv "${then}.titled" "${then}"
        titled=$((titled + 1))
    else
        rm -f "${then}.titled"
    fi
done

recovered="$(find "${dir}" -type f | wc -l)"
if [[ "${recovered}" -eq 0 ]]; then
    rmdir "${dir}"
    echo "recovered nothing from ${ref}"
else
    echo "recovered ${recovered} files from ${ref} into ${dir}"
fi
if [[ "${titled}" -gt 0 ]]; then
    echo "titled ${titled} of them, which drew untitled at ${ref} - each says '<name> at ${ref}'"
fi
echo

for name in $(printf '%s\n' "${!changed[@]}" | sort); do
    echo "CHANGED  ${name}  (${changed[${name}]} lines differ)"
    if [[ "${name}" == *.gp ]]; then
        echo "         diff:     git diff ${ref} -- results/${name}"
    elif [[ -z "${drawn_by[${name}]:-}" ]]; then
        # A CSV nothing draws is a CSV nobody will look at, which is worth saying.
        echo "         drawn by: NOTHING - no plot at ${ref} reads this"
    else
        for gp in ${drawn_by[${name}]}; do
            echo "         drawn by: ${gp}"
        done
        echo "         compare:  cd results && gnuplot -e \"before='../${dir}/${name}'; after='${name}'; cols='2'\" compare.gp > ../tmp/${name%.csv}.svg"
    fi
done
for name in "${added[@]}"; do
    echo "ADDED    ${name}  (did not exist at ${ref})"
done
for name in "${removed[@]}"; do
    echo "REMOVED  ${name}  (existed at ${ref}, does not now)"
done

echo
echo "${#changed[@]} changed, ${#added[@]} added, ${#removed[@]} removed; ${#plots[@]} plots recovered"
if [[ "${recovered}" -gt 0 ]]; then
    echo "to see the before of any graph:  cd ${dir} && gnuplot <name>.gp > <name>.svg"
fi

if [[ -n "${open_in_editor}" ]]; then
    if ! command -v code > /dev/null; then
        echo "results-at: --open needs the 'code' command, which is not on PATH" >&2
        exit 1
    fi

    # Each recovered plot followed by its current version, so each pair is adjacent. Both tabs carry the same
    # basename - their order is what says which is which, recovered first.
    pairs=()
    for name in "${plots[@]}"; do
        pairs+=("${dir}/${name}")
        # A plot recovered from the ref has no counterpart if it has been deleted since.
        if [[ -f "results/${name}" ]]; then
            pairs+=("results/${name}")
        fi
    done

    if [[ "${#pairs[@]}" -eq 0 ]]; then
        echo
        echo "--open: nothing to open, no plot was recovered"
        exit 0
    fi

    # One `code -r` for the lot: it opens them as tabs in the window already showing this folder, which
    # is the only placement the CLI offers - it has no flag for a window, a group or a column.
    code -r "${pairs[@]}"
    echo
    echo "opened ${#pairs[@]} files in VSCode, each recovered plot followed by its current version"
fi
