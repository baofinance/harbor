#!/usr/bin/env bash
#
# Recover, as they were at a git ref, the results that have changed since - and with them the plot files
# that draw those results, so that what lands in tmp/ is a runnable "before" of every graph that moved.
#
# The tracked CSVs under results/ are the regression evidence: a change to the protocol shows up as a
# change to them, and the question that follows is always "which graph do I look at?". This answers that
# question rather than leaving a list of changed filenames to be matched against plot files by hand.
#
# What is recovered is a filtered copy, not the whole directory: the CSVs that changed, the .gp files
# that read them, any .gp file that itself changed, and every other CSV those .gp files need in order to
# draw. That last part is what makes the copy runnable - a .gp file routinely reads several CSVs, and one
# recovered without its companions plots nothing.
#
# The copy keeps results/'s own flat shape, because that is what makes it usable: a .gp file names its
# data by bare filename, so `cd` into the recovered directory and `gnuplot foo.gp` renders the before of
# exactly what `cd results && gnuplot foo.gp` renders now.
#
# Nothing is written into results/ itself. That directory holds what the tests regress against, and
# leaving it untouched is the point: the comparison is between what is there now and what is recovered
# here, and a tool that overwrote one of them would have nothing left to compare.
#
# Unlike the scripts under lib/bao-base/bin, this one is executed rather than sourced.
#
#   ./bin/results-at                 # against the previous commit
#   ./bin/results-at HEAD~5
#   ./bin/results-at some-branch
#   ./bin/results-at HEAD~5 --open   # ...and open every recovered plot beside its current version
#
# --open is opt-in so that the report still works where there is no editor to open - over ssh, in CI, or
# when the answer to "what moved?" is all that was wanted.

set -euo pipefail
# `set -e` stops the script without a word, so say where. -E carries the trap into functions and subshells.
set -E
trap 'echo "results-at: stopped at line ${LINENO}, exit $?: ${BASH_COMMAND}" >&2' ERR

open_in_editor=""
ref=""
for arg in "$@"; do
    case "${arg}" in
        --open)
            open_in_editor=1
            ;;
        -*)
            echo "results-at: unknown option '${arg}'" >&2
            exit 1
            ;;
        *)
            if [[ -n "${ref}" ]]; then
                echo "results-at: more than one ref given ('${ref}' and '${arg}')" >&2
                exit 1
            fi
            ref="${arg}"
            ;;
    esac
done
ref="${ref:-HEAD~1}"

# A ref may name a branch with slashes in it, which cannot be a single directory component.
dir="tmp/results/${ref//\//_}"

if ! git rev-parse --verify --quiet "${ref}^{commit}" > /dev/null; then
    echo "results-at: '${ref}' is not a commit this repository knows" >&2
    exit 1
fi

rm -rf "${dir}"
mkdir -p "${dir}"

# `git archive` reads the tree at the ref, so the working tree and the index are both left alone. The
# whole of results/ comes across and the unwanted part is removed at the end, because deciding what is
# wanted needs the ref's own .gp files - what a plot read then is not always what it reads now.
git archive "${ref}" results | tar -x -C "${dir}" --strip-components=1
status=("${PIPESTATUS[@]}")
if [[ "${status[0]}" -ne 0 || "${status[1]}" -ne 0 ]]; then
    echo "results-at: could not extract results/ from '${ref}'" >&2
    exit 1
fi

# The CSV filenames a plot file actually reads. Comment lines are skipped: several .gp files document
# example command lines naming CSVs they do not draw, and compare.gp - which is generic and takes its
# filenames on the command line - names three that do not exist in results/ at all.
#
# grep exits 1 when it selects nothing, which here means only that the file names no CSV - style.gp, loaded
# by the others, draws nothing of its own. Any other failure still stops the script.
gp_references() {
    { grep -v '^[[:space:]]*#' "$1" || [[ $? -eq 1 ]]; } \
        | { grep -oE '[A-Za-z0-9_:.-]+\.csv' || [[ $? -eq 1 ]]; } \
        | sort -u
}

declare -A csv_delta=()    # CSV name -> how many lines differ from the ref
declare -A gp_delta=()     # .gp name -> how many lines differ from the ref
declare -A gp_refs=()      # .gp name -> the CSVs it reads, at the ref and now
declare -A drawn_by=()     # CSV name -> the .gp files that read it
declare -A keep=()         # what survives the prune
declare -a csv_added=() csv_removed=() gp_added=() gp_removed=()

# How much moved, in lines, so that a header-only rename reads differently from a behaviour change.
lines_differing() {
    diff "$1" "$2" | grep -c '^[<>]' || true
}

for now in results/*.csv; do
    name="$(basename "${now}")"
    then="${dir}/${name}"

    if [[ ! -f "${then}" ]]; then
        csv_added+=("${name}")
        continue
    fi
    if ! cmp -s "${now}" "${then}"; then
        csv_delta["${name}"]="$(lines_differing "${then}" "${now}")"
    fi
done

for then in "${dir}"/*.csv; do
    [[ -e "${then}" ]] || continue
    name="$(basename "${then}")"
    if [[ ! -f "results/${name}" ]]; then
        csv_removed+=("${name}")
    fi
done

# Both versions of every plot file, because either can be the reason a CSV is worth recovering: the
# version now says which graph to look at, and the version at the ref says what that graph needed to draw.
declare -A seen_gp=()
for path in results/*.gp "${dir}"/*.gp; do
    [[ -e "${path}" ]] || continue
    name="$(basename "${path}")"
    [[ -z "${seen_gp[${name}]:-}" ]] || continue
    seen_gp["${name}"]=1

    if [[ ! -f "${dir}/${name}" ]]; then
        gp_added+=("${name}")
    elif [[ ! -f "results/${name}" ]]; then
        gp_removed+=("${name}")
    elif ! cmp -s "results/${name}" "${dir}/${name}"; then
        gp_delta["${name}"]="$(lines_differing "${dir}/${name}" "results/${name}")"
    fi

    refs=""
    for version in "results/${name}" "${dir}/${name}"; do
        [[ -f "${version}" ]] || continue
        refs+=" $(gp_references "${version}" | tr '\n' ' ')"
    done
    gp_refs["${name}"]="$(echo ${refs} | tr ' ' '\n' | sort -u | tr '\n' ' ')"
done

# A plot file is wanted when it draws something that moved, or when it moved itself. Either way it brings
# its whole data set with it, so that every .gp file in the recovered directory runs.
for name in "${!seen_gp[@]}"; do
    wanted=""
    if [[ -n "${gp_delta[${name}]:-}" ]]; then
        wanted=1
    fi
    for csv in ${gp_refs[${name}]}; do
        if [[ -n "${csv_delta[${csv}]:-}" ]]; then
            wanted=1
            drawn_by["${csv}"]="${drawn_by[${csv}]:-}${name} "
        fi
    done
    [[ -n "${wanted}" ]] || continue

    keep["${name}"]=1
    for csv in ${gp_refs[${name}]}; do
        keep["${csv}"]=1
    done
done

# A CSV that moved is worth recovering whether or not anything draws it.
for csv in "${!csv_delta[@]}"; do
    keep["${csv}"]=1
done

# A name can be wanted and yet not exist at the ref - a plot file written since, or a CSV it reads that
# arrived with it. Nothing to recover in that case, and nothing to prune either.
while IFS= read -r -d '' path; do
    rel="${path#"${dir}/"}"
    if [[ -z "${keep[${rel}]:-}" ]]; then
        rm -f "${path}"
    fi
done < <(find "${dir}" -type f -print0)
find "${dir}" -mindepth 1 -type d -empty -delete

# Plot files name themselves in the graph they draw, but they have not always done so, and a recovered
# one from before that renders with no title at all. Two graphs opened side by side are then told apart
# only by which window they are in, which is exactly the moment it matters.
#
# So where the version NOW titles itself and the recovered one does not, give it one - marked with the
# ref, because the point is to identify the before and two identical titles would not. A plot that
# already titles itself at the ref is left exactly as it was: what it said then is what it said.
titled=0
for then in "${dir}"/*.gp; do
    [[ -e "${then}" ]] || continue
    name="$(basename "${then}")"
    [[ -f "results/${name}" ]] || continue

    # Where the title goes depends on the plot: a multiplot carries one overall title on its own
    # `set multiplot` line, and anything else takes a `set title` before it draws. Each is checked for a
    # title in the place it would go, so a multiplot whose PANELS are titled still gains its overall one.
    if grep -qE '^[[:space:]]*set[[:space:]]+multiplot' "${then}"; then
        grep -qE '^[[:space:]]*set[[:space:]]+multiplot.*[[:space:]]title[[:space:]]' "${then}" && continue
        grep -qE '^[[:space:]]*set[[:space:]]+multiplot.*[[:space:]]title[[:space:]]' "results/${name}" || continue
        # `noenhanced` because every one of these names carries underscores, which enhanced text would
        # render as subscripts.
        awk -v label="${name} at ${ref}" '
            !done && /^[[:space:]]*set[[:space:]]+multiplot/ {
                print $0 " title \"" label "\" noenhanced"
                done = 1
                next
            }
            { print }
        ' "${then}" > "${then}.titled"
    else
        grep -qE '^[[:space:]]*set[[:space:]]+title[[:space:]]' "${then}" && continue
        grep -qE '^[[:space:]]*set[[:space:]]+title[[:space:]]' "results/${name}" || continue
        # Before the first line that actually draws. `s?plot` anchored at the start of the line so that
        # neither `replot` nor a `plot` named in one of the example command lines is mistaken for it.
        awk -v label="${name} at ${ref}" '
            !done && /^[[:space:]]*s?plot([[:space:]]|$)/ {
                print "set title \"" label "\" noenhanced"
                done = 1
            }
            { print }
        ' "${then}" > "${then}.titled"
    fi

    if [[ -s "${then}.titled" ]]; then
        mv "${then}.titled" "${then}"
        titled=$((titled + 1))
    else
        rm -f "${then}.titled"
    fi
done

recovered="$(find "${dir}" -type f | wc -l)"
if [[ "${recovered}" -eq 0 ]]; then
    rmdir "${dir}"
    echo "nothing moved since ${ref} - no results recovered"
    exit 0
fi

echo "recovered ${recovered} files from ${ref} into ${dir}"
if [[ "${titled}" -gt 0 ]]; then
    echo "titled ${titled} of them, which drew untitled at ${ref} - each says '<name> at ${ref}'"
fi
echo

for name in $(printf '%s\n' "${!csv_delta[@]}" | sort); do
    echo "CHANGED  ${name}  (${csv_delta[${name}]} lines differ)"
    # Which plot files read it. A CSV nothing draws is a CSV nobody will look at, which is worth saying.
    if [[ -z "${drawn_by[${name}]:-}" ]]; then
        echo "         drawn by: NOTHING - no .gp file reads this"
    else
        for gp in ${drawn_by[${name}]}; do
            echo "         drawn by: ${gp}"
        done
        echo "         compare:  cd results && gnuplot -e \"before='../${dir}/${name}'; after='${name}'; cols='2'\" compare.gp > ../tmp/${name%.csv}.svg"
    fi
done

for name in "${csv_added[@]}"; do
    echo "ADDED    ${name}  (did not exist at ${ref})"
done

for name in "${csv_removed[@]}"; do
    echo "REMOVED  ${name}  (existed at ${ref}, does not now)"
done

for name in $(printf '%s\n' "${!gp_delta[@]}" | sort); do
    echo "CHANGED  ${name}  (${gp_delta[${name}]} lines differ)"
    echo "         diff:     diff ${dir}/${name} results/${name}"
done

for name in "${gp_added[@]}"; do
    echo "ADDED    ${name}  (did not exist at ${ref}, so there is no before of it to recover)"
done

for name in "${gp_removed[@]}"; do
    echo "REMOVED  ${name}  (existed at ${ref}, does not now)"
done

echo
echo "${#csv_delta[@]} CSVs changed, ${#csv_added[@]} added, ${#csv_removed[@]} removed"
echo "${#gp_delta[@]} plots changed, ${#gp_added[@]} added, ${#gp_removed[@]} removed"
echo
echo "to see the before of any graph:  cd ${dir} && gnuplot <name>.gp > <name>.svg"

if [[ -n "${open_in_editor}" ]]; then
    if ! command -v code > /dev/null; then
        echo "results-at: --open needs the 'code' command, which is not on PATH" >&2
        exit 1
    fi

    # Recovered and current interleaved, so each pair is adjacent. Both tabs carry the same basename -
    # their order is what says which is which, recovered first.
    pairs=()
    for plot in "${dir}"/*.gp; do
        [[ -e "${plot}" ]] || continue
        pairs+=("${plot}")
        now="results/$(basename "${plot}")"
        # A plot recovered from the ref has no counterpart if it has been deleted since.
        if [[ -f "${now}" ]]; then
            pairs+=("${now}")
        fi
    done

    if [[ "${#pairs[@]}" -eq 0 ]]; then
        echo
        echo "--open: nothing to open, no plots were recovered"
        exit 0
    fi

    # One `code -r` for the lot: it opens them as tabs in the window already showing this folder, which
    # is the only placement the CLI offers - it has no flag for a window, a group or a column.
    code -r "${pairs[@]}"
    echo
    echo "opened ${#pairs[@]} files in VSCode, each recovered plot followed by its current version"
fi
